# AI-FIRST BUSINESS ECOSYSTEM - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your actual values

# ===== NEO4J CONFIGURATION =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_THIS_PASSWORD_IMMEDIATELY

# ===== MCP SERVER CONFIGURATION =====
MCP_SERVER_NAME=business-knowledge-server
MCP_SERVER_VERSION=1.0.0
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_API_KEY=CHANGE_THIS_TO_SECURE_RANDOM_STRING

# ===== AI API KEYS =====
# OpenAI (for GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (for Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Zai (for GLM models)
ZAI_API_KEY=your_zai_api_key_here

# AssemblyAI (for transcription)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# ===== VECTOR DATABASE =====
# Pinecone
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX=ai-ecosystem-knowledge

# ===== CRM INTEGRATION =====
# Uncomment and fill in based on your CRM
# CRONUS_CRM_TYPE=jobber
# JOBBER_API_KEY=your_jobber_api_key_here
# JOBBER_CLIENT_ID=your_jobber_client_id_here

# ===== MONITORING =====
PROMETHEUS_PORT=9090
SENTRY_DSN=your_sentry_dsn_here

# ===== LOGGING =====
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===== SECURITY =====
SECRET_KEY=CHANGE_THIS_TO_SECURE_RANDOM_STRING_32_CHARS_MIN
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== TASK QUEUE =====
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ===== BUSINESS CONFIGURATION =====
BUSINESS_NAME=Your Business Name
BUSINESS_CATEGORY=home_service
SERVICE_AREA_RADIUS=50  # miles

# ===== CONTACT INFORMATION =====
BUSINESS_PHONE=+15551234567
BUSINESS_EMAIL=info@yourbusiness.com
BUSINESS_ADDRESS=123 Business St, City, State 12345

# ===== TIMEZONE =====
TZ=America/New_York

# ===== DEVELOPMENT SETTINGS =====
DEBUG=True
TESTING=False