FROM quay.io/fedora/fedora-bootc:43

ARG POC_LOGIN_VALUE=advisor-poc

RUN dnf -y update && dnf -y install \
    @kde-desktop \
    sddm \
    cups \
    cups-filters \
    cups-pk-helper \
    firewalld \
    NetworkManager-wifi \
    bluez \
    blueman \
    pipewire \
    wireplumber \
    xdg-desktop-portal-kde \
    udisks2 \
    python3 \
    curl \
    ca-certificates \
    jq \
    sudo \
    && dnf clean all

RUN curl -fsSLo /etc/yum.repos.d/brave-browser.repo \
      https://brave-browser-rpm-release.s3.brave.com/brave-browser.repo \
    && dnf -y install brave-browser \
    && dnf clean all

RUN useradd --create-home --groups wheel --shell /bin/bash advisor \
    && echo "advisor:${POC_LOGIN_VALUE}" | chpasswd \
    && install -d -o advisor -g advisor /var/lib/advisor-os

COPY runtime/ /usr/libexec/advisor-os/
COPY pwa/ /usr/libexec/advisor-os/pwa/
COPY knowledge/ /usr/libexec/advisor-os/knowledge/
COPY playbooks/ /usr/libexec/advisor-os/playbooks/
COPY config/advisor-os.service /usr/lib/systemd/system/advisor-os.service
COPY config/brave-policies.json /etc/brave/policies/managed/advisor-os.json

RUN chmod 0755 /usr/libexec/advisor-os/advisor_rpc.py \
    && sha256sum /usr/libexec/advisor-os/playbooks/printer-reconnect.json \
       | awk '{print $1}' > /usr/libexec/advisor-os/playbooks/printer-reconnect.json.sha256 \
    && systemctl enable advisor-os.service \
    && systemctl enable sddm.service \
    && systemctl enable cups.service \
    && systemctl enable firewalld.service

ENV ADVISOR_OS_ROOT=/usr/libexec/advisor-os
ENV ADVISOR_PRINTER_FIXTURE=1
ENV ADVISOR_LISTEN_ADDRESS=127.0.0.1
ENV ADVISOR_LISTEN_PORT=8765

LABEL org.opencontainers.image.title="Secureprospective Advisor OS POC" \
      org.opencontainers.image.description="KDE immutable Advisor OS first build-test payload" \
      org.opencontainers.image.version="0.1.0-poc"
