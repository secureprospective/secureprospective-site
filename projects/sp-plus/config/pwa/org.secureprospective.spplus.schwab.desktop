[Desktop Entry]
Type=Application
Name=Schwab Advisor Center
Comment=Charles Schwab Advisor Services
# --app= gives a window with no address bar and no tab strip, so the site looks
# like an application rather than a page the advisor can navigate away from.
# Verified 2026-09-03 on RC1c: Schwab Advisor Services opened chromeless this way.
# A cross-origin sign-in redirect (Microsoft OAuth) temporarily shows browser
# chrome; that is Chromium behaviour, not a fault in this entry.
Exec=brave-browser --app=https://advisorservices.schwab.com/advisor/login --class=spplus-schwab
StartupWMClass=spplus-schwab
Icon=spplus-schwab
Terminal=false
Categories=Office;Finance;
Keywords=schwab;custodian;advisor;accounts;
