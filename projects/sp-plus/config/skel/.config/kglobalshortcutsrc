# SP+ global shortcut defaults.
#
# Print Screen opens flameshot instead of Spectacle. Both ship; flameshot is the
# one an advisor is pointed at because it drops straight into a drag-a-box
# annotate-and-copy flow, which is what someone sending a screenshot to support
# actually needs.
#
# KConfig reads this as a DEFAULTS layer under XDG_CONFIG_DIRS, so anything the
# advisor rebinds later in System Settings wins over it and is not overwritten.
#
# Each value is "current,default,friendly name". Spectacle's bindings are set to
# `none` for current while their upstream default is kept in the second field,
# so System Settings still shows Spectacle's own defaults as restorable.

[services][org.flameshot.Flameshot.desktop]
_k_friendly_name=Flameshot
# NOT bound to Print. This file's main Exec is a bare `flameshot`, which starts
# the daemon rather than taking a screenshot -- a [services] binding always
# fires the main Exec and never a desktop action. Bound here, Print Screen
# started an invisible daemon (SP+ sets disabledTrayIcon=true) and looked broken.
_launch=none,none,Take a screenshot

[services][flameshot-capture.desktop]
_k_friendly_name=Take Screenshot
_launch=Print,none,Take Screenshot

# Spectacle's _launch DEFAULT was Print (the second field is the default, the
# first is the active binding). cycle34 shipped flameshot bound to Print here
# and Print Screen still opened Spectacle on the installed system: when
# kglobalacceld seeds a new user's own kglobalshortcutsrc it honours that
# declared default, so Spectacle reclaimed the key. Both fields must be none.
[services][org.kde.spectacle.desktop]
_k_friendly_name=Spectacle
_launch=none,none,Launch Spectacle
ActiveWindowScreenShot=none,Meta+Print,Capture Active Window
CurrentMonitorScreenShot=none,none,Capture Current Monitor
FullScreenScreenShot=none,Shift+Print,Capture Entire Desktop
OpenWithoutScreenshot=none,none,Launch Spectacle without capturing
RectangularRegionScreenShot=none,Meta+Shift+Print,Capture Rectangular Region
WindowUnderCursorScreenShot=none,Meta+Ctrl+Print,Capture Window Under Cursor
