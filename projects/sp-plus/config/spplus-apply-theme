class ApplyFailure(RuntimeError):
    """A failure that must trigger rollback when a snapshot exists."""


class ValidationFailure(ApplyFailure):
    """A package or request failed validation."""


class CommandFailure(ApplyFailure):
    def __init__(self, operation: str, args: list[str], returncode: Optional[int], detail: str) -> None:
        self.operation = operation
        self.args = args
        self.returncode = returncode
        self.detail = detail
        rendered = " ".join(args)
        suffix = f" (return code {returncode})" if returncode is not None else ""
        super().__init__(f"{operation} failed{suffix}: {rendered}: {detail}")


class RestoreFailure(ApplyFailure):
    """The filesystem rollback or its verification was incomplete."""


class EventLogFailure(RuntimeError):
    """Structured event instrumentation could not be written."""


@dataclass(frozen=True)
class Setting:
    file: str
    group: str
    key: str
    value: str
    source: str

    @property
    def identity(self) -> tuple[str, str, str]:
        return self.file, self.group, self.key


