#!/usr/bin/bash
# DN-24: make a fresh install look like the machine we demo.
#
# /etc/xdg/kdeglobals NAMES the SP+ look-and-feel, but naming is not applying.
# plasmashell reads LookAndFeelPackage for its colours and widget style only;
# the panel layout and the wallpaper come from the package's layouts/*.js and
# its [Wallpaper] default, and NOTHING re-reads those unless the look-and-feel
# is explicitly applied. So a fresh advisor account booted to Fedora's default
# wallpaper and Fedora's default favourites, while the machine we had themed by
# hand looked correct -- the gap that made DN-24.
#
# This runs once per user, inside the live Plasma session (it needs the session
# bus and a running plasmashell to talk to), then drops a stamp so it never
# fights the advisor's own choices afterwards.
set -u

LNF=org.secureprospective.spplus.calm.dark
# The wallpaper is shipped as a Plasma wallpaper PACKAGE with a resolution ladder
# (1920x1080 through 7680x4320, JPEG). plasma-apply-wallpaperimage is handed the
# package directory, not a single file, so Plasma picks the size that fits the
# advisor's screen instead of scaling one image badly.
WALLPAPER=/usr/share/wallpapers/SPPlus-Calm
STAMP="${XDG_STATE_HOME:-$HOME/.local/state}/sp-plus/first-login-theme-applied"

[ -e "$STAMP" ] && { echo "spplus-first-login: already applied, nothing to do"; exit 0; }

# plasma-apply-* are D-Bus clients: plasmashell has to be answering before they
# will do anything. The unit is ordered after plasma-workspace.target, but that
# target is reached before plasmashell has claimed its name, so wait for the
# name rather than for the target. busctl is used rather than qdbus because the
# image ships no qdbus at all -- checked, it is not in the Plasma package set.
for _ in $(seq 1 60); do
    busctl --user list --no-legend --no-pager 2>/dev/null \
        | grep -q '^org\.kde\.plasmashell\b' && break
    sleep 1
done

# Plasma installs these under /usr/sbin, which is not reliably on a user
# session's PATH. Call them by path.
rc=0
/usr/sbin/plasma-apply-lookandfeel -a "$LNF" --resetLayout || rc=1

# --- Wallpaper. ORDER IS NOT ENOUGH, AND EXIT 0 IS NOT PROOF. ------------------
# --resetLayout makes plasmashell reload its layout ASYNCHRONOUSLY. On cycle32 the
# wallpaper call returned "Successfully set the wallpaper for all desktops", this
# unit exited 0 and wrote its journal line -- and the advisor still got Fedora's
# red/purple default, because the reload flushed plasmashell's cached config over
# our write afterwards. The layout won simply by landing last.
# So: wait for plasmashell to come BACK on the bus after the reset, then apply,
# then READ THE CONFIG BACK. Trust the file, never the exit code.
APPLETSRC="${XDG_CONFIG_HOME:-$HOME/.config}/plasma-org.kde.plasma.desktop-appletsrc"
if [ -d "$WALLPAPER" ] || [ -r "$WALLPAPER" ]; then
    for _ in $(seq 1 60); do
        busctl --user list --no-legend --no-pager 2>/dev/null \
            | grep -q '^org\.kde\.plasmashell\b' && break
        sleep 1
    done
    wp_ok=0
    for attempt in 1 2 3; do
        sleep 3
        /usr/sbin/plasma-apply-wallpaperimage "$WALLPAPER" || continue
        sleep 2
        if grep -qF "$WALLPAPER" "$APPLETSRC" 2>/dev/null; then
            wp_ok=1
            echo "spplus-first-login: wallpaper verified in the desktop config on attempt $attempt"
            break
        fi
        echo "spplus-first-login: wallpaper reported success but did not stick; retrying"
    done
    [ "$wp_ok" -eq 1 ] || rc=1
fi

if [ "$rc" -ne 0 ]; then
    echo "spplus-first-login: theme did not apply cleanly; leaving the stamp off so the next login retries"
    exit 1
fi

# flameshot's savePath has to be an absolute path, so it cannot be shipped in
# /etc/skel -- that file is copied verbatim into whatever home the wizard
# creates. Point it at a real Screenshots folder now that $HOME is known.
SHOTS="$HOME/Pictures/Screenshots"
FLAMESHOT="${XDG_CONFIG_HOME:-$HOME/.config}/flameshot/flameshot.ini"
if [ -w "$FLAMESHOT" ] || [ ! -e "$FLAMESHOT" ]; then
    install -d "$SHOTS"
    install -d "$(dirname "$FLAMESHOT")"
    if grep -q '^savePath=' "$FLAMESHOT" 2>/dev/null; then
        sed -i "s#^savePath=.*#savePath=$SHOTS#" "$FLAMESHOT"
    else
        # Append under [General], which /etc/skel's copy always has.
        printf 'savePath=%s\n' "$SHOTS" >> "$FLAMESHOT"
    fi
    echo "spplus-first-login: screenshots will be saved to $SHOTS"
fi

install -d -m 0700 "$(dirname "$STAMP")"
date -u +%Y-%m-%dT%H:%M:%SZ > "$STAMP"
echo "spplus-first-login: applied $LNF and the SP+ wallpaper"
