#!/usr/bin/bash
# DN-24: make a fresh install look like the machine we demo.
#
# The image names the SP+ look-and-feel in /etc/xdg, but naming is not applying.
# The single observable helper below owns package validation, the configuration
# snapshot, the optional layout reset, wallpaper, notifications, and readback.
# There is one path for first login and Welcome, so a first-login retry cannot
# silently drift from the picker path.
set -u

LNF=org.secureprospective.spplus.modern.dark
STAMP="${XDG_STATE_HOME:-$HOME/.local/state}/sp-plus/first-login-theme-applied"

[ -e "$STAMP" ] && { echo "spplus-first-login: already applied, nothing to do"; exit 0; }

# The helper waits for the real Plasma/KWin D-Bus names with a bounded poll and
# fails loudly if the session never becomes usable. It is deliberately passed
# --layout here: only this first-login policy is allowed to replace the panel.
theme_rc=0
/usr/libexec/spplus-apply-theme "$LNF" --layout || theme_rc=$?
if [ "$theme_rc" -eq 0 ]; then
    echo "spplus-first-login: look-and-feel, wallpaper, layout, and readback completed"
else
    echo "spplus-first-login: look-and-feel apply failed; continuing with screenshot setup and leaving the stamp off"
fi

# THE THEME MUST NOT GATE THE SCREENSHOT PERMISSION.
# A cosmetic apply failure must not skip the screenshots folder or the portal
# grant. The stamp is withheld above by the helper result, so a later login can
# retry the cosmetic path without repeating a successful stamp.
SHOTS="$HOME/Pictures/Screenshots"
FLAMESHOT="${XDG_CONFIG_HOME:-$HOME/.config}/flameshot/flameshot.ini"
if [ -w "$FLAMESHOT" ] || [ ! -e "$FLAMESHOT" ]; then
    install -d "$SHOTS"
    install -d "$(dirname "$FLAMESHOT")"
    if grep -q '^savePath=' "$FLAMESHOT" 2>/dev/null; then
        sed -i "s#^savePath=.*#savePath=$SHOTS#" "$FLAMESHOT"
    else
        printf 'savePath=%s\n' "$SHOTS" >> "$FLAMESHOT"
    fi
    echo "spplus-first-login: screenshots will be saved to $SHOTS"
fi

# --- Screenshot portal permission (DN-29). ------------------------------------
# Print Screen runs `flameshot gui`. Flameshot is a third-party app, so on
# Wayland it captures through xdg-desktop-portal, and the KDE backend puts up
# "Allow Apps to Take Screenshots?" the first time and blocks until a human
# answers. Grant the ids used by the shipped launchers once in the live session.
grant_screenshot_permission() {
    have_gdbus=0
    command -v gdbus >/dev/null 2>&1 && have_gdbus=1
    [ "$have_gdbus" -eq 1 ] || {
        echo "spplus-first-login: gdbus missing; screenshot permission not granted"
        return 1
    }

    for app in "" flameshot-capture flameshot org.flameshot.Flameshot spplus-screenshot; do
        gdbus call --session \
            --dest org.freedesktop.impl.portal.PermissionStore \
            --object-path /org/freedesktop/impl/portal/PermissionStore \
            --method org.freedesktop.impl.portal.PermissionStore.SetPermission \
            screenshot true screenshot "$app" "['yes']" >/dev/null 2>&1 || return 1
    done

    gdbus call --session \
        --dest org.freedesktop.impl.portal.PermissionStore \
        --object-path /org/freedesktop/impl/portal/PermissionStore \
        --method org.freedesktop.impl.portal.PermissionStore.Lookup \
        screenshot screenshot 2>/dev/null | grep -q "'flameshot-capture': \['yes'\]"
}
if grant_screenshot_permission; then
    echo "spplus-first-login: screenshot portal permission granted; Print Screen will not prompt"
else
    echo "spplus-first-login: could not grant the screenshot portal permission; Print Screen will prompt once"
fi

if [ "$theme_rc" -ne 0 ]; then
    exit 1
fi

install -d -m 0700 "$(dirname "$STAMP")"
if ! date -u +%Y-%m-%dT%H:%M:%SZ > "$STAMP" || [ ! -s "$STAMP" ]; then
    echo "spplus-first-login: could not write completion stamp" >&2
    exit 1
fi
echo "spplus-first-login: applied $LNF and the Modern wallpaper"
