[Unit]
Description=Secureprospective Advisor POC RPC
After=network-online.target cups.service
Wants=network-online.target

[Service]
Type=simple
User=spplus
Group=spplus
ExecStart=/usr/bin/python3 /usr/libexec/sp-plus/spplus_rpc.py
Restart=on-failure
RestartSec=2
WorkingDirectory=/var/lib/sp-plus
Environment=SPPLUS_ROOT=/usr/libexec/sp-plus
Environment=SPPLUS_PRINTER_FIXTURE=1
# The container ENV that carried these does NOT reach systemd on the installed
# machine -- ENV is a build/runtime construct, not system-wide environment -- so
# the service was relying on a Python default to stay on loopback. State it here,
# and enforce it below with IPAddress rules so the property survives a code change.
Environment=SPPLUS_LISTEN_ADDRESS=127.0.0.1
Environment=SPPLUS_LISTEN_PORT=8765
StateDirectory=sp-plus
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sp-plus
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Fin's RPC is a LOCAL boundary. An advisor's laptop sits on client and hotel
# networks; nothing off this machine may reach it. This is kernel-enforced, not
# a default the service could drift away from.
IPAddressDeny=any
IPAddressAllow=localhost

# ------------------------------------------------------------ Tier 1: T1.5
# systemd-analyze security scored this unit 7.7 EXPOSED. It is SP+'s own code,
# so nothing upstream can break underneath these, and the advisor cannot
# perceive any of them. Each line closes something this service demonstrably
# does not need: it is a Python process that answers a loopback socket and talks
# to CUPS over IPP. It touches no device, loads no module, and reads nothing
# outside its own state directory.
PrivateDevices=true
DevicePolicy=closed
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
CapabilityBoundingSet=
# World-readable by default was the last point on the score. Nothing this
# service writes is anyone else's business.
UMask=0077
# NOT SET, and the reason matters more than the setting:
#   MemoryDenyWriteExecute -- CPython does not need W+X, but a C extension
#     loaded later might, and the failure is an unexplained crash at runtime
#     rather than a build error. It goes in when there is a test that would
#     catch it.
#   PrivateUsers -- the service already runs as an unprivileged account. Adding
#     a user namespace on top buys little and interacts with the namespace
#     policy question that is still open in Tier 3.

[Install]
WantedBy=multi-user.target
