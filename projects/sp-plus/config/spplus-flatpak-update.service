[Unit]
Description=Update the SP+ Flatpak applications (DN-34)
Documentation=man:flatpak-update(1)
After=network-online.target
Wants=network-online.target
# D-3. This was ConditionPathIsDirectory=/var/lib/flatpak, which made the updater
# depend on the very state a failed first preinstall never creates: no directory,
# no update run, forever, silently. Condition on the TOOL being present instead --
# that is image content and is always true -- so the updater runs and can create
# and converge the installation itself.
ConditionPathExists=/usr/bin/flatpak

[Service]
Type=oneshot

# WHY THIS UNIT EXISTS.
# DN-26 moved Zoom from a layered RPM to a Flatpak on the stated grounds that
# "/usr is read-only on an image-mode system, so a layered Zoom RPM could never
# update itself ... A Flatpak updates on its own schedule."
#
# It does not. Nothing updates a Flatpak on its own. `flatpak preinstall` only
# DEPLOYS refs that are missing; it never advances an installed one. Discover
# updates Flatpaks, but only while an advisor has it open and clicks -- which is
# exactly the human in the loop this product is built to remove. Without this
# unit the DN-26 rationale is defeated by omission: Zoom enforces a minimum
# client version and refuses connections from older clients, so the advisor's
# Zoom silently rots until it simply stops connecting.
# DN-47. Refresh the catalogue BEFORE updating from it. `flatpak update` alone
# does not touch appstream data -- that is a separate invocation -- so until now
# the only thing that ever refreshed Flathub's catalogue was Discover, while an
# advisor had it open. A machine that has not been told what exists cannot know
# it is out of date. Root does this, so it never depends on a session or polkit.
ExecStart=/usr/bin/flatpak update --appstream --system --noninteractive -y
ExecStart=/usr/bin/flatpak update --system --noninteractive -y

# A laptop on a slow link with a rotational disk is the design target, not the
# edge case. The Dell test machine reads at ~46 MiB/s off a 5400-rpm HDD.
TimeoutStartSec=3600

# D-3, and this one is KEPT AT `0 1` on purpose -- it is not the same judgement as
# the preinstall unit, and the difference is the point.
#
# The preinstall unit answers "does this machine have its applications at all?"
# A no there is a broken install: the advisor has no Zoom, and nothing else will
# ever tell anyone. That must fail loudly.
#
# This unit answers "are the applications already installed now newer?" A no here
# is a machine that is merely not-yet-updated. It still has working applications,
# the next daily run re-converges, and Persistent=true catches the laptop that was
# shut at 5pm. Failing loudly on it would put a red unit in front of an advisor
# every time a hotel wifi dropped, which trains people to ignore red units -- and
# the one red unit that matters is the preinstall one above.
#
# What makes this safe rather than the same swallowing defect: absence of updates
# is observable elsewhere (the installed refs and their commit dates), whereas
# absence of the applications themselves was not observable anywhere at all until
# tests/field-inspect.sh was taught to look.
SuccessExitStatus=0 1
