#!/usr/bin/bash
# SP+ — the one privileged entry point for user-controlled system updates.
#
# WHY THIS EXISTS. Until 2026-09-01 the advisor's only visible way to update the
# operating system was Discover's rpm-ostree backend, and it was actively
# harmful. Discover compared the booted image against whatever sat on the
# registry tag, offered any difference as "an update", and let rpm-ostree
# discover the problem:
#
#   error: While checking against deployment timestamp: Upgrade target revision
#   ... with timestamp 'Tue 01 Sep 2026 11:22:43 AM UTC' is chronologically
#   older than current revision ... with timestamp 'Tue 01 Sep 2026 09:31:12 PM
#   UTC'; use --allow-downgrade to permit
#
# The advisor saw a failure dialog. That is the shape this helper exists to make
# impossible: DIFFERENT IS NOT NEWER. Every answer below compares timestamps and
# refuses to call an older image an update, so the machine can never offer the
# advisor something it will then refuse to install.
#
# It is also the only lane. Discover's rpm-ostree backend is deleted from the
# image (see images/kde/Containerfile) precisely so there is no second,
# uncoordinated updater disagreeing with this one. Discover keeps applications
# and firmware, which it does well.
#
# CONTRACT. One subcommand per invocation. Exactly one JSON object on stdout,
# always, including on failure -- callers parse stdout and never guess from an
# exit code. Diagnostics go to stderr.
#
#   status   what is booted, what is staged, what is known to be available.
#            Reads local state only. No network.
#   check    ask the registry, then answer. Network. Refuses downgrades.
#   stage    download and stage a genuinely newer image. Network.
#   apply    restart into an already-staged update. Nothing else reboots.
set -uo pipefail

emit() { python3 -c '
import json,sys
print(json.dumps(json.loads(sys.argv[1])))' "$1" 2>/dev/null || printf '%s\n' "$1"; }

fail() {
    python3 -c '
import json,sys
print(json.dumps({"ok": False, "state": "error", "reason": sys.argv[1]}))' "$1"
    exit 0
}

# A refused signature is not a network problem and must never be reported as
# one. Phase S makes this machine reject any OS image that is not signed by
# Secure Prospective, and the raw error containers/image produces reads like a
# crash to anyone who is not a systems engineer. The advisor needs to know three
# things and no others: the update was refused, the computer is fine, and there
# is nothing for them to do about it. There is deliberately no way for the
# advisor to override this -- the whole value of the control is that it cannot
# be talked out of.
signature_failure() {   # <bootc stderr> -> plain english, or empty if unrelated
    printf '%s' "$1" | grep -qiE \
        'signature|sigstore|policy requirement|Source image rejected|not accepted|SignatureValidationFailed' \
        || return 1
    printf '%s' 'This update was refused because it is not signed by Secure Prospective. Your computer is safe and is still working normally, and it will keep the version it is running. It will try again on its own. If you keep seeing this, contact support.'
}

# Everything below reads bootc status through one parser. It reports the booted
# and staged digests and, critically, the two timestamps the downgrade guard
# needs. A machine with no cachedUpdate yet is a normal state, not an error.
parse_state() {
    # Reads a bootc status document on stdin, prints the three records the
    # guard needs. Split out of read_state so a gate can feed it a REAL
    # captured status without a machine -- the cachedUpdate shape bug of
    # 2026-09-02 was invisible to a gate that only tested decide().
    python3 -c '
import json, sys

try:
    st = json.load(sys.stdin).get("status", {}) or {}
except Exception:
    print("{}")
    raise SystemExit(0)


def fields(rec):
    """Pull the three things the guard needs out of an image record."""
    rec = rec or {}
    return {
        "digest": rec.get("imageDigest") or "",
        "version": rec.get("version") or "",
        "timestamp": rec.get("timestamp") or "",
    }


def image_of(node):
    """A deployment (booted/staged) carries its image record under .image."""
    if not node:
        return {}
    return fields(node.get("image"))


booted = image_of(st.get("booted"))
staged = image_of(st.get("staged"))
# cachedUpdate is NOT shaped like a deployment. It sits under booted and is
# ALREADY the image record -- no .image wrapper -- so it must not go through
# image_of(). Running it through image_of() looks one level too deep, finds
# nothing, and the guard then reports "up to date" while a real update is
# sitting on the registry. That is a silent no-more-updates-ever bug, and it
# shipped: caught on the test VM 2026-09-02 with a genuine update waiting.
cached = fields((st.get("booted") or {}).get("cachedUpdate"))
print(json.dumps({"booted": booted, "staged": staged, "cached": cached}))
'
}

read_state() { bootc status --format=json 2>/dev/null | parse_state; }

# WHEN DID THIS MACHINE LAST SUCCESSFULLY ASK THE REGISTRY?
#
# bootc does not record that, and without it "up to date" is a claim this
# helper cannot support. `status` reads local state only, by design -- so on a
# machine that has never completed a check, `cachedUpdate` is absent and the
# guard below used to read that absence as "nothing available" and answer
# "This computer is up to date."
#
# Absence of information is not evidence of currency. That conflation is how
# the Dell sat on a 2026-09-11 image, with 0.11.4 published and reachable,
# while its own update panel said it was current. The advisor is not told
# "we do not know"; they are told the reassuring thing, which is the one
# answer that stops anybody looking further.
#
# So we keep our own stamp. It is written ONLY after bootc has actually
# answered, and `status` refuses to say "up to date" without a fresh one.
STAMP_DIR=/var/lib/sp-plus
STAMP=$STAMP_DIR/last-check

record_check() {
    mkdir -p "$STAMP_DIR" 2>/dev/null || return 0
    date -u +%Y-%m-%dT%H:%M:%SZ > "$STAMP" 2>/dev/null || :
}

read_stamp() { cat "$STAMP" 2>/dev/null || printf ''; }

# The downgrade guard, and the reason this file exists. Answers one question:
# given what is booted and what the registry offers, is there a real update?
#
# "newer" is decided on the image timestamp, not on "the digest differs".
# A differing digest is the normal state of affairs the moment a machine is
# installed from an ISO whose image is ahead of the registry -- which is exactly
# how the failure above was produced.
decide() {
    python3 -c '
import json, sys
from datetime import datetime

state = json.loads(sys.argv[1] or "{}")
booted = state.get("booted") or {}
staged = state.get("staged") or {}
cached = state.get("cached") or {}
# The last time bootc actually answered us, as an ISO-8601 UTC string, or "".
# Passed in rather than read here so the simulate seam can drive every branch
# without a machine and without a clock.
checked_raw = (sys.argv[2] if len(sys.argv) > 2 else "") or ""
# A check older than this is not evidence about today. The staging timer is
# daily with up to 2h of jitter, so 48h is comfortably past "it just has not
# run yet" and squarely in "this machine has stopped checking".
STALE_AFTER_HOURS = 48


def when(node):
    raw = (node or {}).get("timestamp") or ""
    if not raw:
        return None
    try:
        return datetime.fromisoformat(raw.replace("Z", "+00:00"))
    except ValueError:
        return None


checked = when({"timestamp": checked_raw})
out = {"ok": True, "booted": booted, "staged": staged, "available": cached,
       "checked": checked_raw}

if staged.get("digest"):
    out["state"] = "staged"
    out["reason"] = ("A new version is downloaded and ready. "
                     "Restart to finish putting it in place.")
    print(json.dumps(out))
    raise SystemExit(0)

bt, ct = when(booted), when(cached)

# STALENESS IS DECIDED BEFORE CURRENCY, and that order is the whole fix.
#
# Every branch below that says "up to date" is a statement about the registry,
# and this helper only knows about the registry if something asked it. If
# nothing has, or not for two days, the honest answer is that we do not know --
# and the advisor is told plainly, because a machine that has silently stopped
# checking is the exact failure this OS exists to not have.
stale = True
if checked is not None:
    age = datetime.now(checked.tzinfo) - checked
    stale = age.total_seconds() > STALE_AFTER_HOURS * 3600

if stale and not cached.get("digest"):
    out["state"] = "unknown"
    if not checked_raw:
        out["reason"] = ("This computer has not checked for updates yet. "
                         "It will check on its own shortly.")
    else:
        out["reason"] = ("This computer has not been able to check for "
                         "updates since %s. It will keep trying." % checked_raw)
    print(json.dumps(out))
    raise SystemExit(0)

if not cached.get("digest") or cached["digest"] == booted.get("digest"):
    out["state"] = "current"
    out["reason"] = "This computer is up to date."
elif bt and ct and ct <= bt:
    # The registry is BEHIND this machine. Never present this as an update:
    # rpm-ostree and bootc both refuse it, and the advisor sees only the
    # refusal. Say the true thing instead.
    out["state"] = "current"
    out["reason"] = "This computer is up to date."
    out["note"] = ("The update source is older than this computer "
                   "(registry %s, this computer %s); nothing to install."
                   % (cached.get("timestamp") or "unknown",
                      booted.get("timestamp") or "unknown"))
else:
    out["state"] = "available"
    out["reason"] = "A new version is available."

print(json.dumps(out))
' "$1" "${2:-}"
}

case "${1:-status}" in
status)
    decide "$(read_state)" "$(read_stamp)"
    ;;

check)
    # --check refreshes what bootc knows about the registry without staging.
    # A network failure is an ordinary condition on a tethered or hotel
    # connection, and it is reported as itself rather than as "up to date".
    if ! err=$(bootc upgrade --check 2>&1); then
        if sig=$(signature_failure "$err"); then fail "$sig"; fi
        fail "Could not reach the update service. $(printf '%s' "$err" | tail -1)"
    fi
    # Only now, once bootc has genuinely answered.
    record_check
    decide "$(read_state)" "$(read_stamp)"
    ;;

stage)
    # ASK BEFORE DECIDING. This is the defect that made the whole automatic
    # lane inert, and it is worth spelling out because it looked like nothing.
    #
    # `decide` answers from bootc's cachedUpdate, and cachedUpdate is populated
    # by exactly one thing: `bootc upgrade --check`. Until 2026-09-13 that ran
    # only in the `check` subcommand above -- and NOTHING in the shipped system
    # ever called `check`. The one reference in the whole tree was a test.
    #
    # So the daily timer fired, called `stage`, read a cache nothing had ever
    # filled, correctly concluded there was no update, and did nothing. Every
    # day. On every machine. The lane was a closed loop: staging was gated on a
    # verdict that could never become "available" without a network check that
    # never happened, and the only symptom was a machine that quietly never
    # updated while reporting itself healthy.
    #
    # A network failure here is NOT fatal and must not be: an advisor on a
    # hotel network or a metered tether fails this routinely. It is reported
    # as itself, the same way `check` reports it, and the timer tries again.
    if ! err=$(bootc upgrade --check 2>&1); then
        if sig=$(signature_failure "$err"); then fail "$sig"; fi
        fail "Could not reach the update service. $(printf '%s' "$err" | tail -1)"
    fi
    record_check
    state=$(read_state)
    verdict=$(decide "$state" "$(read_stamp)")
    want=$(printf '%s' "$verdict" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("state",""))')
    # Refuse to stage anything the guard did not call an update. This is what
    # stops a downgrade being attempted at all.
    if [ "$want" != "available" ]; then
        printf '%s\n' "$verdict"
        exit 0
    fi
    if ! err=$(bootc upgrade 2>&1); then
        if sig=$(signature_failure "$err"); then fail "$sig"; fi
        fail "The update did not finish downloading. $(printf '%s' "$err" | tail -1)"
    fi
    decide "$(read_state)"
    ;;

apply)
    # Only ever restarts into something already staged. If nothing is staged
    # this is a no-op that says so -- it must not be a way to reboot the
    # machine out from under an advisor mid-appointment.
    state=$(read_state)
    staged=$(printf '%s' "$state" | python3 -c 'import json,sys; print((json.load(sys.stdin).get("staged") or {}).get("digest",""))')
    if [ -z "$staged" ]; then
        fail "There is no downloaded update waiting, so there is nothing to restart into."
    fi
    emit '{"ok": true, "state": "restarting", "reason": "Restarting to finish the update."}'
    # Detach so the caller gets its answer before the machine goes down.
    setsid bash -c 'sleep 2; systemctl reboot' >/dev/null 2>&1 &
    ;;

parse)
    # Test seam: run the real parser over a bootc status supplied as an
    # argument. Reads nothing off this machine.
    if [ -z "${2:-}" ]; then
        fail "parse needs a bootc status document."
    fi
    printf '%s' "$2" | parse_state
    ;;

simulate)
    # The test seam. Runs the REAL decide() against a state supplied on the
    # command line instead of one read off the machine. It exists because the
    # case this helper was written for -- the registry sitting BEHIND the
    # booted image -- cannot be produced on demand against a live registry,
    # and a live registry only ever gives us the newer case anyway, so the
    # guard branch is otherwise untestable. Reads nothing, changes nothing.
    if [ -z "${2:-}" ]; then
        fail "simulate needs a state object."
    fi
    # $3 is the last-check stamp, so the unknown/stale branches are drivable
    # without a machine and without waiting two days.
    decide "$2" "${3:-}"
    ;;

*)
    fail "Unknown request '${1:-}'."
    ;;
esac
