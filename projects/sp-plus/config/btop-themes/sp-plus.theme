# SP+ — btop theme in the brand palette.
# Brand blue #0033A0 reads almost black on a dark terminal, so the graph ramps
# climb from it toward the lighter slate the Fin shoal uses (#5f87d7) rather
# than sitting at the brand value. Gold is reserved for the warning tier, the
# same way the design system reserves it for key brand moments.
theme[main_bg]="#1a1a1a"
theme[main_fg]="#dcdcdc"
theme[title]="#ffffff"
theme[hi_fg]="#ffd700"
theme[selected_bg]="#0033a0"
theme[selected_fg]="#ffffff"
theme[inactive_fg]="#6a6a6a"
theme[graph_text]="#b2b2b2"
theme[meter_bg]="#2e2e2e"
theme[proc_misc]="#5f87d7"
theme[cpu_box]="#0033a0"
theme[mem_box]="#0033a0"
theme[net_box]="#0033a0"
theme[proc_box]="#0033a0"
theme[div_line]="#3a3a3a"
theme[temp_start]="#5f87d7"
theme[temp_mid]="#d4af37"
theme[temp_end]="#c62828"
theme[cpu_start]="#0033a0"
theme[cpu_mid]="#5f87d7"
theme[cpu_end]="#b2b2b2"
theme[free_start]="#2e4a8f"
theme[free_mid]="#5f87d7"
theme[free_end]="#9fbaf0"
theme[cached_start]="#2e4a8f"
theme[cached_mid]="#5f87d7"
theme[cached_end]="#9fbaf0"
theme[available_start]="#6a6a6a"
theme[available_mid]="#8f8f8f"
theme[available_end]="#b2b2b2"
theme[used_start]="#0033a0"
theme[used_mid]="#5f87d7"
theme[used_end]="#ffd700"
theme[download_start]="#2e4a8f"
theme[download_mid]="#5f87d7"
theme[download_end]="#9fbaf0"
theme[upload_start]="#6a6a6a"
theme[upload_mid]="#8f8f8f"
theme[upload_end]="#b2b2b2"
