#!/usr/bin/bash
# Fin -- the SP+ assistant.
#
# Fin used to be a four-item menu over a narrow RPC allowlist. Christopher ruled
# that too restrictive on 2026-08-27: on an image-mode bootc system the real
# containment is architectural -- /usr is read-only, every change lands in a new
# deployment, and a bad state is one `bootc rollback` away -- so caging the
# assistant on top of that buys little and costs the advisor an assistant that
# can actually help. Fin is now the Pi agent, branded, with the vetted playbooks
# kept as a skill rather than as the whole of the product.
set -u

BANNER=/usr/libexec/sp-plus/fin-banner
PROMPT=/usr/share/sp-plus/fin/system-prompt.md
SKILLS=/usr/share/sp-plus/fin/skills
PROMPTS=/usr/share/sp-plus/fin/prompts
SYSTEM_ENV=/etc/sp-plus/fin.env
USER_ENV="${XDG_CONFIG_HOME:-$HOME/.config}/sp-plus/fin.env"

BOLD=$'\033[1m'; DIM=$'\033[2m'; OFF=$'\033[0m'

# The key is read from the machine first, then from the advisor's own config.
# Neither is in the image: the ISO must never carry a credential.
[ -r "$SYSTEM_ENV" ] && . "$SYSTEM_ENV"
[ -r "$USER_ENV" ] && . "$USER_ENV"

have_key() { [ -n "${ANTHROPIC_API_KEY:-}" ]; }

first_run_key() {
    printf '\n  %sFin needs a key before it can talk.%s\n' "$BOLD" "$OFF"
    printf '  %sPaste the key from your SP+ welcome email. It is stored on this\n' "$DIM"
    printf '  machine only, readable by you alone, and never leaves it.%s\n\n' "$OFF"
    printf '  Key (or press Enter to skip): '
    # -s so a key is never left on screen or in scrollback.
    IFS= read -r -s key || key=
    printf '\n'
    [ -z "$key" ] && return 1
    install -d -m 0700 "$(dirname "$USER_ENV")"
    ( umask 077; printf 'ANTHROPIC_API_KEY=%s\n' "$key" > "$USER_ENV" )
    chmod 0600 "$USER_ENV"
    export ANTHROPIC_API_KEY="$key"
    printf '  %sSaved. Fin is ready.%s\n' "$BOLD" "$OFF"
    return 0
}

TIPS=/usr/libexec/sp-plus/fin-tips

# Coaching tips are the advisor's to control, so the switches come before
# anything else -- turning them off must not require a working key.
case "${1:-}" in
    --tips)
        shift
        case "${1:-status}" in
            list)
                printf '\n  %sWhat else can Fin help with?%s\n\n' "$BOLD" "$OFF"
                for f in /usr/share/sp-plus/fin/tips/*.tips; do
                    [ -r "$f" ] || continue
                    while IFS=$'\t' read -r id text; do
                        case "$id" in ''|'#'*) continue ;; esac
                        printf '    %s\n' "$text"
                    done < "$f"
                done
                printf '\n' ;;
            *) exec "$TIPS" "${1:-status}" ;;
        esac
        exit 0 ;;
esac

[ -x "$BANNER" ] && "$BANNER"
printf '  %sFin%s — your SP+ assistant\n' "$BOLD" "$OFF"

if ! have_key; then
    first_run_key || {
        printf '\n  %sWithout a key Fin cannot answer questions, but the repair steps\n'  "$DIM"
        printf '  still work. Run:  spplus-fix printer%s\n\n' "$OFF"
        exit 1
    }
fi

export ANTHROPIC_API_KEY

# One coaching tip, at most, at the start of a session. It is shown only after
# the key is settled: a tip is useless to an advisor Fin cannot yet answer.
# "Try it" hands the tip straight to Fin as the opening request, which is the
# whole point -- the advisor learns by having the work done, not by reading.
TIP_CHOICE=""
if [ -x "$TIPS" ] && [ $# -eq 0 ]; then
    TIP_FILE=$(mktemp) || TIP_FILE=""
    if [ -n "$TIP_FILE" ]; then
        if "$TIPS" show "$TIP_FILE"; then TIP_CHOICE=$(cat "$TIP_FILE"); fi
        rm -f "$TIP_FILE"
    fi
fi
[ -n "$TIP_CHOICE" ] && set -- "$TIP_CHOICE"
# --approve is deliberate: without it Fin asks about trusting project files in a
# home directory the advisor owns anyway, which is a question they cannot answer.
exec /usr/bin/pi \
    --provider anthropic \
    --model "${FIN_MODEL:-claude-sonnet-5}" \
    --append-system-prompt "$PROMPT" \
    --skill "$SKILLS" \
    --prompt-template "$PROMPTS" \
    --approve \
    "$@"
