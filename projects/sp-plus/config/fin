#!/usr/bin/bash
# Fin -- the SP+ assistant.
#
# Fin used to be a four-item menu over a narrow RPC allowlist. Christopher ruled
# that too restrictive on 2026-08-27: on an image-mode bootc system the real
# containment is architectural -- /usr is read-only, every change lands in a new
# deployment, and a bad state is one `bootc rollback` away -- so caging the
# assistant on top of that buys little and costs the advisor an assistant that
# can actually help. Fin is now the Pi agent, branded, with the vetted playbooks
# kept as a skill rather than as the whole of the product.
set -u

BANNER=/usr/libexec/sp-plus/fin-banner
PROMPT=/usr/share/sp-plus/fin/system-prompt.md
SKILLS=/usr/share/sp-plus/fin/skills
PROMPTS=/usr/share/sp-plus/fin/prompts
EXTENSIONS=/usr/share/sp-plus/fin/extensions
SYSTEM_ENV=/etc/sp-plus/fin.env
USER_ENV="${XDG_CONFIG_HOME:-$HOME/.config}/sp-plus/fin.env"

BOLD=$'\033[1m'; DIM=$'\033[2m'; OFF=$'\033[0m'

# The key is read from the machine first, then from the advisor's own config.
# Neither is in the image: the ISO must never carry a credential.
[ -r "$SYSTEM_ENV" ] && . "$SYSTEM_ENV"
[ -r "$USER_ENV" ] && . "$USER_ENV"

have_key() { [ -n "${ANTHROPIC_API_KEY:-}" ]; }

TIPS=/usr/libexec/sp-plus/fin-tips

# Coaching tips are the advisor's to control, so the switches come before
# anything else -- turning them off must not require a working key.
case "${1:-}" in
    --tips)
        shift
        case "${1:-status}" in
            list)
                printf '\n  %sWhat else can Fin help with?%s\n\n' "$BOLD" "$OFF"
                for f in /usr/share/sp-plus/fin/tips/*.tips; do
                    [ -r "$f" ] || continue
                    while IFS=$'\t' read -r id text; do
                        case "$id" in ''|'#'*) continue ;; esac
                        printf '    %s\n' "$text"
                    done < "$f"
                done
                printf '\n' ;;
            *) exec "$TIPS" "${1:-status}" ;;
        esac
        exit 0 ;;
esac

[ -x "$BANNER" ] && "$BANNER"
printf '  %sFin%s, your SP+ assistant\n' "$BOLD" "$OFF"

# Decide the opening request BEFORE any flags are prepended, so that $# still
# reflects what the advisor actually typed.
TIP_CHOICE=""
if [ -x "$TIPS" ] && [ $# -eq 0 ] && have_key; then
    # One coaching tip, at most, per session, and only when Fin can actually
    # answer it. "Try it" hands the tip straight to Fin as the opening request:
    # the advisor learns by having the work done, not by reading about it.
    TIP_FILE=$(mktemp) || TIP_FILE=""
    if [ -n "$TIP_FILE" ]; then
        if "$TIPS" show "$TIP_FILE"; then TIP_CHOICE=$(cat "$TIP_FILE"); fi
        rm -f "$TIP_FILE"
    fi
fi
[ -n "$TIP_CHOICE" ] && set -- "$TIP_CHOICE"

# Fin must ALWAYS open. Nothing is asked of the advisor before the TUI loads:
# earlier builds prompted for a key pasted "from your SP+ welcome email" and quit
# when it was skipped, so an advisor with no key never saw Fin at all. If there
# is no key, say how to connect and let Pi's own /login handle it -- and do not
# force a provider, or Pi cannot offer the choice.
if have_key; then
    export ANTHROPIC_API_KEY
    set -- --provider anthropic --model "${FIN_MODEL:-claude-sonnet-5}" "$@"
else
    printf '\n  %sFin is not connected to a provider yet.%s\n' "$BOLD" "$OFF"
    printf '  %sType %s/login%s%s in Fin and pick a provider to sign in to.%s\n\n' \
        "$DIM" "$OFF$BOLD" "$OFF" "$DIM" "$OFF"
fi

# --approve is deliberate: without it Fin asks about trusting project files in a
# home directory the advisor owns anyway, which is a question they cannot answer.
# --approve waives Pi's own confirmations, so the guardrail extensions below are
# the only thing standing between the model and an irreversible action. They are
# loaded explicitly by path because /usr is read-only and Pi's discovery looks in
# the advisor's home, which the image cannot write to. See DN-31 decision 7.
#
# SCOPE, stated plainly: these gate the bash, write and edit TOOLS. Fin holds
# unprompted root, so they stop accidents and casual mistakes, NOT a determined
# or hijacked model. They are a floor, not a boundary.
exec /usr/bin/pi \
    --append-system-prompt "$PROMPT" \
    --skill "$SKILLS" \
    --prompt-template "$PROMPTS" \
    --extension "$EXTENSIONS/spplus-guardrails.ts" \
    --extension "$EXTENSIONS/spplus-workspace.ts" \
    --approve \
    "$@"
