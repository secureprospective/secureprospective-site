# Joplin -- notes, as a Flatpak (DN-26 pattern, same as Zoom).
#
# Joplin is not packaged in Fedora, so a layered RPM is not an option. It is also
# the wrong shape for /usr on an image-mode host: notes software ships frequently
# and a baked-in copy would sit frozen until a whole new SP+ image shipped.
#
# Branch is NOT optional. Omit it and flatpak defaults to the "master" branch,
# which does not exist for this app, and preinstall silently reports
# "Nothing to do" -- the trap already recorded for Zoom.
#
# App ID verified against the Flathub API on 2026-09-03: net.cozic.joplin_desktop
# ("Joplin"). Do not guess this string; a wrong ID fails silently.
[Flatpak Preinstall net.cozic.joplin_desktop]
Branch=stable
IsRuntime=false
Install=true
