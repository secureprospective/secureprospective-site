[Unit]
Description=Install the SP+ base Flatpak applications (DN-26)
Documentation=man:flatpak-preinstall(1)
After=network-online.target
Wants=network-online.target
ConditionPathIsDirectory=/usr/share/flatpak/preinstall.d

[Service]
Type=oneshot
# Idempotent: once the refs are deployed this exits immediately, so running it
# on a schedule costs nothing and re-converges a machine that was offline on
# first boot.
ExecStart=/usr/bin/flatpak preinstall --system --noninteractive -y
# D-3. This used to be `SuccessExitStatus=0 1`, with the rationale above it that
# "a first boot with no network must not be a failed unit the advisor sees". That
# rationale is inverted: it did not stop the failure, it stopped anyone SEEING it.
# A machine offline at OnBootSec=90s got `flatpak preinstall` exit 1, systemd
# recorded SUCCESS, /var/lib/flatpak was never created, the daily updater's old
# ConditionPathIsDirectory then skipped forever, and the advisor had no Zoom while
# every status surface reported healthy. Two machines from one ISO, different
# application sets, no error on either -- the leading explanation for the
# irregular installations.
#
# So a failure is now a FAILURE. The advisor is protected from seeing a scary
# unit not by lying about the exit code but by CONVERGING: the timer retries at
# 10 minutes and again daily (Persistent=true), so a transient offline boot is
# repaired long before anyone looks, and a real, persistent failure is visible to
# `systemctl is-failed` and to tests/field-inspect.sh instead of being erased.
SuccessExitStatus=0
TimeoutStartSec=3600
