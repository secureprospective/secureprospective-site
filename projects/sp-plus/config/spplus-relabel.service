[Unit]
Description=SP+ first-boot SELinux relabel of /etc and /var (DN-16)
ConditionPathExists=!/var/lib/spplus/relabeled
DefaultDependencies=no
After=local-fs.target
Before=systemd-user-sessions.service display-manager.service spplus-firstboot-password.service
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/spplus-relabel
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=sysinit.target
