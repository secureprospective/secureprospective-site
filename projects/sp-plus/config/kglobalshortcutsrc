# SP+ global shortcut defaults.
#
# Print Screen runs flameshot-capture.desktop, whose Exec is `flameshot gui`.
# Christopher's call, 2026-08-28: "flameshot gui needs to work out of the box for
# the next build" and Print Screen is the key it must answer to.
#
# THIS REVERSES the earlier decision in this cycle, which gave Print Screen to
# the Spectacle wrapper because a portal Screenshot request was believed to wedge
# xdg-desktop-portal-kde permanently. That belief is now REFUTED, measured on the
# cycle36 guest 2026-08-28 with host-side screenshots:
#
#   - Flameshot never wedged anything. The portal answered before, during and
#     after every launch.
#   - What actually happens is the KDE portal's "Allow Apps to Take Screenshots?"
#     dialog, which BLOCKS waiting for a human. Over ssh nobody clicks, so it
#     looked like a hang. That is almost certainly what cycle35 recorded as a
#     permanent wedge.
#   - Once the permission is granted, `flameshot gui` opens its capture overlay
#     immediately and writes a real file. Measured: a 955978-byte PNG.
#
# So the advisor never sees that dialog, spplus-first-login pre-grants the
# screenshot permission in the portal permission store. Print Screen without that
# grant would put a permission prompt in front of an advisor on day one.
#
# The Spectacle wrapper at /usr/libexec/spplus-screenshot stays installed and in
# the menu. It is the fallback that needs no portal at all, and it is what to
# rebind to if the portal ever does misbehave on real hardware.
#
# KConfig reads this as a DEFAULTS layer under XDG_CONFIG_DIRS, so anything the
# advisor rebinds later in System Settings wins over it and is not overwritten.
#
# Each value is "current,default,friendly name". BOTH fields must be set for the
# bindings we suppress: cycle34 shipped a suppressed binding whose second field
# still said Print, and when kglobalacceld seeded a new user's own
# kglobalshortcutsrc it honoured that declared default and reclaimed the key.

[services][flameshot-capture.desktop]
_k_friendly_name=Take Screenshot
# Exec=flameshot gui. This is the ONLY flameshot desktop file safe to bind: the
# other one's main Exec is a bare `flameshot`, which starts the daemon instead of
# capturing.
_launch=Print,Print,Take Screenshot

[services][spplus-screenshot.desktop]
_k_friendly_name=Take Screenshot with Spectacle
# The portal-free fallback. Installed and in the menu, deliberately unbound now
# that Print Screen belongs to Flameshot.
_launch=none,none,Take Screenshot with Spectacle

[services][org.flameshot.Flameshot.desktop]
_k_friendly_name=Flameshot
# This file's main Exec is a bare `flameshot`, which starts the daemon rather
# than taking a screenshot -- a [services] binding always fires the main Exec and
# never a desktop action. Bound to Print it started an invisible daemon (SP+ sets
# disabledTrayIcon=true) and looked broken.
_launch=none,none,Flameshot

[services][org.kde.spectacle.desktop]
_k_friendly_name=Spectacle
# Spectacle's own launcher and capture actions stay unbound so nothing competes
# with Print Screen.
_launch=none,none,Launch Spectacle
ActiveWindowScreenShot=none,none,Capture Active Window
CurrentMonitorScreenShot=none,none,Capture Current Monitor
FullScreenScreenShot=none,none,Capture Entire Desktop
OpenWithoutScreenshot=none,none,Launch Spectacle without capturing
RectangularRegionScreenShot=none,none,Capture Rectangular Region
WindowUnderCursorScreenShot=none,none,Capture Window Under Cursor

# ---- Office keys, freed from Plasma (2026-09-01) ----
#
# Christopher's call: an advisor coming from Windows needs Office's function
# keys more than they need KDE virtual desktops. Plasma claims Ctrl+F1 through
# Ctrl+F4 for desktop switching and Ctrl+F7/F9/F10 for Present Windows, so
# LibreOffice never sees the keypress: Ctrl+F2 print preview and Ctrl+F4 close
# document simply do nothing, which reads as broken software rather than as a
# choice.
#
# Each of these actions also has a Meta+Fn binding, so this drops ONLY the
# Ctrl+Fn half and leaves the capability reachable. Nothing is taken away from
# an advisor who does use virtual desktops; they press Meta+F2 instead. The
# exception is the dashboard, which has no alternative and is disabled outright
# because Ctrl+F12 is Word's and Excel's.
#
# Field order is current,default,friendly-name. Leaving the default field
# untouched means System Settings still shows Plasma's stock binding as the
# thing to restore, and an advisor who wants it back gets it back.
[kwin]
Expose=Meta+F9,Ctrl+F9\tMeta+F9,Toggle Present Windows (Current desktop)
ExposeAll=Launch (C)\tMeta+F10,Launch (C)\tCtrl+F10\tMeta+F10,Toggle Present Windows (All desktops)
ExposeClass=Meta+F7,Ctrl+F7\tMeta+F7,Toggle Present Windows (Window class)
Switch to Desktop 1=Meta+F1,Ctrl+F1\tMeta+F1,Switch to Desktop 1
Switch to Desktop 2=Meta+F2,Ctrl+F2\tMeta+F2,Switch to Desktop 2
Switch to Desktop 3=Meta+F3,Ctrl+F3\tMeta+F3,Switch to Desktop 3
Switch to Desktop 4=Meta+F4,Ctrl+F4\tMeta+F4,Switch to Desktop 4

[plasmashell]
show dashboard=none,Ctrl+F12,Show Desktop
