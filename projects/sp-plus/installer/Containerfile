# Fedora 43 Anaconda parses the `bootc` Kickstart command but does not execute
# the bootc payload installer. Fedora 44 includes the functional bootc payload
# integration used by this ISO.
FROM quay.io/fedora/fedora-bootc:44

RUN dnf install -y \
    anaconda \
    anaconda-install-img-deps \
    anaconda-dracut \
    dracut-config-generic \
    dracut-network \
    net-tools \
    grub2-efi-x64-cdboot \
    plymouth \
    default-fonts-core-sans \
    default-fonts-other-sans \
    google-noto-sans-cjk-fonts \
    xorrisofs \
    squashfs-tools \
    jq \
    iwlwifi-dvm-firmware \
    iwlwifi-mvm-firmware \
    iwlwifi-mld-firmware \
    iwlegacy-firmware \
    libertas-firmware \
    && dnf clean all \
    && ls /usr/lib/firmware/intel/iwlwifi/ | grep -q ucode \
    && echo "IWLWIFI_OK installer can drive Intel wireless"

RUN mkdir -p /boot/efi \
    && cp -ra /usr/lib/efi/*/*/EFI /boot/efi

RUN mkdir -p /usr/lib/image-builder/bootc
COPY installer/iso.yaml /usr/lib/image-builder/bootc/iso.yaml
COPY installer/interactive-defaults.ks /usr/share/anaconda/interactive-defaults.ks

# DN-27 GATE. A random `rootpw` in the kickstart trips pyanaconda's
# check_admin_user_exists(), which makes the User Creation spoke optional, which
# lets an install finish with no loginable account at all. That bricked a Dell
# after a multi-hour install on 2026-08-29, and it had regressed from an earlier
# build. This gate is why it cannot come back quietly.

RUN K=/usr/share/anaconda/interactive-defaults.ks \
 && ! grep -qE '^[[:space:]]*rootpw' "$K" \
 && ! grep -qE '^[[:space:]]*user[[:space:]]' "$K" \
 && grep -q 'spplus_admin_exists' "$K" \
 && grep -q 'DN-27' "$K" \
 && echo "DN27_LOGIN_GATE_OK no rootpw declared, admin guard present"

RUN echo "install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda" >> /etc/passwd \
    && echo "install::14438:0:99999:7:::" >> /etc/shadow \
    && passwd -d root \
    && mv /usr/share/anaconda/list-harddrives-stub /usr/bin/list-harddrives \
    && mv /etc/yum.repos.d /etc/anaconda.repos.d \
    && ln -s /lib/systemd/system/anaconda.target /etc/systemd/system/default.target \
    && rm -v /usr/lib/systemd/system-generators/systemd-gpt-auto-generator \
    && ln -sf /lib/systemd/system/anaconda-shell@.service /usr/lib/systemd/system/autovt@.service \
    && ln -sf /lib/systemd/system/anaconda-shell@.service /etc/systemd/system/autovt@.service

RUN mkdir -p /usr/lib/systemd/logind.conf.d \
    && printf '%s\n' '[Login]' 'ReserveVT=2' > /usr/lib/systemd/logind.conf.d/anaconda-shell.conf

RUN mkdir -p /etc/systemd/user/pipewire.service.d /etc/systemd/user/pipewire.socket.d \
    && printf '%s\n' '[Unit]' 'ConditionUser=' > /etc/systemd/user/pipewire.service.d/allowroot.conf \
    && printf '%s\n' '[Unit]' 'ConditionUser=' > /etc/systemd/user/pipewire.socket.d/allowroot.conf

RUN kernel=$(kernel-install list --json pretty | jq -r '.[] | select(.has_kernel == true) | .version' | head -1) \
    && test -n "$kernel" \
    && DRACUT_NO_XATTR=1 dracut --force -v --zstd --reproducible --no-hostonly \
       --add anaconda "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}"

# Keep the Anaconda service's temporary directory on the installer. The bootc
# wrapper scopes its large import scratch to the target /boot filesystem only
# while bootc is running; a service-wide TMPDIR breaks GTK before storage setup.
RUN mkdir -p /etc/systemd/system/anaconda.service.d \
    && printf '%s\n' '[Service]' \
       'Environment=PATH=/usr/local/bin:/usr/bin:/usr/sbin:/sbin:/bin' \
       > /etc/systemd/system/anaconda.service.d/bootc-tmp.conf

# Preserve the real binary and put the first-pass diagnostic wrapper ahead of it
# only for the Anaconda service PATH. Image-builder preflight still reaches the
# preserved binary through the wrapper's exec path.
RUN cp -a /usr/bin/bootc /usr/bin/bootc-real
COPY installer/bootc-wrapper.sh /usr/local/bin/bootc
# The installer's progress bar. Anaconda's boss counts TASKS, and deploying the
# bootc image is one task that eats nearly the whole install, so the bar parked
# at about 8% for many minutes while the text kept moving. Patch Anaconda here,
# in the image that becomes the installer runtime, so no updates.img,
# inst.updates= or dracut overlay is involved. The script refuses to apply
# unless every anchor matches exactly once, and the greps below fail the build
# if a patch silently did nothing.
COPY installer/patch-anaconda-progress.py /usr/libexec/patch-anaconda-progress.py
COPY installer/patch-anaconda-network.py /usr/libexec/patch-anaconda-network.py
RUN chmod 0755 /usr/local/bin/bootc /usr/libexec/patch-anaconda-progress.py \
      /usr/libexec/patch-anaconda-network.py \
 && /usr/libexec/patch-anaconda-network.py \
 && /usr/libexec/patch-anaconda-progress.py \
 && grep -Fq 'def steps(self):' \
      /usr/lib64/python3.14/site-packages/pyanaconda/modules/payloads/payload/rpm_ostree/installation.py \
 && grep -Fq 'step_number=step' \
      /usr/lib64/python3.14/site-packages/pyanaconda/modules/payloads/payload/rpm_ostree/installation.py \
 && grep -Fq 'queue.task_count * 100' \
      /usr/lib64/python3.14/site-packages/pyanaconda/modules/boss/installation.py \
 && grep -Fq 'self._completed_steps + step' \
      /usr/lib64/python3.14/site-packages/pyanaconda/modules/boss/installation.py \
 && python3 -m py_compile \
      /usr/lib64/python3.14/site-packages/pyanaconda/modules/payloads/payload/rpm_ostree/installation.py \
      /usr/lib64/python3.14/site-packages/pyanaconda/modules/boss/installation.py \
 && find /usr/lib64/python3.14/site-packages/pyanaconda/modules -type d -name __pycache__ -exec rm -rf {} + \
 && echo 'SP+ installer progress patch applied and verified'

# DN-28 GATE. The install bar sat at 8% then sprinted, because progress was
# sampled only when bootc printed a line and the denominator was hardcoded to
# 5 GB against an ~11 GB payload. Confirmed three times, including on real
# hardware. Both halves must stay fixed: a measured denominator AND a sampler
# that runs on its own clock.
RUN W=/usr/local/bin/bootc \
 && ! grep -q '5000000000' "$W" \
 && grep -q 'progress_sampler_pid' "$W" \
 && grep -q 'SPPLUS_PAYLOAD_BYTES' "$W" \
 && grep -q 'DN-28' "$W" \
 && bash -n "$W" \
 && echo "DN28_PROGRESS_GATE_OK clock-driven sampler, measured denominator"

# ---- SP+ branding on the INSTALLER (DN-19). This is the first screen anyone sees.
#
# This block previously copied installer/product/ to /usr/share/lorax/product/ on
# the belief that "Lorax's bootc-generic-iso template packages this directory as
# images/product.img". That is FALSE for this build path and the branding was
# inert for every cycle up to and including 36. The ISO is produced by osbuild's
# image-builder-cli, not by lorax; nothing collects /usr/share/lorax/, and the
# finished ISO contains no images/product.img at all -- verified by listing the
# ISO with xorriso. The visible symptom was an installer that called itself
# "ANACONDA BLUESKY INSTALLATION", wore a red PRE-RELEASE / TESTING banner and
# painted its sidebar Fedora's stock #2f4265 instead of SP+ #0033A0, measured
# from a host-side virsh screenshot.
#
# The installer container root IS the installer runtime root, so branding is
# installed to the paths Anaconda actually reads, and nothing depends on an
# overlay image being assembled:
#
#   /.buildstamp                     pyanaconda/core/product.py reads exactly
#                                    "/.buildstamp" (or $PRODBUILDPATH). With no
#                                    buildstamp it falls back to Product=anaconda,
#                                    Version=bluesky, IsFinal=false, which is
#                                    character-for-character what shipped.
#                                    IsFinal=True also clears the beta banner via
#                                    window.set_beta(not is_final).
#   conf.d/10-sp-plus.conf           declares custom_stylesheet, the SUPPORTED
#                                    override hook. Anaconda layers it OVER its
#                                    own sheet, so the stock styling survives.
#   pixmaps/sp-plus/                 our art, in its own subdirectory. Stock
#                                    Anaconda and fedora-logos pixmaps are still
#                                    NOT overwritten, per the original note.
COPY installer/product/.buildstamp /.buildstamp
COPY installer/product/anaconda-gtk.css /usr/share/sp-plus/branding/installer/anaconda-gtk.css
COPY installer/product/pixmaps/ /usr/share/anaconda/pixmaps/sp-plus/
COPY branding/ /usr/share/sp-plus/branding/

RUN install -d /etc/anaconda/conf.d \
 && printf '%s\n' \
      '# SP+ installer branding. See installer/Containerfile for why this is the' \
      '# supported hook and product.img is not.' \
      '[User Interface]' \
      'custom_stylesheet = /usr/share/sp-plus/branding/installer/anaconda-gtk.css' \
      > /etc/anaconda/conf.d/10-sp-plus.conf \
 && chmod 0644 /etc/anaconda/conf.d/10-sp-plus.conf /.buildstamp \
 && test -f /usr/share/sp-plus/branding/installer/anaconda-gtk.css \
 && test -f /usr/share/anaconda/pixmaps/sp-plus/sidebar-logo.png \
 && test -f /usr/share/anaconda/anaconda-gtk.css \
 && echo "DN19_BRANDING_FILES_OK"

# SP+ identity for the installer environment. Anaconda reads ID and VARIANT_ID
# from here to detect its profile, and shows PRETTY_NAME in several places.
RUN printf '%s\n' \
      'NAME="SP+"' \
      'VERSION="1.0"' \
      'ID=sp-plus' \
      'ID_LIKE=fedora' \
      'VERSION_ID=1.0' \
      'PRETTY_NAME="SP+ 1.0"' \
      'VARIANT="Advisor"' \
      'VARIANT_ID=advisor' \
      'LOGO=sp-plus-logo-icon' \
      'HOME_URL="https://secureprospective.com/"' \
      'SUPPORT_URL="https://secureprospective.com/support"' \
      'BUG_REPORT_URL="https://secureprospective.com/support"' \
      > /usr/lib/os-release \
 && ln -sf ../usr/lib/os-release /etc/os-release \
 && printf '%s\n' '\\S' 'Kernel \\r on an \\m (\\l)' '' > /etc/issue \
 && printf '%s\n' '\\S' 'Kernel \\r on an \\m (\\l)' '' > /etc/issue.net \
 && grep -q '^ID=sp-plus$' /usr/lib/os-release \
 && echo "DN19_OSRELEASE_OK"

# Behaviour gate, not a presence gate. This runs Anaconda's OWN product and
# configuration code and asserts what the installer will actually display.
#
# It replicates the real startup sequence from /usr/sbin/anaconda, which calls
# set_from_defaults(), then set_from_detected_profile() with the os-release ID
# and VARIANT_ID, then set_from_files() for /etc/anaconda/conf.d/. Simply
# importing `conf` yields defaults only, and an earlier version of this gate did
# exactly that and reported an empty stylesheet -- a flaw in the test, not the
# config. A gate that does not walk the real path is worth nothing.
#
# NOTE: profile detection matches os_id EXACTLY, with no ID_LIKE fallback, so
# ID=sp-plus currently matches no profile and Anaconda uses none. That is a real
# open question recorded for Christopher, not something this gate should paper
# over. The assertions below therefore hold true either way: the conf.d drop
# directory is read last and wins regardless of which profile is selected.
#
# The stylesheet is parsed by the real GTK CSS parser, which needs no display,
# so a syntax error in our branding cannot reach the ISO.
COPY installer/branding-gate.py /usr/libexec/sp-plus-installer-branding-gate.py
RUN python3 /usr/libexec/sp-plus-installer-branding-gate.py

# Do not replace Anaconda or fedora-logos pixmaps in the installer root. SP+ art
# lives in its own pixmaps/sp-plus/ subdirectory and is referenced by absolute
# path from our stylesheet, so the stock files stay untouched.
#
# NOTE: installer/build-product-img.sh builds a product.img that nothing in this
# build path consumes. It is left in place rather than deleted, but it is dead
# tooling until an ISO is built by lorax.
