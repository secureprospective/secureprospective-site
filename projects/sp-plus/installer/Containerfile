# Fedora 43 Anaconda parses the `bootc` Kickstart command but does not execute
# the bootc payload installer. Fedora 44 includes the functional bootc payload
# integration used by this ISO.
FROM quay.io/fedora/fedora-bootc:44

RUN dnf install -y \
    anaconda \
    anaconda-install-img-deps \
    anaconda-dracut \
    dracut-config-generic \
    dracut-network \
    net-tools \
    grub2-efi-x64-cdboot \
    plymouth \
    default-fonts-core-sans \
    default-fonts-other-sans \
    google-noto-sans-cjk-fonts \
    xorrisofs \
    squashfs-tools \
    jq \
    && dnf clean all

RUN mkdir -p /boot/efi \
    && cp -ra /usr/lib/efi/*/*/EFI /boot/efi

RUN mkdir -p /usr/lib/image-builder/bootc
COPY installer/iso.yaml /usr/lib/image-builder/bootc/iso.yaml
COPY installer/interactive-defaults.ks /usr/share/anaconda/interactive-defaults.ks

RUN echo "install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda" >> /etc/passwd \
    && echo "install::14438:0:99999:7:::" >> /etc/shadow \
    && passwd -d root \
    && mv /usr/share/anaconda/list-harddrives-stub /usr/bin/list-harddrives \
    && mv /etc/yum.repos.d /etc/anaconda.repos.d \
    && ln -s /lib/systemd/system/anaconda.target /etc/systemd/system/default.target \
    && rm -v /usr/lib/systemd/system-generators/systemd-gpt-auto-generator \
    && ln -sf /lib/systemd/system/anaconda-shell@.service /usr/lib/systemd/system/autovt@.service \
    && ln -sf /lib/systemd/system/anaconda-shell@.service /etc/systemd/system/autovt@.service

RUN mkdir -p /usr/lib/systemd/logind.conf.d \
    && printf '%s\n' '[Login]' 'ReserveVT=2' > /usr/lib/systemd/logind.conf.d/anaconda-shell.conf

RUN mkdir -p /etc/systemd/user/pipewire.service.d /etc/systemd/user/pipewire.socket.d \
    && printf '%s\n' '[Unit]' 'ConditionUser=' > /etc/systemd/user/pipewire.service.d/allowroot.conf \
    && printf '%s\n' '[Unit]' 'ConditionUser=' > /etc/systemd/user/pipewire.socket.d/allowroot.conf

RUN kernel=$(kernel-install list --json pretty | jq -r '.[] | select(.has_kernel == true) | .version' | head -1) \
    && test -n "$kernel" \
    && DRACUT_NO_XATTR=1 dracut --force -v --zstd --reproducible --no-hostonly \
       --add anaconda "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}"

# Keep the Anaconda service's temporary directory on the installer. The bootc
# wrapper scopes its large import scratch to the target /boot filesystem only
# while bootc is running; a service-wide TMPDIR breaks GTK before storage setup.
RUN mkdir -p /etc/systemd/system/anaconda.service.d \
    && printf '%s\n' '[Service]' \
       'Environment=PATH=/usr/local/bin:/usr/bin:/usr/sbin:/sbin:/bin' \
       > /etc/systemd/system/anaconda.service.d/bootc-tmp.conf

# Preserve the real binary and put the first-pass diagnostic wrapper ahead of it
# only for the Anaconda service PATH. Image-builder preflight still reaches the
# preserved binary through the wrapper's exec path.
RUN cp -a /usr/bin/bootc /usr/bin/bootc-real
COPY installer/bootc-wrapper.sh /usr/local/bin/bootc
RUN chmod 0755 /usr/local/bin/bootc

# ---- SP+ branding on the INSTALLER (DN-19). This is the first screen anyone sees,
# and it is a separate image with its own Fedora art. Build context is
# projects/sp-plus/, so COPY paths above are prefixed with installer/.
COPY branding/ /usr/share/sp-plus/branding/

RUN printf '%s\n' \
      'NAME="SP+"' \
      'VERSION="1.0"' \
      'ID=sp-plus' \
      'ID_LIKE=fedora' \
      'VERSION_ID=1.0' \
      'PRETTY_NAME="SP+ 1.0"' \
      'VARIANT="Advisor"' \
      'VARIANT_ID=advisor' \
      'LOGO=sp-plus-logo-icon' \
      'HOME_URL="https://secureprospective.com/"' \
      'SUPPORT_URL="https://secureprospective.com/support"' \
      'BUG_REPORT_URL="https://secureprospective.com/support"' \
      > /usr/lib/os-release \
 && ln -sf ../usr/lib/os-release /etc/os-release \
 && printf '%s\n' '\\S' 'Kernel \\r on an \\m (\\l)' '' > /etc/issue \
 && printf '%s\n' '\\S' 'Kernel \\r on an \\m (\\l)' '' > /etc/issue.net

# Anaconda pixmaps and every visible fedora-logos surface, enumerated from rpm.
RUN set -eux; \
    ICON=/usr/share/sp-plus/branding/sp-plus-icon-512.png; \
    LOCK=/usr/share/sp-plus/branding/sp-plus-lockup.png; \
    B64=$(base64 -w0 "$ICON"); \
    mksvg() { printf '%s\n' \
      '<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="512" height="512" viewBox="0 0 512 512">' \
      "<image width=\"512\" height=\"512\" xlink:href=\"data:image/png;base64,${B64}\"/>" \
      '</svg>' > "$1"; }; \
    install -d /usr/share/icons/hicolor/scalable/apps /usr/share/pixmaps; \
    mksvg /usr/share/icons/hicolor/scalable/apps/sp-plus-logo-icon.svg; \
    cp "$ICON" /usr/share/pixmaps/sp-plus-logo-icon.png; \
    P=/usr/share/anaconda/pixmaps; \
    [ -d "$P" ] && { cp -f "$LOCK" "$P/sidebar-logo.png"; cp -f "$LOCK" "$P/anaconda_header.png"; }; \
    if rpm -q fedora-logos >/dev/null 2>&1; then \
      rpm -ql fedora-logos \
        | grep -E '/(plymouth|sddm|pixmaps|anaconda)/|icons/hicolor/(scalable|256x256|512x512)/' \
        | while read -r f; do \
            [ -f "$f" ] || continue; \
            rm -f "$f"; \
            case "$f" in \
              *.svg) mksvg "$f" ;; \
              *)     cp -f "$ICON" "$f" ;; \
            esac; \
          done; \
    fi; \
    find /usr/share/anaconda/pixmaps/rnotes -type f \( -name '*.png' -o -name '*.jpg' \) \
      -exec cp -f "$LOCK" {} \; 2>/dev/null || true
