# SP+ payload image — this is the image the ISO installs onto the advisor's disk.
# DN-18: this file used to be four lines (bare Kinoite) while the real product was
# described in projects/sp-plus/Containerfile, which the sanctioned build never built.
# The two are merged here. Build context is projects/sp-plus/.
#   sudo podman build -t localhost/sp-plus-kde:spike -f images/kde/Containerfile .
# Fedora 44 everywhere. DN-13 is satisfied absolutely: NO human account ships at all.
# PINNED BY DIGEST (D-02). A floating :44 tag moves under us: two builds of
# identical source produced different operating systems. That breaks D-01
# outright -- a dated mile marker is supposed to name exactly one set of bits.
# Pinning also decides WHEN we meet an upstream change: floating, the first
# symptom is a failed Anaconda anchor check at whatever moment Fedora rebuilds;
# pinned, a base bump is a commit we make deliberately and then test.
#
# READ THIS BEFORE ASSUMING A PIN MEANS REPRODUCIBLE. Fedora garbage-collects
# old base digests. On 2026-08-30 the digest every hardware-verified SP+ image
# was built from had ALREADY been collected -- podman still had the bits on
# disk, but neither recorded RepoDigest resolved on quay any more. A pin buys a
# deliberate-bump mechanism and a window, NOT permanent reproducibility. This is
# why D-01 promotes an existing digest of OUR OWN built image and never rebuilds
# to promote: a mile marker often CANNOT be rebuilt from source later, because
# its base no longer exists. If we ever need true long-term reproducibility, the
# answer is mirroring the base into our own registry, not a longer pin.
#
# Bumping this digest requires a rebuild and a full re-run of the hardware gate.
FROM quay.io/fedora/fedora-kinoite@sha256:dd672611f9ffbfab7ceff4a43c1365ce09b04d5732b8657a3d1f3fc5ffaf608f

# --- Release identity (D-01). Fedora scheme: a round integer, no minor.
# SP+ 1, SP+ 2. There is no 1.1 -- an advisor never makes an upgrade decision,
# so a version that encodes compatibility would be ceremony nobody reads.
# SPPLUS_BUILD is the dated mile marker: it lands in os-release as BUILD_ID and
# is what a support conversation and a rollback target are named by, because
# unlike a channel tag it never moves. Default 'dev' so an undated local build
# is obviously not a release.
ARG SPPLUS_RELEASE=1
ARG SPPLUS_BUILD=dev

# ---- 1. platform + advisor application suite (spb-manifest, spb-appmanifest) ----
RUN dnf install -y --setopt=install_weak_deps=False \
        sddm \
        cups cups-filters cups-pk-helper nss-mdns \
        firewalld \
        NetworkManager-wifi \
        bluez blueman \
        pipewire wireplumber \
        xdg-desktop-portal-kde \
        udisks2 \
        python3 curl ca-certificates jq sudo desktop-file-utils konsole \
        authselect \
        lm_sensors \
        plymouth plymouth-scripts plymouth-plugin-script \
        libreoffice-writer libreoffice-calc libreoffice-impress \
        google-carlito-fonts google-crosextra-caladea-fonts google-tinos-fonts \
        libreoffice-draw libreoffice-base libreoffice-math \
        okular dolphin ark gwenview spectacle kate kcalc \
        keepassxc thunderbird system-config-printer \
        micro flameshot kitty \
        plasma-systemsettings plasma-workspace \
 && dnf clean all

# ---- 2. Brave, the advisor-facing application ----
# Kinoite ships /opt as a symlink to a var/opt that does not exist, so Brave's rpm
# fails to unpack: "failed to open dir opt of /opt/brave.com/: cpio: mkdir failed".
# Repoint /opt at /usr/lib/opt so the browser is versioned image content like the
# rest of /usr. bootc discussion #1038, approach 1 (read-only /opt at runtime,
# which is correct for a browser — Brave writes only under the user's home).
RUN rm -f /opt && mkdir -p /usr/lib/opt && ln -s usr/lib/opt /opt && ls -ld /opt

RUN curl -fsSLo /etc/yum.repos.d/brave-browser.repo \
      https://brave-browser-rpm-release.s3.brave.com/brave-browser.repo \
 && dnf install -y brave-browser \
 && dnf clean all

# ---- 2a. remote administration (sshd) ----
# The lane needs a real shell on an INSTALLED system to audit it; a serial console is
# an instrument, not an interface. sshd is installed in Kinoite but ships disabled,
# so nothing was ever listening. Enable it. There is no shipped account and no shipped
# password (DN-13), so an installed machine still refuses every remote login until the
# person who installed it creates their own user -- enabling the daemon does not open
# the machine up on its own. Production hardening (key-only, or off entirely) is a
# later decision; for the demo and for this audit it must be on.
RUN dnf install -y --setopt=install_weak_deps=False openssh-server \
 && dnf clean all \
 && systemctl enable sshd.service \
 && test -L /etc/systemd/system/multi-user.target.wants/sshd.service

# ---- 2a-ter. TEST-CYCLE ONLY: Christopher's key reaches the advisor account ----
#
# ############################################################################
# #  THIS BLOCK IS FOR THE cycle35 AUDIT AND MUST COME OUT BEFORE ANY IMAGE  #
# #  GOES TO A REAL ADVISOR. It is not hardening; it is the opposite.        #
# ############################################################################
#
# Why it exists: the cycle35 sweep has to verify things that only exist in the
# advisor's OWN home directory -- whether the look-and-feel was actually APPLIED
# (DN-24), whether the wallpaper stuck in plasma-org.kde.plasma.desktop-appletsrc,
# whether Print Screen reached Flameshot in kglobalshortcutsrc. The QEMU guest
# agent cannot read any of it: it runs confined as virt_qemu_ga_t and SELinux
# denies it user_home_t, so through that channel the absence of a file is not
# evidence of absence. Without a real shell as the user, the most important
# checks in tests/field-inspect.sh return UNKNOWN rather than OK or PROBLEM.
#
# What this does NOT do: it creates no account. DN-13 still holds -- SP+ ships no
# human user. The key lands in /etc/skel, so it reaches whatever account Anaconda's
# user spoke creates and no other. An installed machine still refuses every remote
# login until that person exists.
#
# What it DOES mean, stated plainly: any machine installed from an ISO carrying
# this layer trusts the holder of the matching private key. That is acceptable for
# a throwaway audit VM on Christopher's own LAN and is not acceptable anywhere else.
COPY --chmod=600 config/skel-ssh/authorized_keys /etc/skel/.ssh/authorized_keys

RUN chmod 0700 /etc/skel/.ssh \
 && test -s /etc/skel/.ssh/authorized_keys \
 && grep -q '^ssh-ed25519 ' /etc/skel/.ssh/authorized_keys \
 && test "$(wc -l < /etc/skel/.ssh/authorized_keys)" = 1 \
 && ! grep -qi 'PRIVATE KEY' /etc/skel/.ssh/authorized_keys \
 && echo "AUDIT_SSH_KEY_OK test-cycle only, remove before any advisor image"

# ---- 2a-bis. WS-Discovery, so an advisor can SEE the office shares ----
# DN-26 makes SP+ Welcome walk the advisor through connecting a shared network drive.
# Everything needed to MOUNT one is already in the base image (cifs.ko, cifs-utils,
# samba-client, kio-extras, keyutils). What was missing is the ability to find one:
# current Windows and most NAS boxes answer WS-Discovery, and the NetBIOS browsing that
# `smbclient -L` relies on is off by default on modern Windows. Without this the advisor
# has to type a server name or an IP address, which is exactly the kind of thing this
# product exists to remove.
#
# Two things about the shipped unit are wrong for us and are corrected in the drop-in:
#
#   * `BindsTo=smb.service`. Upstream assumes wsdd runs beside a Samba SERVER. SP+ is a
#     client and ships no smb.service, so the unit as shipped cannot start at all -- it
#     would sit in a failed state and the advisor would see no shares with no explanation.
#     The drop-in clears the binding.
#   * Host mode is the upstream default, which ADVERTISES this machine to the whole
#     office network. An advisor's laptop holding client records should not announce
#     itself; we want to look, not to be looked at. `--no-host` turns the server side off
#     and `--discovery` turns the client side on, listening only on localhost so nothing
#     new is exposed and firewalld needs no new rule.
RUN dnf install -y --setopt=install_weak_deps=False wsdd \
 && dnf clean all \
 && install -d /usr/lib/systemd/system/wsdd.service.d

# The RPM's EnvironmentFile is intentionally not trusted for security flags. This
# drop-in clears ExecStart and carries the discovery policy literally.
COPY config/wsdd.service.d/ /usr/lib/systemd/system/wsdd.service.d/

RUN systemctl enable wsdd.service \
 && test -L /etc/systemd/system/multi-user.target.wants/wsdd.service \
 && test -s /usr/lib/systemd/system/wsdd.service.d/sp-plus.conf \
 && grep -q '^BindsTo=$' /usr/lib/systemd/system/wsdd.service.d/sp-plus.conf \
 && grep -q '^ExecStart=$' /usr/lib/systemd/system/wsdd.service.d/sp-plus.conf \
 && grep -qF -- 'ExecStart=/usr/bin/wsdd --shortlog --chroot=/run/wsdd --discovery --no-host --listen 127.0.0.1:5357' \
      /usr/lib/systemd/system/wsdd.service.d/sp-plus.conf \
 && ! grep -q '\$OPTIONS' /usr/lib/systemd/system/wsdd.service.d/sp-plus.conf \
 && systemd-analyze verify wsdd.service \
 && test -x /usr/bin/wsdd \
 && echo "WSDD_OK $(rpm -q wsdd) literal hardening flags"

# ---- 2b. identity ----
# The hostname is NOT set here. /etc/hostname is bind-mounted by podman during a build,
# so `echo sp-plus > /etc/hostname` writes to the bind mount, a build assertion reading
# it back passes, and NOTHING is committed to the image -- the installed machine still
# called itself localhost while the gate stayed green. It is set in the kickstart
# instead (network --hostname=sp-plus), which is the installer's job anyway.

# ---- 2c. trim ----
# Audited against `dnf repoquery --whatrequires` on the built image; each of these is
# required by nothing else that ships. Firefox is dead weight beside Brave (only its
# own langpacks depend on it), glibc-all-langpacks carries every locale on earth when
# one is needed, the Noto CJK faces are 116 MB of fonts this product never renders (a dry run
# confirmed they take only their three default-fonts-cjk-* metapackages with them),
# and mariadb-server is a database no SP+ component uses. Christopher explicitly
# ruled KEEP on plasma-workspace-wallpapers, java-25-openjdk-headless, ibus +
# cldr-emoji-annotation and python3-botocore -- do not add them here.
#
# FOUR CANDIDATES WERE REJECTED after checking properly, and the check that cleared
# them the first time was WRONG: `dnf repoquery --whatrequires` run on the installed
# system returned empty for every candidate, including ones with obvious dependents.
# Only a `dnf remove --assumeno` dry run against the image tells the truth.
#   podman          -- takes bootc AND rpm-ostree with it. That is the entire
#                      image-mode update path. The build caught this as
#                      "bootc: command not found" at the container lint step.
#   openblas-openmp -- takes flexiblas, opencv and SPECTACLE, which SP+ ships.
#   python3-pyside6 -- takes akonadi-server.
#   qt6-qtwebengine -- takes khelpcenter, plasma-discover and kdeplasma-addons.
# mesa-vulkan-drivers is dependency-clean but is left installed on purpose: if kwin
# were to fall back to software rendering the demo is over, and 169 MB is not worth
# that risk. Only nvidia-gpu-firmware is removed, and only because the target
# hardware has no nvidia GPU.
RUN dnf install -y --setopt=install_weak_deps=False glibc-langpack-en \
 && for p in firefox firefox-langpacks glibc-all-langpacks mariadb-server \
      google-noto-sans-cjk-vf-fonts google-noto-sans-mono-cjk-vf-fonts \
      google-noto-serif-cjk-vf-fonts \
      nvidia-gpu-firmware \
      plasma-welcome plasma-welcome-fedora; do \
      rpm -q "$p" >/dev/null 2>&1 && dnf remove -y --noautoremove "$p"; \
    done; \
    dnf clean all; \
    rpm -q glibc-langpack-en || exit 1; \
    for p in firefox glibc-all-langpacks mariadb-server nvidia-gpu-firmware \
             plasma-welcome; do \
      rpm -q "$p" && { echo "TRIM FAILED: $p still installed"; exit 1; }; \
    done; \
    rpm -qa | grep -q "google-noto.*cjk" && { echo "TRIM FAILED: CJK fonts still installed"; exit 1; }; \
    echo "TRIM_OK usr_bytes=$(du -sb /usr | cut -f1) packages=$(rpm -qa | wc -l)"

# ---- 3. the SP+ service account ----
# SP+ ships NO human account. The person installing creates their own user in the
# installer, like any other OS. A pre-populated 'advisor' account was confusing in a
# real install -- it showed up in Anaconda and on the login screen for no reason.
# The SP+ service still needs an identity, so it gets a SYSTEM account: no login
# shell, no password, UID below 1000 so it never appears on a login screen.
RUN useradd --system --home-dir /var/lib/sp-plus --shell /sbin/nologin spplus \
 && install -d -o spplus -g spplus /var/lib/sp-plus \
 && ! getent passwd advisor \
 && test "$(getent passwd spplus | cut -d: -f3)" -lt 1000

# ---- 3b. DN-29 Layer 1: durable first-login home creation -------------------
# The Fedora local authselect profile's with-mkhomedir feature assumes oddjobd and
# pam_oddjob_mkhomedir.so, but SP+ already has the direct pam_mkhomedir.so module
# and deliberately does not need a daemon. Clone the local profile, replace only
# that feature's module in both common session stacks, and select the custom profile.
# login includes system-auth; Kinoite's plasmalogin stack (/etc/pam.d/kde) includes
# password-auth, so this reaches both console and graphical sessions.
RUN set -eux; \
    authselect create-profile sp-plus -b local --symlink-meta --symlink-nsswitch; \
    sed -i 's/pam_oddjob_mkhomedir.so/pam_mkhomedir.so umask=0077 silent/g' \
        /etc/authselect/custom/sp-plus/system-auth \
        /etc/authselect/custom/sp-plus/password-auth; \
    authselect select custom/sp-plus with-silent-lastlog with-mdns4 with-mkhomedir --force; \
    authselect check

# ---- 3c. DN-29 Layer 2: first-boot home creation -----------------------------
# This runs after the booted system has its actual /var, unlike installer %post.
# It is deliberately image content: /usr is immutable on the installed bootc host.
COPY config/spplus-mkhomedir         /usr/libexec/spplus-mkhomedir
COPY config/spplus-mkhomedir.service /usr/lib/systemd/system/spplus-mkhomedir.service

# DN-29 build gate. Keep all three runtime defenses observable in the built image:
# direct PAM module in both common stacks, the before-graphical first-boot unit and
# its enablement, plus authselect's own configuration validity check.
RUN set -eux; \
    chmod 0755 /usr/libexec/spplus-mkhomedir; \
    bash -n /usr/libexec/spplus-mkhomedir; \
    test -f /usr/lib64/security/pam_mkhomedir.so; \
    command -v restorecon >/dev/null 2>&1; \
    for f in /etc/pam.d/system-auth /etc/pam.d/password-auth; do \
        grep -Eq '^session[[:space:]]+optional[[:space:]]+pam_mkhomedir\.so[[:space:]]+umask=0077[[:space:]]+silent$' "$f"; \
    done; \
    grep -Eq '^session[[:space:]]+include[[:space:]]+system-auth$' /etc/pam.d/login; \
    for f in /etc/pam.d/kde /etc/pam.d/sddm; do \
        grep -Eq '^session[[:space:]]+include[[:space:]]+password-auth$' "$f"; \
    done; \
    systemd-analyze verify /usr/lib/systemd/system/spplus-mkhomedir.service; \
    systemctl enable spplus-mkhomedir.service; \
    test -L /etc/systemd/system/graphical.target.wants/spplus-mkhomedir.service; \
    grep -q '^Before=.*display-manager.service' /usr/lib/systemd/system/spplus-mkhomedir.service; \
    grep -q '^Before=.*sddm.service' /usr/lib/systemd/system/spplus-mkhomedir.service; \
    authselect check; \
    echo "DN29_HOME_GATE_OK pam_mkhomedir, console+plasmalogin PAM, first-boot unit enabled"

# ---- 3b. standard system groups must exist in /etc/group ----
# Runs AFTER the spplus account is created: an earlier placement asserted on a group
# that did not exist yet and failed the build with "GROUP MISSING: spplus".
# On the first boot of every SP+ install, 55 errors: "Failed to resolve group" for
# audio, disk, kvm, video, lp and tss. Those groups live only in /usr/lib/group, which
# is reachable through the altfiles NSS module, and early systemd-tmpfiles and udev
# cannot see them -- so device nodes fall back to root ownership. lp and audio decide
# whether printing and sound work. Materialise the standard groups into /etc/group,
# keeping the entries the image already added there and never duplicating a name.
RUN awk -F: 'NR==FNR{seen[$1]=1; next} !($1 in seen)' /etc/group /usr/lib/group \
      >> /etc/group.new \
 && cat /etc/group /etc/group.new > /etc/group.merged \
 && mv /etc/group.merged /etc/group \
 && rm -f /etc/group.new \
 && for g in audio disk kvm video lp tss wheel spplus; do \
      grep -q "^$g:" /etc/group || { echo "GROUP MISSING: $g"; exit 1; }; \
    done \
 && test "$(cut -d: -f1 /etc/group | sort | uniq -d | wc -l)" -eq 0 \
 && echo "GROUPS_OK count=$(grep -c . /etc/group)"


# ---- 4. the SP+ runtime ----
COPY runtime/   /usr/libexec/sp-plus/
COPY knowledge/ /usr/libexec/sp-plus/knowledge/
COPY playbooks/ /usr/libexec/sp-plus/playbooks/
COPY config/sp-plus.service      /usr/lib/systemd/system/sp-plus.service
# Brave policy is NOT copied from config/brave-policies.json. It is written
# in full further down, and that RUN lands on this same path, so a COPY here
# is overwritten within the same build and silently does nothing. The file
# stays in the tree because the older proof-of-concept Containerfile at the
# repository root is its only real consumer. Change the policy in the RUN
# block, not here.
# Fin is the SP+ assistant. It opens as a terminal program, deliberately: the
# advisor should see the machine talking back, not a browser window.
COPY config/fin                  /usr/libexec/sp-plus/fin
COPY config/fin-banner           /usr/libexec/sp-plus/fin-banner
COPY config/fin.desktop          /usr/share/applications/fin.desktop
COPY config/fin-system-prompt.md /usr/share/sp-plus/fin/system-prompt.md
COPY config/fin-skills/          /usr/share/sp-plus/fin/skills/
COPY config/fin-tips             /usr/libexec/sp-plus/fin-tips
COPY config/fin-tip-catalogue/   /usr/share/sp-plus/fin/tips/
COPY config/fin-prompts/         /usr/share/sp-plus/fin/prompts/
COPY config/fin-extensions/      /usr/share/sp-plus/fin/extensions/
COPY config/sudoers-sp-plus       /etc/sudoers.d/sp-plus
COPY config/spplus-grant-admin         /usr/libexec/spplus-grant-admin
COPY config/spplus-grant-admin.service /usr/lib/systemd/system/spplus-grant-admin.service
COPY config/sp-plus-starship.sh    /etc/profile.d/sp-plus-starship.sh
# micro ships no launcher of its own -- it is a terminal editor. On a machine built
# for people who have never used Linux, an application with no way to open it does
# not exist. Give it one, named for what it does rather than what it is called.
COPY config/micro.desktop /usr/share/applications/micro.desktop
COPY config/spplus-fix    /usr/libexec/spplus-fix
# DN-17: the first-boot password helper used to be written by the kickstart %post
# into /usr/libexec. On a bootc system /usr is image content, so %post could not
# create it and the installed machine had NO unit at all — not a failed one, an
# absent one (cycle10 boot log: zero mentions of spplus-firstboot). It is image
# content now, and %post only writes the enable symlink under /etc.
# DN-32: "Make my computer better" -- the deterministic half.
#
# Fin drives this; it does not improvise the tuning itself. A prose skill that
# says "look at the hardware and decide" answers differently on every machine and
# cannot be gated here, which is the same argument DN-31 decision 7 made about
# guardrails, applied to implementation.
#
# v1 SURVEYS ONLY. The advisor's own settings are sacred and ownership cannot be
# inferred from a value comparison -- a changed value proves only THAT it changed,
# never who changed it. So nothing is mutated without explicit per-item consent,
# and sacredness holds by construction rather than by detection.
COPY config/spplus-tune /usr/libexec/spplus-tune

# The gate below is the load-bearing part, and it enforces two things that a
# reviewer cannot be relied on to catch by reading.
#
# 1. NEVER LAYER A PACKAGE. Verified on the Dell 2026-08-29: an attempt to update
#    Pi layered `npm`, and bootc then refused outright --
#      "Deployment contains local rpm-ostree modifications; cannot upgrade via bootc"
#    -- with the staged deployment marked `incompatible: true`, while the desktop
#    looked completely normal. A machine that silently stops receiving updates is
#    the worst failure mode a security product has. So the tuner must not contain
#    a package-install verb at all, and this asserts that at build time.
#
# 2. EDID MUST BE READ, NOT STAT-ED. sysfs reports st_size 0 for the EDID node
#    while reading back 128 bytes, so `[ -s "$c/edid" ]` is always false and every
#    display collapses into one indistinguishable scope -- exactly the laptop-panel
#    versus dock-output confusion that keying by EDID exists to prevent. This bug
#    shipped in the first draft and was caught only by running on real hardware
#    with two screens attached.
RUN set -eux; \
    chmod 0755 /usr/libexec/spplus-tune; \
    bash -n /usr/libexec/spplus-tune; \
    for verb in "dnf " "rpm-ostree install" "yum " "akmods" "flatpak install" "remote-add" "modprobe -i"; do \
        if grep -Fq "$verb" /usr/libexec/spplus-tune; then \
            echo "DN32 GATE FAIL: tuner contains package/repo verb: $verb" >&2; exit 1; \
        fi; \
    done; \
    for verb in "setenforce" "firewall-cmd"; do \
        if grep -Fq "$verb" /usr/libexec/spplus-tune; then \
            echo "DN32 GATE FAIL: tuner touches SELinux or firewall: $verb" >&2; exit 1; \
        fi; \
    done; \
    grep -Fq 'edid_len=$(wc -c < "$c/edid"' /usr/libexec/spplus-tune; \
    if grep -Fq '[ -s "$c/edid" ]' /usr/libexec/spplus-tune; then \
        echo "DN32 GATE FAIL: EDID tested with -s; sysfs reports size 0" >&2; exit 1; \
    fi; \
    grep -Fq 'UPDATE_HEALTH="BROKEN"' /usr/libexec/spplus-tune; \
    echo "DN32_TUNE_GATE_OK survey-only, no package verbs, EDID read by bytes"

# DN-30 update-health gate. The tuner already computes update health and exits 10
# when the deployment cannot be upgraded; this runs it daily so a machine that has
# fallen off the update path is caught within 24 hours instead of sitting silently
# broken until someone happens to look.
COPY config/spplus-update-health.service /usr/lib/systemd/system/spplus-update-health.service
COPY config/spplus-update-health.timer   /usr/lib/systemd/system/spplus-update-health.timer

RUN set -eux; \
    systemd-analyze verify /usr/lib/systemd/system/spplus-update-health.service; \
    systemd-analyze verify /usr/lib/systemd/system/spplus-update-health.timer; \
    systemctl enable spplus-update-health.timer; \
    test -L /etc/systemd/system/timers.target.wants/spplus-update-health.timer; \
    grep -q '^Persistent=true$' /usr/lib/systemd/system/spplus-update-health.timer; \
    grep -q '^OnCalendar=daily$' /usr/lib/systemd/system/spplus-update-health.timer; \
    grep -q '^ExecStart=/usr/libexec/spplus-tune$' /usr/lib/systemd/system/spplus-update-health.service; \
    echo "DN30_HEALTH_GATE_OK daily, persistent, reuses the tuner detector"

# ---- DN-46. Updates arrive on their own; restarts stay the advisor's ---------
# The stock timer, bootc-fetch-apply-updates.timer, runs `bootc upgrade --apply`
# and reboots the machine as soon as an update lands. Christopher ruled that
# unacceptable: an advisor's laptop must never restart itself in the middle of a
# client appointment. It therefore stays DISABLED, and this asserts that, because
# a Fedora preset change turning it back on would be silent and would reintroduce
# exactly the behaviour we refuse.
#
# What ships instead stages and stops. `bootc upgrade` without --apply writes a
# staged deployment -- bootc's own words, "the deployment will be applied on the
# next shutdown or reboot" -- and ostree-finalize-staged.service finalises it at
# shutdown. So the machine updates when the advisor turns it off at the end of
# the day, which they already do, and no reboot is ever imposed on them.
#
# The advisor is told once, in plain words, by a user-session notifier. The
# privileged half writes the staged image DIGEST to /run; the session half only
# reads it, so nothing in the desktop needs sudo to answer "is there an update".
# The digest and not the version, because every build in the SP+ 1 line reports
# version '1' -- observed while testing this -- so keying on the version would
# announce one update and then silently swallow every one after it.
COPY config/spplus-stage-update          /usr/libexec/spplus-stage-update
COPY config/spplus-update-notify         /usr/libexec/spplus-update-notify
COPY config/spplus-stage-update.service  /usr/lib/systemd/system/spplus-stage-update.service
COPY config/spplus-stage-update.timer    /usr/lib/systemd/system/spplus-stage-update.timer
COPY config/spplus-update-notify.service /usr/lib/systemd/user/spplus-update-notify.service
COPY config/spplus-update-notify.timer   /usr/lib/systemd/user/spplus-update-notify.timer

RUN set -eux; \
    chmod 0755 /usr/libexec/spplus-stage-update /usr/libexec/spplus-update-notify; \
    bash -n /usr/libexec/spplus-stage-update; \
    bash -n /usr/libexec/spplus-update-notify; \
    systemd-analyze verify /usr/lib/systemd/system/spplus-stage-update.service; \
    systemd-analyze verify /usr/lib/systemd/system/spplus-stage-update.timer; \
    systemctl enable spplus-stage-update.timer; \
    test -L /etc/systemd/system/timers.target.wants/spplus-stage-update.timer; \
    systemd-analyze verify /usr/lib/systemd/user/spplus-update-notify.service; \
    systemctl --global enable spplus-update-notify.timer; \
    test -L /etc/systemd/user/timers.target.wants/spplus-update-notify.timer; \
# A .path unit watching the marker drove the notifier into its start limit and
# then died, which would have silently swallowed every later update. Keep it a
# timer -- see the header of spplus-update-notify.timer for the verbatim failure.
    test ! -e /usr/lib/systemd/user/spplus-update-notify.path; \
    grep -q '^Persistent=true$' /usr/lib/systemd/system/spplus-stage-update.timer; \
    grep -q '^OnCalendar=daily$' /usr/lib/systemd/system/spplus-stage-update.timer; \
# The staging unit must never reboot the advisor. Assert the absence of --apply
# on the unit AND in the script it calls, because either one could reintroduce it.
# Both files quote the stock unit's `bootc upgrade --apply` in comments to
# explain why SP+ does not use it, so only live lines count here.
    for f in /usr/lib/systemd/system/spplus-stage-update.service /usr/libexec/spplus-stage-update; do \
        if grep -v '^[[:space:]]*#' "$f" | grep -q -- '--apply'; then \
            echo "DN46 GATE FAIL: $f can reboot the advisor (--apply present)" >&2; exit 1; \
        fi; \
    done; \
    grep -q '^ExecStart=/usr/libexec/spplus-stage-update$' /usr/lib/systemd/system/spplus-stage-update.service; \
# The stock auto-reboot timer must stay off.
    if systemctl is-enabled bootc-fetch-apply-updates.timer >/dev/null 2>&1; then \
        echo "DN46 GATE FAIL: bootc-fetch-apply-updates.timer is enabled; it reboots without asking" >&2; exit 1; \
    fi; \
# The notifier must not need privilege, or it will simply never run in a session.
    if grep -qE '(^|[^-[:alnum:]])sudo([^-[:alnum:]]|$)|pkexec' /usr/libexec/spplus-update-notify; then \
        echo "DN46 GATE FAIL: the session notifier tries to escalate" >&2; exit 1; \
    fi; \
    test -x /usr/bin/notify-send; \
    echo "DN46_UPDATE_GATE_OK stages daily, applies at shutdown, never reboots, notifies once"

# ---- DN-47. The advisor can FINISH an update, not just start one ------------
# Christopher, 2026-09-01: "The system either updates like a normal Linux distro
# or it doesn't. Look at the permissions/rules level, not pecking at the apps."
#
# WHAT WAS ACTUALLY WRONG, measured on the running VM with pkcheck against the
# live plasmashell process (an active, local, wheel session -- the advisor's own
# desktop, not an SSH session, which polkit correctly treats as neither):
#
#   org.projectatomic.rpmostree1.upgrade              -> yes
#   org.projectatomic.rpmostree1.deploy               -> auth_admin_keep
#   org.projectatomic.rpmostree1.finalize-deployment  -> auth_admin_keep
#
# So the store could LOOK for an OS update and could download one, and then hit a
# password box on the one verb that puts it in place. Fedora's stock rules file
# grants `upgrade` and `repo-refresh` and stops there, because upstream assumes a
# machine with a separate administrator. SP+ has no such person: the account is
# made by the first-boot wizard and the password is not something a non-technical
# advisor reliably remembers months later. The Flatpak and firmware lanes were
# already clear for a wheel session; the OS lane was the one that dead-ended.
#
# The fix is one rules file covering the update verbs of all three lanes at once,
# not a wrapper or a helper per application. It is the same bargain sudoers-sp-plus
# already strikes, stated once, at the level where it belongs.
COPY config/49-sp-plus-updates.rules /usr/share/polkit-1/rules.d/49-sp-plus-updates.rules

RUN set -eux; \
    R=/usr/share/polkit-1/rules.d/49-sp-plus-updates.rules; \
    chmod 0644 "$R"; \
    # polkit ships no linter and its rules are JavaScript, so a syntax error here
    # is silent at runtime: polkitd logs and carries on with the rule unapplied.
    # It IS checked with node --check, but node does not exist yet at this layer
    # -- it arrives with the Fin/pi install further down -- so that check lives
    # there, next to the interpreter it needs. Search DN47_POLKIT_SYNTAX_OK.
    # The guard is the session, not the verb. Without all three of these the file
    # would hand the update verbs to anyone with an SSH login.
    grep -q 'subject.active' "$R"; \
    grep -q 'subject.local' "$R"; \
    grep -q 'isInGroup("wheel")' "$R"; \
    # finalize-deployment is the whole point of the file. Losing it silently would
    # restore the exact dead end this fixes, and the store would still look fine.
    grep -q 'org.projectatomic.rpmostree1.finalize-deployment' "$R"; \
    grep -q 'org.freedesktop.Flatpak.appstream-update' "$R"; \
    grep -q 'org.freedesktop.fwupd.refresh-remote' "$R"; \
    # Layering permanently marks the deployment incompatible and breaks `bootc
    # upgrade` for good (verified 2026-08-29). It must never become a one-click
    # operation from the store.
    for forbidden in install-uninstall-packages install-local-packages override repo-modify; do \
        if grep -q "rpmostree1.$forbidden" "$R"; then \
            echo "DN47 GATE FAIL: $R grants rpm-ostree $forbidden; layering breaks bootc upgrade" >&2; exit 1; \
        fi; \
    done; \
    # It must sort before the stock 50-default.rules, or it never gets a say.
    case "$(basename "$R")" in [0-4]*) : ;; *) echo "DN47 GATE FAIL: rules file sorts after 50-default" >&2; exit 1;; esac; \
    echo "DN47_POLKIT_GATE_OK the advisor can finish an update in all three lanes"

# ---- DN-47b. Every lane's metadata is refreshed by the system, on a schedule --
# An update the machine cannot SEE is an update that does not exist. Each lane
# keeps its own catalogue, and two of the three were never being refreshed:
#
#   applications  flatpak appstream   only ever refreshed by Discover while open
#   firmware      LVFS metadata       fwupd-refresh.timer was disabled
#   OS packages   swcatalog           refresh service was disabled by 5b debloat
#
# All three now refresh from root-owned system units, so nothing about staying
# current depends on the advisor having the store open, or on polkit at all.
RUN set -eux; \
    systemctl enable fwupd-refresh.timer; \
    test -L /etc/systemd/system/timers.target.wants/fwupd-refresh.timer; \
    systemctl enable fedora-atomic-desktop-appstream-cache-refresh.service; \
    test -L /etc/systemd/system/multi-user.target.wants/fedora-atomic-desktop-appstream-cache-refresh.service; \
    echo "DN47B_METADATA_GATE_OK firmware and appstream catalogues refresh on a schedule"

COPY config/spplus-relabel                   /usr/libexec/spplus-relabel
COPY config/spplus-relabel.service           /usr/lib/systemd/system/spplus-relabel.service

# DN-21: prove the RPC boundary is loopback-only on the INSTALLED machine.
# The container ENV above does not reach systemd there, so the unit must carry
# the bind address itself and the kernel must enforce it. Assert both, plus the
# Python fallback, so a change to any one of the three is caught at build time.
RUN U=/usr/lib/systemd/system/sp-plus.service \
 && grep -q '^Environment=SPPLUS_LISTEN_ADDRESS=127\.0\.0\.1$' "$U" \
 && grep -q '^IPAddressDeny=any$' "$U" \
 && grep -q '^IPAddressAllow=localhost$' "$U" \
 && grep -q 'SPPLUS_LISTEN_ADDRESS", "127\.0\.0\.1"' /usr/libexec/sp-plus/spplus_rpc.py \
 && ! grep -q '0\.0\.0\.0' "$U" \
 && echo "DN21_RPC_LOOPBACK_OK unit pins 127.0.0.1 and the kernel denies every other address"

RUN chmod 0755 /usr/libexec/sp-plus/spplus_rpc.py \
 && sha256sum /usr/libexec/sp-plus/playbooks/printer-reconnect.json \
    | awk '{print $1}' > /usr/libexec/sp-plus/playbooks/printer-reconnect.json.sha256 \
 && systemctl enable sp-plus.service \
 && systemctl enable cups.service \
 && systemctl enable firewalld.service \
 && chmod 0755 /usr/libexec/sp-plus/fin /usr/libexec/sp-plus/fin-banner \
# Fin must be runnable by NAME from a terminal. cycle34 shipped it only at
# /usr/libexec and only reachable via the menu icon, so an advisor told to
# "type fin" -- including by our own /techhelp guidance -- got command not found.
 && ln -sf ../libexec/sp-plus/fin /usr/bin/fin \
 && test -x /usr/bin/fin \
 && bash -n /usr/libexec/sp-plus/fin \
# Fin must open its TUI unconditionally. An earlier build asked the advisor to
# paste a key "from your SP+ welcome email" and exited when they skipped it, so
# an advisor without a key never saw Fin. Assert the prompt is gone (outside
# comments) and that the /login guidance is present.
 && ! grep -v '^[[:space:]]*#' /usr/libexec/sp-plus/fin | grep -qi 'welcome email' \
 && ! grep -q 'first_run_key' /usr/libexec/sp-plus/fin \
 && grep -q '/login' /usr/libexec/sp-plus/fin \
 && python3 -m py_compile /usr/libexec/sp-plus/fin-banner \
 && python3 -c "import re,subprocess; \
a=subprocess.run(['/usr/libexec/sp-plus/fin-banner'],capture_output=True,text=True,check=True).stdout.rstrip(chr(10)); \
assert len(a.split(chr(10)))==10 and '38;5;74' in a and '38;5;249' in a; \
assert a.count('><>')==6 and a.count('<><')==6; \
assert max(len(l) for l in re.sub(chr(27)+r'[[0-9;]*m','',a).split(chr(10)))<=72" \
 && echo "FIN_SCHOOL_OK Fin's ichthys shoal renders: 10 lines, <=72 cols, 12 small fish, blue+grey" \
 && chmod 0644 /usr/share/applications/fin.desktop \
 && desktop-file-validate /usr/share/applications/fin.desktop \
 && desktop-file-validate /usr/share/applications/micro.desktop \
 && test -x /usr/bin/kitty \
 && grep -q "kitty" /usr/share/applications/fin.desktop \
 && chmod 0750 /usr/libexec/spplus-relabel \
 && bash -n /usr/libexec/spplus-relabel \
 && systemctl enable spplus-relabel.service \
 && test -L /etc/systemd/system/sysinit.target.wants/spplus-relabel.service

# ---- 4b. Fin is the Pi agent, not a menu ----
# Fin shipped as four menu items over an RPC allowlist. Christopher ruled that
# too restrictive on 2026-08-27: SP+ is image-mode, so /usr is read-only, every
# software change lands in a new deployment and a bad one is a `bootc rollback`
# away. The containment is architectural. A second cage at the application layer
# bought nothing and cost the advisor an assistant that could actually help.
#
# The version is PINNED. A security product must not float an npm dependency,
# and a build that silently picks up a new agent release is not reproducible.
# npm itself is removed afterwards: nothing on an advisor's machine should be
# able to pull code from the registry at runtime.
# Two traps, both found by probing rather than by reasoning about it:
#   * npm cannot run with the default HOME. On an ostree image /root is a
#     symlink to /var/roothome and /var is empty at build time, so npm dies
#     with ENOTDIR mkdir '/root' before it ever reaches the registry.
#   * `dnf remove npm` is a silent no-op. Fedora 44 resolves the install to
#     nodejs22-npm + nodejs22-npm-bin, and removing the name `npm` matches
#     nothing while still exiting 0. `dnf remove --assumeno` confirmed those
#     two packages come out alone and nodejs itself stays.
# ONE source of truth for the version. It used to appear twice -- in the install
# and in the read-back assertion -- which meant a bump could update the install
# and leave the assertion checking the old number, and the gate would then be
# verifying nothing. The ARG is the pin; the gate below proves it is an exact
# literal before anything uses it.
ARG PI_VERSION=0.84.4

RUN set -eux; \
    case "$PI_VERSION" in \
        ''|*[!0-9.]*|*..*|.*|*.) echo "PI PIN GATE FAIL: '$PI_VERSION' is not a bare version" >&2; exit 1;; \
    esac; \
    [ "$(printf '%s' "$PI_VERSION" | awk -F. 'NF==3{print "ok"}')" = ok ] \
        || { echo "PI PIN GATE FAIL: '$PI_VERSION' is not an exact three-part version" >&2; exit 1; }; \
    echo "PI_PIN_GATE_OK pinned to an exact literal $PI_VERSION"

RUN dnf install -y --setopt=install_weak_deps=False nodejs npm nodejs22-full-i18n \
 && HOME=/tmp/npmhome npm_config_cache=/tmp/npmcache \
    npm install -g --prefix /usr "@earendil-works/pi-coding-agent@${PI_VERSION}" \
 && rm -rf /tmp/npmhome /tmp/npmcache \
 && dnf remove -y nodejs22-npm nodejs22-npm-bin \
 && dnf clean all \
 && test -x /usr/bin/node \
 && cp /usr/share/polkit-1/rules.d/49-sp-plus-updates.rules /tmp/polkit-rules-check.js \
 && node --check /tmp/polkit-rules-check.js \
 && rm -f /tmp/polkit-rules-check.js \
 && echo "DN47_POLKIT_SYNTAX_OK the update rules file parses as JavaScript" \
 && test -x /usr/bin/node-22 \
 && test -x /usr/bin/pi \
 && test ! -e /usr/bin/npm \
 && /usr/bin/node-22 -e 'new Intl.Segmenter("en",{granularity:"grapheme"}).segment("hello")' \
 && /usr/bin/pi --version | grep -qFx "$PI_VERSION" \
 && echo "NODE_INTL_OK node-22 Intl.Segmenter" \
 && chmod 0755 /usr/libexec/spplus-fix \
 && bash -n /usr/libexec/spplus-fix \
 && test -f /usr/share/sp-plus/fin/system-prompt.md \
 && test -f /usr/share/sp-plus/fin/skills/printer/SKILL.md \
 && test -f /usr/share/sp-plus/fin/extensions/spplus-guardrails.ts \
 && test -f /usr/share/sp-plus/fin/extensions/spplus-workspace.ts \
# Fin writes in exactly one directory and nowhere else. It must EXIST before
# Fin first runs, or the first thing an advisor asks for fails on a missing
# path rather than on the rule. Under Documents so it is backed up with their
# work and obvious in a file manager, never hidden in a dotfile.
 && mkdir -p /etc/skel/Documents/Fin \
 && test -d /etc/skel/Documents/Fin \
 && grep -q '"Documents", "Fin"' /usr/share/sp-plus/fin/extensions/spplus-workspace.ts \
 && grep -q "realpathSync" /usr/share/sp-plus/fin/extensions/spplus-workspace.ts \
 && grep -q -- '--extension' /usr/libexec/sp-plus/fin \
 && grep -q 'spplus-guardrails' /usr/libexec/sp-plus/fin \
 && grep -q 'spplus-workspace' /usr/libexec/sp-plus/fin \
 && grep -q 'sends an email' /usr/share/sp-plus/fin/extensions/spplus-guardrails.ts \
 && echo "FIN_GUARDRAILS_OK 2 extensions loaded by path; sudo deliberately NOT gated" \
 && grep -q 'image-mode' /usr/share/sp-plus/fin/system-prompt.md \
 && grep -q 'must not leave the machine' /usr/share/sp-plus/fin/system-prompt.md \
 && grep -q 'exec /usr/bin/pi' /usr/libexec/sp-plus/fin \
 && grep -q '^SKILLS=/usr/share/sp-plus/fin/skills$' /usr/libexec/sp-plus/fin \
 && ! grep -rqE 'sk-ant-[A-Za-z0-9_-]{8}' /usr/libexec/sp-plus/fin /usr/share/sp-plus/fin \
 && ! grep -rqE 'ANTHROPIC_API_KEY=[A-Za-z0-9_-]{8}' /usr/libexec/sp-plus/fin /usr/share/sp-plus/fin \
 && test ! -e /etc/sp-plus/fin.env \
 && test -x /usr/bin/sensors \
 && /usr/bin/sensors --version >/dev/null \
 && echo "SENSORS_OK lm_sensors installed for System Monitor" \
 && chmod 0755 /usr/libexec/sp-plus/fin-tips \
 && bash -n /usr/libexec/sp-plus/fin-tips \
 && test "$(cat /usr/share/sp-plus/fin/tips/*.tips | grep -cE '^[a-z0-9]+-[0-9]+')" -eq 20 \
 && ! cat /usr/share/sp-plus/fin/tips/*.tips | grep -E '^[a-z0-9]+-[0-9]+' \
      | grep -iqE 'automate|batch|prompt|query your' \
 && ! cat /usr/share/sp-plus/fin/tips/*.tips | grep -E '^[a-z0-9]+-[0-9]+' \
      | grep -iqE 'is compliant|ensure compliance' \
 && test -f /usr/share/sp-plus/fin/prompts/techhelp.md \
 && chmod 0440 /etc/sudoers.d/sp-plus \
 && visudo -cf /etc/sudoers.d/sp-plus \
 && grep -q '^%wheel ALL=(ALL) NOPASSWD: ALL$' /etc/sudoers.d/sp-plus \
 && visudo -c \
 && chmod 0755 /usr/libexec/spplus-grant-admin \
 && bash -n /usr/libexec/spplus-grant-admin \
 && systemctl enable spplus-grant-admin.service \
 && test -L /etc/systemd/system/multi-user.target.wants/spplus-grant-admin.service \
 && grep -q 'nologin' /usr/libexec/spplus-grant-admin \
 && grep -q '^--prompt-template\|prompt-template' /usr/libexec/sp-plus/fin \
 && grep -q '^4. Something else' /usr/share/sp-plus/fin/prompts/techhelp.md \
 && test "$(grep -cE '^[1-4]\. ' /usr/share/sp-plus/fin/prompts/techhelp.md)" -eq 4 \
 && ! grep -qi '^[0-9]\. .*get online' /usr/share/sp-plus/fin/prompts/techhelp.md \
 && echo "FIN_AGENT_OK pi $(/usr/bin/pi --version) ships as Fin, no key in the image"

# ---- 4c. the three tools an advisor's helper reaches for ----
# btop and fastfetch are new; flameshot was already installed but shipped with
# stock defaults, which on a fresh machine means a tray icon nobody finds, an
# update nag, and a save location the advisor is asked about every time.
#
# Per-user defaults go through /etc/skel because DN-13 means SP+ ships no human
# account at all -- the account only exists once the wizard creates it, and
# useradd copies /etc/skel into it at that moment.
# Branding is copied BEFORE the tools layer: the fastfetch gate below renders the
# SP+ logo, and the logo now lives here rather than in /etc/skel. /etc is writable
# per-machine on bootc, so a user config pointing into /etc/skel would break for
# every advisor the moment anyone tidied that template directory.
COPY branding/ /usr/share/sp-plus/branding/
COPY config/skel/                 /etc/skel/
COPY config/btop-themes/          /usr/share/btop/themes/
COPY config/btop.desktop          /usr/share/applications/btop.desktop
COPY config/fastfetch.desktop     /usr/share/applications/fastfetch.desktop
COPY config/kglobalshortcutsrc    /etc/xdg/kglobalshortcutsrc

# ---- DN-48: LibreOffice / Microsoft Office parity ----
#
# SP+ ships these as LibreOffice's SHARED configuration layer, not as a
# seeded user profile. The previous vehicle was a registrymodifications.xcu
# under /etc/skel, which reaches only accounts created after the image
# lands and can never be improved afterwards, because once the account
# exists the file belongs to the advisor. That is the same per-application
# patchwork shape Christopher rejected for updates on 2026-09-01: fix the
# layer, not each instance.
#
# A .xcd here sits BELOW the user layer, so an advisor who changes any of
# these settings keeps their change, and ABOVE the LibreOffice defaults, so
# every advisor gets them, new account or not. Being SP+-owned rather than
# owned by libreoffice-core, it also survives a LibreOffice RPM update.
COPY config/libreoffice/spplus-office-parity.xcd \
     /usr/lib64/libreoffice/share/registry/spplus-office-parity.xcd
COPY config/libreoffice/spplus-office-keys.xcd \
     /usr/lib64/libreoffice/share/registry/spplus-office-keys.xcd

# The static checker runs below at build time. The UNO gate and its probe
# cannot run here, because there is no LibreOffice to start inside a build
# layer; they ship so the parity can be re-proved on the Dell or a VM
# against the installed system, which is where it actually matters.
COPY tests/libreoffice-xcd-check.py    /usr/libexec/sp-plus/tests/libreoffice-xcd-check.py
COPY tests/libreoffice-parity-gate.sh  /usr/libexec/sp-plus/tests/libreoffice-parity-gate.sh
COPY tests/libreoffice-parity-probe.py /usr/libexec/sp-plus/tests/libreoffice-parity-probe.py
# Also seeded into the advisor's own config. /etc/xdg is only the DEFAULTS
# layer; kglobalacceld writes a per-user kglobalshortcutsrc at first login and
# does not reliably inherit from it, which is why cycle34 shipped a correct
# /etc/xdg binding and Print Screen still opened Spectacle.
# SAME SOURCE FILE as /etc/xdg above, deliberately. There used to be a second
# copy at config/skel/.config/kglobalshortcutsrc that had to stay byte-identical,
# enforced by the `cmp -s` below. It drifted the moment Print Screen was
# rebound and failed the build at step 52. Two files that must be identical is
# a trap, not a safeguard; one source cannot drift from itself. The cmp stays
# as a cheap guard in case anyone splits them again.
COPY config/kglobalshortcutsrc /etc/skel/.config/kglobalshortcutsrc
COPY config/flameshot-capture.desktop /usr/share/applications/flameshot-capture.desktop
# Print Screen runs Spectacle in region mode through this wrapper, NOT Flameshot.
# Flameshot can only capture via xdg-desktop-portal on Wayland, and a portal
# Screenshot request wedges xdg-desktop-portal-kde permanently -- taking Flatpak
# file pickers and screen sharing down with it. Spectacle uses a private KWin
# protocol and cannot hit that. docs/ledger/DEFECT-portal-screenshot-wedge.md
COPY config/spplus-screenshot         /usr/libexec/spplus-screenshot
COPY config/spplus-screenshot.desktop /usr/share/applications/spplus-screenshot.desktop
# The Flameshot daemon is deliberately NOT autostarted any more. It existed to
# make Print Screen instant, and Print Screen no longer goes to Flameshot. Left
# running it costs ~16 MB per session and issues a portal registration at login
# for no benefit. bird, the reference Fedora KDE machine where Flameshot works,
# runs no daemon either. Flameshot still launches normally from the menu.

# starship is not in the Fedora 44 repositories ("No matching packages" checked
# on cycle33), so it comes from upstream pinned by version AND sha256. An
# unpinned curl-to-shell installer has no place in a reproducible image.
ARG STARSHIP_VERSION=v1.26.0
ARG STARSHIP_SHA256=b7c232b0e8249d8e55a40beb79c5c43a7d370f3f9408bd215deb0170daeaadf3
RUN curl -sSLo /tmp/starship.tgz \
      "https://github.com/starship/starship/releases/download/${STARSHIP_VERSION}/starship-x86_64-unknown-linux-musl.tar.gz" \
 && echo "${STARSHIP_SHA256}  /tmp/starship.tgz" | sha256sum -c - \
 && tar xzf /tmp/starship.tgz -C /usr/bin starship \
 && rm -f /tmp/starship.tgz \
 && chmod 0755 /usr/bin/starship \
 && /usr/bin/starship --version \
 && chmod 0644 /etc/profile.d/sp-plus-starship.sh \
 && bash -n /etc/profile.d/sp-plus-starship.sh \
 && test -f /etc/skel/.config/starship.toml \
 && STARSHIP_CONFIG=/etc/skel/.config/starship.toml HOME=/tmp \
      /usr/bin/starship prompt --status=0 > /tmp/spr \
 && grep -q 'SP+' /tmp/spr \
 && rm -f /tmp/spr \
 && echo "STARSHIP_OK $(/usr/bin/starship --version | head -1)"

RUN dnf install -y --setopt=install_weak_deps=False btop fastfetch \
 && dnf clean all \
 && test -x /usr/bin/btop \
 && test -x /usr/bin/fastfetch \
 && test -x /usr/bin/flameshot \
 && chmod 0644 /usr/share/applications/btop.desktop \
      /usr/share/applications/fastfetch.desktop \
      /etc/xdg/kglobalshortcutsrc \
 && desktop-file-validate /usr/share/applications/btop.desktop \
 && desktop-file-validate /usr/share/applications/fastfetch.desktop \
 && test -f /usr/share/btop/themes/sp-plus.theme \
 && grep -q '^color_theme = "/usr/share/btop/themes/sp-plus.theme"$' \
      /etc/skel/.config/btop/btop.conf \
 && test -f /usr/share/sp-plus/branding/logo-sp-plus.txt \
 && LOREG=/usr/lib64/libreoffice/share/registry \
 && test -f "$LOREG/spplus-office-parity.xcd" \
 && test -f "$LOREG/spplus-office-keys.xcd" \
 && test ! -e /etc/skel/.config/libreoffice/4/user/registrymodifications.xcu \
 && chmod 0755 /usr/libexec/sp-plus/tests/libreoffice-parity-gate.sh \
 && bash -n /usr/libexec/sp-plus/tests/libreoffice-parity-gate.sh \
 && python3 /usr/libexec/sp-plus/tests/libreoffice-xcd-check.py \
      "$LOREG/spplus-office-parity.xcd" \
      "$LOREG/spplus-office-keys.xcd" \
      /etc/xdg/kglobalshortcutsrc \
 && LOK="$LOREG/spplus-office-keys.xcd" \
 && fc-match Carlito | grep -qi carlito \
 && fc-match Caladea | grep -qi caladea \
 && fc-match Tinos   | grep -qi tinos \
 && desktop-file-validate /usr/share/applications/flameshot-capture.desktop \
 && chmod 0755 /usr/libexec/spplus-screenshot \
 && bash -n /usr/libexec/spplus-screenshot \
 && desktop-file-validate /usr/share/applications/spplus-screenshot.desktop \
 && test ! -e /etc/xdg/autostart/flameshot-daemon.desktop \
 && test -x /usr/bin/spectacle \
 && grep -q '^Exec=/usr/libexec/spplus-screenshot$' /usr/share/applications/spplus-screenshot.desktop \
 && grep -qF 'spectacle -r -b -c -o' /usr/libexec/spplus-screenshot \
 && awk '/^\[services\]\[flameshot-capture.desktop\]$/{f=1;next} /^\[/{f=0} f&&/^_launch=/{print}' \
      /etc/xdg/kglobalshortcutsrc | grep -q '^_launch=Print,Print,' \
 && for g in org.flameshot.Flameshot.desktop spplus-screenshot.desktop org.kde.spectacle.desktop; do \
      awk -v grp="[services][$g]" '$0==grp{f=1;next} /^\[/{f=0} f&&/^_launch=/{print}' \
        /etc/xdg/kglobalshortcutsrc | grep -q '^_launch=none,none' || exit 1; \
    done \
 && ! grep -qE '^(ActiveWindow|FullScreen|RectangularRegion|WindowUnderCursor|CurrentMonitor)ScreenShot=.*Print' \
      /etc/xdg/kglobalshortcutsrc \
 && cmp -s /etc/xdg/kglobalshortcutsrc /etc/skel/.config/kglobalshortcutsrc \
 && grep -q '^Exec=flameshot gui$' /usr/share/applications/flameshot-capture.desktop \
 && HOME=/tmp/ffh fastfetch --config /etc/skel/.config/fastfetch/config.jsonc \
      --pipe > /dev/null \
 && install -d /tmp/fsh/.config/flameshot \
 && cp /etc/skel/.config/flameshot/flameshot.ini /tmp/fsh/.config/flameshot/ \
 && HOME=/tmp/fsh flameshot config --check 2>&1 | tee /tmp/fscheck \
 && grep -q 'No errors detected' /tmp/fscheck \
 && ! grep -q 'Unrecognized setting' /tmp/fscheck \
 && rm -rf /tmp/ffh /tmp/fsh /tmp/fscheck \
 && echo "DN48_OFFICE_PARITY_OK shared .xcd layer, $(grep -c 'oor:op=\"replace\"' "$LOK") key bindings, Office function keys freed from Plasma" \
 && echo "TOOLS_OK btop $(btop --version | grep -oE '[0-9.]+$'), fastfetch, flameshot configured out of the box"

# The display manager is Kinoite 44's own plasmalogin (plasma-login-manager), which
# already owns /etc/systemd/system/display-manager.service. sddm is installed and its
# unit file ships, but enabling it here fails outright:
#   Failed to enable unit: File '/etc/systemd/system/display-manager.service' already
#   exists and is a symlink to /usr/lib/systemd/system/plasmalogin.service
# Taking the distro default is the low-risk choice before a live demo. Revisit only if
# plasmalogin turns out not to start.
RUN systemctl set-default graphical.target \
 && test -L /etc/systemd/system/display-manager.service

# ---- 5. branding (DN-19) ----
RUN install -Dm644 /usr/share/sp-plus/branding/fin-icon.svg \
      /usr/share/icons/hicolor/scalable/apps/fin.svg \
 && install -Dm644 /usr/share/sp-plus/branding/fin-icon-256.png \
      /usr/share/icons/hicolor/256x256/apps/fin.png \
 && install -Dm644 /usr/share/sp-plus/branding/fin-icon-512.png \
      /usr/share/icons/hicolor/512x512/apps/fin.png

# os-release: ID_LIKE=fedora is deliberate, tooling depends on it.
RUN printf '%s\n' \
      'NAME="SP+"' \
      "VERSION=\"${SPPLUS_RELEASE}\"" \
      'ID=sp-plus' \
      'ID_LIKE=fedora' \
      "VERSION_ID=${SPPLUS_RELEASE}" \
      "BUILD_ID=${SPPLUS_BUILD}" \
      "PRETTY_NAME=\"SP+ ${SPPLUS_RELEASE} (${SPPLUS_BUILD})\"" \
      'VARIANT="Advisor"' \
      'VARIANT_ID=advisor' \
      'ANSI_COLOR="0;38;2;180;180;190"' \
      'LOGO=sp-plus-logo-icon' \
      'HOME_URL="https://secureprospective.com/"' \
      'SUPPORT_URL="https://secureprospective.com/support"' \
      'BUG_REPORT_URL="https://secureprospective.com/support"' \
      > /usr/lib/os-release \
 && ln -sf ../usr/lib/os-release /etc/os-release \
 && printf '%s\n' '\S' 'Kernel \r on an \m (\l)' '' > /etc/issue \
 && printf '%s\n' '\S' 'Kernel \r on an \m (\l)' '' > /etc/issue.net

# ---- $releasever must name the FEDORA base, not the SP+ release -------------
# The os-release written directly above sets VERSION_ID to the SP+ release
# number (1). libdnf derives $releasever from VERSION_ID, so every rpm-md repo
# in the image silently re-pointed at release "1": the metadata URLs and,
# fatally, the GPG key path. Observed on the cycle44 VM, verbatim:
#
#   error: Updating rpm-md repo 'fedora-cisco-openh264': Failed to download gpg
#   key for repo 'fedora-cisco-openh264': Curl error (37): Could not read a
#   file:// file for file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-1-x86_64
#
# That key does not exist and never will. The effect is that NO rpm-md repo can
# refresh, which takes out `rpm-ostree install` and every Discover operation
# that has to resolve a package -- the store looks deliberately locked down when
# it is simply broken.
#
# The fix is the documented override, /etc/dnf/vars/releasever. It is DERIVED
# from whatever package provides system-release rather than hardcoded, so a base
# bump carries it along; it
# ships in /etc because that is where libdnf reads vars from, which also leaves
# it overridable on a running machine.
RUN set -eux; \
    rel=$(rpm -q --queryformat '%{VERSION}\n' --whatprovides system-release | head -1); \
    case "$rel" in ''|*[!0-9]*) echo "RELEASEVER GATE FAIL: fedora-release version '$rel' is not an integer" >&2; exit 1;; esac; \
    [ "$rel" -ge 40 ] || { echo "RELEASEVER GATE FAIL: implausible Fedora release '$rel'" >&2; exit 1; }; \
    mkdir -p /etc/dnf/vars; \
    printf '%s\n' "$rel" > /etc/dnf/vars/releasever; \
    chmod 0644 /etc/dnf/vars/releasever; \
    . /usr/lib/os-release; \
    [ "$VERSION_ID" != "$rel" ] || { echo "RELEASEVER GATE FAIL: VERSION_ID already equals the base release; this override would be dead code" >&2; exit 1; }; \
    dnf -q --refresh repoquery --qf '%{name}' bash >/dev/null; \
    echo "RELEASEVER_GATE_OK \$releasever pinned to Fedora $rel, not SP+ $VERSION_ID"

# The SP+ mark, under the name LOGO= points at, plus every visible Fedora logo
# surface. The surfaces are ENUMERATED from the rpm database, not guessed:
# fedora-logos owns them and `rpm -V` is what the gate reads back.
# Do NOT `rpm -e fedora-logos` — half the desktop depends on it.
RUN set -eux; \
    ICON=/usr/share/sp-plus/branding/sp-plus-icon-512.png; \
    B64=$(base64 -w0 "$ICON"); \
    mksvg() { printf '%s\n' \
      '<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="512" height="512" viewBox="0 0 512 512">' \
      "<image width=\"512\" height=\"512\" xlink:href=\"data:image/png;base64,${B64}\"/>" \
      '</svg>' > "$1"; }; \
    for d in scalable 256x256 512x512; do \
      install -d "/usr/share/icons/hicolor/$d/apps" "/usr/share/icons/hicolor/$d/places"; \
    done; \
    mksvg /usr/share/icons/hicolor/scalable/apps/sp-plus-logo-icon.svg; \
    cp "$ICON" /usr/share/icons/hicolor/256x256/apps/sp-plus-logo-icon.png; \
    cp "$ICON" /usr/share/icons/hicolor/512x512/apps/sp-plus-logo-icon.png; \
    install -d /usr/share/pixmaps; \
    cp "$ICON" /usr/share/pixmaps/sp-plus-logo-icon.png; \
    if rpm -q fedora-logos >/dev/null 2>&1; then \
      rpm -ql fedora-logos \
        | grep -E '/(plymouth|sddm|pixmaps|anaconda)/|icons/hicolor/(scalable|256x256|512x512)/' \
        | while read -r f; do \
            [ -f "$f" ] || continue; \
            rm -f "$f"; \
            case "$f" in \
              *.svg) mksvg "$f" ;; \
              *)     cp -f "$ICON" "$f" ;; \
            esac; \
          done; \
    fi; \
    gtk-update-icon-cache -f /usr/share/icons/hicolor || true

# Plymouth: the boot splash is the first SP+ surface an advisor ever sees.
# The initramfs must be rebuilt afterwards or the stock splash stays baked in.
RUN set -eux; \
    install -d /usr/share/plymouth/themes/sp-plus; \
    cp /usr/share/sp-plus/branding/sp-plus-splash.png \
       /usr/share/plymouth/themes/sp-plus/splash.png; \
    printf '%s\n' \
      '[Plymouth Theme]' \
      'Name=SP+' \
      'Description=SP+ boot splash' \
      'ModuleName=script' \
      '' \
      '[script]' \
      'ImageDir=/usr/share/plymouth/themes/sp-plus' \
      'ScriptFile=/usr/share/plymouth/themes/sp-plus/sp-plus.script' \
      > /usr/share/plymouth/themes/sp-plus/sp-plus.plymouth; \
    printf '%s\n' \
      'splash.image = Image("splash.png");' \
      'screen_w = Window.GetWidth(); screen_h = Window.GetHeight();' \
      'scale = 0.5 * screen_w / splash.image.GetWidth();' \
      'scaled = splash.image.Scale(splash.image.GetWidth() * scale, splash.image.GetHeight() * scale);' \
      'sprite = Sprite(scaled);' \
      'sprite.SetX((screen_w - scaled.GetWidth()) / 2);' \
      'sprite.SetY((screen_h - scaled.GetHeight()) / 2);' \
      'fun refresh_callback() { sprite.SetOpacity(1); }' \
      'Plymouth.SetRefreshFunction(refresh_callback);' \
      '' \
      '# DN-15: WITHOUT THIS THE MACHINE LOOKS DEAD AT THE PASSPHRASE PROMPT.' \
      '# systemd asks plymouth to collect the LUKS passphrase; a theme with no' \
      '# display-password function draws NOTHING, so the user sees a splash or a' \
      '# black screen and no reason to type. Never remove these callbacks.' \
      'prompt_label = Sprite();' \
      'prompt_dots  = Sprite();' \
      'fun display_password_callback(prompt, bullets) {' \
      '  text = Image.Text("Enter your passphrase to unlock this computer", 1, 1, 1);' \
      '  prompt_label.SetImage(text);' \
      '  prompt_label.SetX((screen_w - text.GetWidth()) / 2);' \
      '  prompt_label.SetY(screen_h * 0.72);' \
      '  prompt_label.SetOpacity(1);' \
      '  dots = "";' \
      '  i = 0;' \
      '  while (i < bullets) { dots = dots + "*"; i = i + 1; }' \
      '  if (dots == "") { dots = " "; }' \
      '  dotimg = Image.Text(dots, 1, 1, 1);' \
      '  prompt_dots.SetImage(dotimg);' \
      '  prompt_dots.SetX((screen_w - dotimg.GetWidth()) / 2);' \
      '  prompt_dots.SetY(screen_h * 0.78);' \
      '  prompt_dots.SetOpacity(1);' \
      '}' \
      'Plymouth.SetDisplayPasswordFunction(display_password_callback);' \
      'fun display_normal_callback() {' \
      '  prompt_label.SetOpacity(0);' \
      '  prompt_dots.SetOpacity(0);' \
      '}' \
      'Plymouth.SetDisplayNormalFunction(display_normal_callback);' \
      'fun display_message_callback(text) {' \
      '  msg = Image.Text(text, 1, 1, 1);' \
      '  prompt_label.SetImage(msg);' \
      '  prompt_label.SetX((screen_w - msg.GetWidth()) / 2);' \
      '  prompt_label.SetY(screen_h * 0.72);' \
      '  prompt_label.SetOpacity(1);' \
      '}' \
      'Plymouth.SetMessageFunction(display_message_callback);' \
      > /usr/share/plymouth/themes/sp-plus/sp-plus.script; \
    ln -sf sp-plus/sp-plus.plymouth /usr/share/plymouth/themes/default.plymouth; \
    # The symlink alone is NOT enough, and this is the second half of DN-15. dracut's
    # plymouth module asks plymouth's OWN tooling which theme is default, and that
    # reads /etc/plymouth/plymouthd.conf -- which still said bgrt. So dracut shipped
    # bgrt's plugin (two-step.so) and left script.so out, and the initramfs had a
    # script theme with no interpreter. Set the theme the supported way so the
    # tooling agrees with the symlink, and assert it before dracut runs.
    plymouth-set-default-theme sp-plus; \
    test "$(plymouth-set-default-theme)" = "sp-plus"; \
    grep -rlis fedora /usr/share/plymouth/themes/*/*.plymouth 2>/dev/null \
      | while read -r t; do sed -i 's/[Ff]edora/SP+/g' "$t"; done; \
    kernel=$(ls -1 /usr/lib/modules | head -1); \
    # DN-15: the LUKS prompt must be VISIBLE on the local panel. plymouth can only
    # draw where a KMS driver exists. i915 covers the Dell; the VM emulates a plain
    # VGA whose driver (bochs_drm) dracut does not pull in, so the test lane was
    # showing a black screen that the real hardware may not show. Ship the common
    # panel drivers so the lane is representative and odd hardware still lights up.
    DRACUT_NO_XATTR=1 dracut --force --no-hostonly --add ostree \
      --add-drivers "bochs_drm virtio_gpu qxl cirrus i915 simpledrm" \
      "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}"; \
    # A rebuilt initramfs WITHOUT the ostree dracut module unlocks LUKS, then dies on
    # "[FAILED] Failed to start initrd-switch-root.service" and drops to emergency.
    # cycle8 proved that. dracut does not pull 50ostree in automatically here, so it
    # is requested explicitly and asserted — never let this regress silently.
    lsinitrd "/usr/lib/modules/${kernel}/initramfs.img" | grep -q ostree; \
    # DN-15 regression guard: a splash that cannot ask for the passphrase is a
    # machine that looks bricked to its owner.
    grep -q 'SetDisplayPasswordFunction' /usr/share/plymouth/themes/sp-plus/sp-plus.script; \
    # DN-15 ROOT CAUSE. The SP+ theme declares ModuleName=script, and the plugin that
    # interprets a script theme is script.so from plymouth-plugin-script. That package
    # was never installed, so /usr/lib64/plymouth/ held details/text/two-step and NO
    # script.so at all. plymouth loaded the theme, found no interpreter, and drew
    # NOTHING -- which is why the LUKS panel was blank, why adding KMS drivers changed
    # nothing, and why adding the password callback changed nothing: the script was
    # never executed. Assert the plugin exists AND that dracut put it in the initramfs,
    # because only the initramfs copy is present when the passphrase is asked for.
    test -e /usr/lib64/plymouth/script.so; \
    lsinitrd "/usr/lib/modules/${kernel}/initramfs.img" | grep -q 'plymouth/script\.so'; \
    lsinitrd "/usr/lib/modules/${kernel}/initramfs.img" | grep -q 'themes/sp-plus/sp-plus.script'; \
    echo "DN15_PLUGIN_OK script.so present on disk and in the initramfs"

# ---- 5b. startup debloat: a productivity laptop, not a server ----
# Measured on the installed cycle20 system: 89 enabled units, and an idle machine
# already holding 2.1 GB before anyone logs in. Everything disabled here is either for
# hardware this product does not have or background work that costs a 12-year-old
# spinning disk real time. DELIBERATELY NOT TOUCHED: sssd and systemd-homed, because
# both sit in the authentication path and DN-16 cost a day; avahi, because network
# printer discovery is the demo; thermald, tuned and smartd, because this is an old
# laptop with an old drive; systemd-oomd, because it keeps a small machine alive.
RUN for u in vboxservice.service vgauthd.service vmtoolsd.service \
             mdmonitor.service raid-check.timer mcelog.service \
             ModemManager.service \
             dnf-makecache.timer rpm-ostree-countme.timer \
             fedora-third-party-refresh.service \
             fedora-atomic-desktop-mandb-update.service; do \
      systemctl disable "$u" 2>/dev/null || true; \
    done; \
    for u in sshd.service sp-plus.service cups.service firewalld.service \
             plasmalogin.service spplus-relabel.service wsdd.service; do \
      systemctl is-enabled "$u" >/dev/null 2>&1 || { echo "DEBLOAT BROKE $u"; exit 1; }; \
    done; \
    for u in fwupd-refresh.timer fedora-atomic-desktop-appstream-cache-refresh.service; do \
      systemctl is-enabled "$u" >/dev/null 2>&1 || { echo "DEBLOAT BROKE THE UPDATE PATH: $u (DN-47b)"; exit 1; }; \
    done; \
    echo "DEBLOAT_OK enabled_units=$(systemctl list-unit-files --state=enabled --no-legend | grep -c .)"

# ---- 5c. autostart debloat ----
# 22 XDG autostart entries fired for every session. baloo_file is the expensive one:
# a filesystem indexer on a spinning SATA disk is felt continuously. The rest are for
# phones, screen readers, geolocation and other vendors' virtual machines. KEPT:
# plasmashell, kwin, powerdevil, the polkit agent, kwallet, blueman and xdg-user-dirs.
# SP+ adds one autostart of its own (the flameshot daemon, which Print Screen
# needs under Wayland). The removal list below is by name so it survives today;
# the test at the end asserts that, because a future addition to that list which
# happened to match would silently break Print Screen.
RUN for f in baloo_file org.kde.kdeconnect.daemon \
             orca-autostart geoclue-demo-agent org.kde.kunifiedpush-distributor \
             org.kde.xwaylandvideobridge vboxclient vmware-user spice-vdagent; do \
      rm -f "/etc/xdg/autostart/$f.desktop"; \
    done; \
    test -e /etc/xdg/autostart/org.kde.plasmashell.desktop; \
    test -e /etc/xdg/autostart/powerdevil.desktop; \
    test -e /etc/xdg/autostart/polkit-kde-authentication-agent-1.desktop; \
    test ! -e /etc/xdg/autostart/baloo_file.desktop; \
    # DN-47. The store's own notifier is how a normal Plasma desktop tells you an
    # update is waiting. It used to be on the removal list above and only survived
    # by accident, because a later dnf install pulled plasma-discover-notifier back
    # in and restored the file. Ship it on purpose.
    test -e /etc/xdg/autostart/org.kde.discover.notifier.desktop; \
    test ! -e /etc/xdg/autostart/flameshot-daemon.desktop; \
    echo "AUTOSTART_OK count=$(ls /etc/xdg/autostart/ | wc -l)"

# ---- 6. the SP+ Windows 11 global theme (advisors come from Windows) ----
# Vendored, audited subset of KDE-Windows-Modern (GPL-3.0-only, upstream author
# Jeysef; LICENSE and ATTRIBUTION ship alongside it under /usr/share/sp-plus/theme).
# Deliberately NOT shipped: the upstream C++ System Tray and Icon Tasks applets, the
# patched login manager and the lock-screen shell overlay — they fork core Plasma and
# break at every update. The layout uses native Plasma applets instead. Windows Modern
# ships its attributed wallpaper payload separately below; the SP+ Calm wallpaper stays
# available as the existing fallback asset for the other profiles.
COPY theme/look-and-feel/  /usr/share/plasma/look-and-feel/
COPY theme/desktoptheme/   /usr/share/plasma/desktoptheme/
COPY theme/color-schemes/  /usr/share/color-schemes/
COPY theme/aurorae/        /usr/share/aurorae/themes/
COPY theme/icons/          /usr/share/icons/
COPY theme/Kvantum/        /usr/share/Kvantum/
# Windows Modern owns the icon role. Its index.theme inherits Breeze for the
# platform fallbacks, but the selected theme name is not an unrelated Papirus
# package.
COPY theme/wallpaper/Windows-modern/ /usr/share/wallpapers/Windows-modern/
# Per-theme wallpapers. Each global theme names its own background in its
# contents/defaults, so these are not decoration on top of a theme: they are
# part of what the advisor chooses on the Welcome look screen. Licence status
# for both is recorded in the ATTRIBUTION.md inside each package.
COPY theme/wallpaper/SPPlus-Night-Ridge/  /usr/share/wallpapers/SPPlus-Night-Ridge/
COPY theme/wallpaper/SPPlus-Blue-Horizon/ /usr/share/wallpapers/SPPlus-Blue-Horizon/
COPY theme/wallpaper/SPPlus-Paint-Tide/    /usr/share/wallpapers/SPPlus-Paint-Tide/
COPY theme/wallpaper/SPPlus-Moonrise-Range/ /usr/share/wallpapers/SPPlus-Moonrise-Range/
COPY theme/wallpaper/SPPlus-Still-Water/   /usr/share/wallpapers/SPPlus-Still-Water/
COPY theme/wallpaper/SPPlus-Winter-River/  /usr/share/wallpapers/SPPlus-Winter-River/
# The two stock Breeze themes cannot name a wallpaper in their own defaults:
# those packages belong to plasma-workspace and an RPM update would revert the
# edit silently. This SP+-owned table is what spplus-apply-theme reads instead.
COPY config/theme/wallpaper-overrides.conf /usr/share/sp-plus/theme/wallpaper-overrides.conf
COPY theme/LICENSE-Windows-Modern-GPL3 theme/ATTRIBUTION-Windows-Modern.md /usr/share/sp-plus/theme/

# ---- 5c. Flathub, shipped rather than added at runtime (DN-26) ---------------
# DN-26 makes Flathub open. The image already carries flatpak 1.18.1, Discover and
# the Discover flatpak backend; the only thing missing was a source of applications.
#
# The remote ships as a vendor file in /usr/share/flatpak/remotes.d rather than
# being added by a runtime `flatpak remote-add`. That matters on a bootc system:
# a vendor remote is part of the image, so it is present at first boot, survives
# `bootc rollback`, and cannot be half-applied if a first-login script fails. It
# also means SP+ Welcome does not have to succeed at a network call before the
# advisor can install anything. /etc/flatpak/remotes.d stays free for a local
# override, which is the documented precedence order.
#
# The .flatpakrepo is committed rather than curled at build time so the GPG key we
# ship is auditable in git history and the build stays reproducible offline.
COPY config/flatpak/flathub.flatpakrepo /usr/share/flatpak/remotes.d/flathub.flatpakrepo

# --- Zoom, and the base Flatpak set (DN-26). ----------------------------------
# Declared here, deployed at runtime. A Flatpak cannot be baked into the image:
# the system installation lives in /var/lib/flatpak, which is machine state on a
# bootc system, not image content. So the image ships the DECLARATION and a
# timer converges the machine onto it.
#
# Nothing in Fedora triggers `flatpak preinstall` on its own -- there is no
# flatpak preinstall unit in this image, checked on the cycle36 guest -- so SP+
# has to run it. It is a timer rather than a unit wanted by a target because the
# first run pulls roughly a gigabyte of freedesktop runtime, and a target waits
# for the units wanted by it. Wiring this into multi-user.target would hold the
# advisor at a black screen on first boot.
COPY config/flatpak/preinstall.d/ /usr/share/flatpak/preinstall.d/
COPY config/spplus-flatpak-preinstall.service /usr/lib/systemd/system/spplus-flatpak-preinstall.service
COPY config/spplus-flatpak-preinstall.timer   /usr/lib/systemd/system/spplus-flatpak-preinstall.timer

RUN systemctl enable spplus-flatpak-preinstall.timer \
 && test -L /etc/systemd/system/timers.target.wants/spplus-flatpak-preinstall.timer \
 && test -s /usr/share/flatpak/preinstall.d/sp-plus-zoom.preinstall \
 && grep -q '^\[Flatpak Preinstall us.zoom.Zoom\]$' /usr/share/flatpak/preinstall.d/sp-plus-zoom.preinstall \
 && grep -q '^Branch=stable$' /usr/share/flatpak/preinstall.d/sp-plus-zoom.preinstall \
 && test -x /usr/bin/flatpak \
 && systemd-analyze verify /usr/lib/systemd/system/spplus-flatpak-preinstall.service \
 && systemd-analyze verify /usr/lib/systemd/system/spplus-flatpak-preinstall.timer \
 && echo "FLATPAK_PREINSTALL_OK zoom declared, timer enabled"

# ---- 5b. Flatpak UPDATES (DN-34) --------------------------------------------
# preinstall DEPLOYS refs; it never advances one that is already installed. So
# without this, DN-26's whole argument for making Zoom a Flatpak -- "a Flatpak
# updates on its own schedule" -- is false on a shipped machine. Zoom refuses
# connections from clients below its minimum version, so the advisor's Zoom
# silently rots until it stops working. Discover can update Flatpaks, but only
# while a human has it open and clicks; the product frame is that everything
# updates from stable with the advisor out of the loop.
COPY config/spplus-flatpak-update.service /usr/lib/systemd/system/spplus-flatpak-update.service
COPY config/spplus-flatpak-update.timer   /usr/lib/systemd/system/spplus-flatpak-update.timer

RUN systemctl enable spplus-flatpak-update.timer \
 && test -L /etc/systemd/system/timers.target.wants/spplus-flatpak-update.timer \
 && grep -q '^ExecStart=/usr/bin/flatpak update --appstream --system --noninteractive -y$' \
      /usr/lib/systemd/system/spplus-flatpak-update.service \
 && grep -q '^ExecStart=/usr/bin/flatpak update --system --noninteractive -y$' \
      /usr/lib/systemd/system/spplus-flatpak-update.service \
 && grep -q '^Persistent=true$' /usr/lib/systemd/system/spplus-flatpak-update.timer \
 && systemd-analyze verify /usr/lib/systemd/system/spplus-flatpak-update.service \
 && systemd-analyze verify /usr/lib/systemd/system/spplus-flatpak-update.timer \
 && u_pre=$(grep '^OnBootSec=' /usr/lib/systemd/system/spplus-flatpak-preinstall.timer) \
 && u_upd=$(grep '^OnBootSec=' /usr/lib/systemd/system/spplus-flatpak-update.timer) \
 && [ "$u_pre" != "$u_upd" ] \
 && echo "DN34_FLATPAK_UPDATE_OK daily, persistent, staggered off preinstall"

# ---- 5c. Wi-Fi power saving OFF (DN-36) -------------------------------------
# See the header of the conf file for the measured numbers. Short version: the
# 7260 parks between beacons and LAN latency goes from 1.4 ms to 71 ms average
# with 125 ms spikes, which an advisor experiences as the desktop stalling.
# /usr/lib so it is image content and survives bootc upgrade; /etc stays free
# for a local override, which NetworkManager honours over /usr/lib.
COPY config/networkmanager/90-spplus-wifi-powersave.conf /usr/lib/NetworkManager/conf.d/90-spplus-wifi-powersave.conf

RUN test -s /usr/lib/NetworkManager/conf.d/90-spplus-wifi-powersave.conf \
 && grep -q '^\[connection\]$' /usr/lib/NetworkManager/conf.d/90-spplus-wifi-powersave.conf \
 && grep -q '^wifi.powersave=2$' /usr/lib/NetworkManager/conf.d/90-spplus-wifi-powersave.conf \
 && test ! -e /etc/NetworkManager/conf.d/90-spplus-wifi-powersave.conf \
 && echo "DN36_WIFI_POWERSAVE_OK shipped in /usr/lib, value 2 = disable"

# ---- 5d. GVFS + the SMB backend (DN-40) -------------------------------------
# "Connect this computer to the office" is a headline advisor feature and it
# COULD NOT WORK. Welcome checks the share through GIO and expects GVFS to carry
# the mount and the KDE Wallet credentials -- but GVFS was never in the image.
# Verified on the Dell 2026-08-29: `rpm -qa | grep gvfs` returned NOTHING, there
# was no /usr/libexec/gvfsd-smb and no smb mount definition, and GIO answered
# every mount attempt with NOT_SUPPORTED, "volume doesn't implement mount".
#
# Found by the DN-38 headless self-test. Four GUI QC dispatches never reached it.
#
# This is a BUILD-time install, which is how all image content is added. It is
# NOT runtime rpm-ostree layering on an installed machine -- that is what breaks
# `bootc upgrade` and remains forbidden.
RUN dnf install -y --setopt=install_weak_deps=False gvfs gvfs-smb \
 && dnf clean all \
 && test -x /usr/libexec/gvfsd-smb \
 && test -s /usr/share/gvfs/mounts/smb.mount \
 && echo "DN40_GVFS_SMB_OK office folder mounting is actually installed"

# ---- The software store is the stock one (DN-45) ----------------------------
# SP+ used to launch Discover through a wrapper, /usr/bin/spplus-discover, that
# forced `--backends flatpak,rpm-ostree`, and rewrote the .desktop files to call
# it. The stated reason was to keep PackageKit out of the store.
#
# That reason was already satisfied without the wrapper. PackageKit is not
# installed in this image and packagekit-backend.so does not exist -- asserted
# below, which is the real guard. What the wrapper actually did was hide the two
# backends it forgot to name: fwupd, so the advisor was never offered a firmware
# update, and kns. It also diverged from SP+ Welcome, which has always launched
# /usr/bin/plasma-discover directly, so the store behaved differently depending
# on whether it was opened from the menu or from Welcome.
#
# An allowlist that has to be kept in sync with the set of installed backends is
# the wrong shape for this. The image controls which backends exist; Discover
# should load what is there. So the wrapper is gone and the stock .desktop files
# are left alone, and the assertions below pin the outcome instead: the backends
# we want present, the one we refuse absent, and no wrapper left behind.
RUN set -eux; \
    P=/usr/lib64/qt6/plugins/discover; \
    for b in flatpak rpm-ostree fwupd; do \
        test -e "$P/$b-backend.so" || { echo "STORE GATE FAIL: missing backend $b" >&2; exit 1; }; \
    done; \
    if test -e "$P/packagekit-backend.so"; then \
        echo "STORE GATE FAIL: PackageKit backend is present on an image-mode host" >&2; exit 1; \
    fi; \
    test ! -e /usr/bin/spplus-discover; \
    for d in org.kde.discover.desktop org.kde.discover.flatpak.desktop; do \
        f=/usr/share/applications/$d; \
        test -f "$f" || continue; \
        grep -q '^Exec=plasma-discover' "$f" || { echo "STORE GATE FAIL: $d does not launch stock plasma-discover" >&2; exit 1; }; \
        if grep -q 'spplus-discover' "$f"; then echo "STORE GATE FAIL: $d still points at the removed wrapper" >&2; exit 1; fi; \
        desktop-file-validate "$f"; \
    done; \
    test -s /usr/share/flatpak/remotes.d/flathub.flatpakrepo; \
    grep -q '^Url=https://dl.flathub.org/repo/$' /usr/share/flatpak/remotes.d/flathub.flatpakrepo; \
    grep -q '^GPGKey=' /usr/share/flatpak/remotes.d/flathub.flatpakrepo; \
    echo "STORE_GATE_OK stock Discover, backends flatpak+rpm-ostree+fwupd, no PackageKit, Flathub shipped"

# ---- 6a. SP+ Calm, the shipped default look (DN-27) --------------------------
# SP+ Calm is the OS's own visual language and is deliberately NOT branded to
# secureprospective.com. Christopher's framing: "The Global theme isnt branded to
# the website, its meant for ease on the eyes for hours of work. The slight glow
# highlights will signal windows selected and the state they are in. We need those
# things for productivity, not theming. We have enough of that to get them here,
# the OS is its own animal." Brand colour belongs to the website and to SP+
# Welcome; the desktop answers to eye comfort and state legibility instead.
#
# The Windows 11 theme above is NOT removed -- it stays as a choice in the theme
# picker for advisors who want what they came from.
# DN-28 (2026-08-28): the bespoke SP+ Calm GLOBAL THEME is withdrawn. Two cycles
# of custom look-and-feel work produced a theme that silently failed to apply --
# our hand-authored Aurorae set still named the Plasma 5 decoration plugin after
# KWin moved to .v2 -- and a maintained upstream theme is repaired by its own
# maintainers across those upgrades. SP+ now offers stock and vendored themes.
#
# The SP+ WALLPAPERS are explicitly retained and still ship from the Calm tree.
COPY theme/sp-plus-calm/wallpapers/SPPlus-Calm/ /usr/share/wallpapers/SPPlus-Calm/

# Vendored upstream global themes, pinned and normalised. Each was shipped
# incomplete by its author: none declared fonts, several named icon themes and
# cursors they do not ship, Nordic carried only a Plasma 5 metadata.desktop, and
# Catppuccin's package Id did not match its directory so Plasma could not resolve
# it at all. theme/vendor/ holds the corrected packages; see
# docs/ledger/DECISION-cycle36-drop-custom-global-themes.md for provenance.
COPY theme/vendor/look-and-feel/  /usr/share/plasma/look-and-feel/
COPY theme/vendor/aurorae/        /usr/share/aurorae/themes/
COPY theme/vendor/color-schemes/  /usr/share/color-schemes/
COPY theme/vendor/desktoptheme/   /usr/share/plasma/desktoptheme/
COPY theme/vendor/cursors/        /usr/share/icons/

# Applying a global theme so that EVERY component changes together is not what
# plasma-apply-lookandfeel does on its own: it applies the colour scheme and
# leaves icons, widget style, Plasma theme, decoration, cursor and fonts to the
# session, which is why a theme switch used to move only the colours.
COPY config/spplus-apply-theme /usr/libexec/spplus-apply-theme
COPY theme/tools/validate-global-themes.py /usr/libexec/spplus-validate-global-themes

# kvantum supplies the widget style the theme's defaults select. Without it Qt apps
# fall back and the theme looks half-applied in System Settings.
# kvantum supplies the widget style the Windows 11 theme selects. paper-icon-theme
# and jetbrains-mono-fonts are SP+ Calm's runtime dependencies. Calm names
# Paper-Mono-Dark icons, and without them the shipped DEFAULT theme half-applies --
# stock icons and a silent font fallback -- the exact "looks broken on first boot"
# failure DN-24 was raised about. The UI face is now Noto Sans (already in the
# image); JetBrains Mono stays installed for the terminal and code contexts, where
# a monospace face is the right tool rather than the wrong one. IBM Plex Sans is
# the Secure Prospective body face and is needed by SP+ Welcome, which IS a brand
# surface even though the desktop around it is not (DN-27).
RUN dnf install -y --setopt=install_weak_deps=False \
      kvantum paper-icon-theme papirus-icon-theme papirus-icon-theme-dark \
      jetbrains-mono-fonts \
      ibm-plex-sans-fonts \
 && dnf clean all \
 && gtk-update-icon-cache -f /usr/share/icons/windows-modern || true \
 && gtk-update-icon-cache -f /usr/share/icons/Paper-Mono-Dark || true \
 && test -d /usr/share/icons/Paper-Mono-Dark \
 && test -d /usr/share/icons/Papirus-Dark \
 && test -d /usr/share/icons/windows-modern \
 && fc-list : family | grep -qi 'Noto Sans' \
 && fc-list : family | grep -qi 'IBM Plex Sans' \
 && fc-list : family | grep -qi 'JetBrains Mono' \
 && echo "CALM_DEPS_OK $(rpm -q paper-icon-theme jetbrains-mono-fonts | tr '\n' ' ')"

# Ship SP+ Windows 11 Dark as the default look, system-wide rather than in
# /home, so a fresh advisor account gets it on first login (D25, retargeted by
# DN-28). It leads the SP+ Welcome theme picker because it is closest to what
# advisors are arriving from, so the desktop they first see matches the choice
# the picker recommends. Every other offered theme stays installed and
# selectable, and Welcome is where the advisor changes it (DN-26).
RUN printf '%s\n' \
      '[General]' \
      'ColorScheme=WindowsModernDark' \
      'TerminalApplication=kitty' \
      'LookAndFeelPackage=org.secureprospective.spplus.windows11.dark' \
      '' \
      '[Icons]' \
      'Theme=windows-modern' \
      '' \
      '[KDE]' \
      'widgetStyle=kvantum-dark' \
      'LookAndFeelPackage=org.secureprospective.spplus.windows11.dark' \
      > /etc/xdg/kdeglobals \
 && printf '%s\n' \
      '[Theme]' \
      'name=Windows-modern-dark' \
      > /etc/xdg/plasmarc \
 && printf '%s\n' \
      '[org.kde.kdecoration2]' \
      'library=org.kde.kwin.aurorae.v2' \
      'theme=__aurorae__svg__windows-modern-dark-aurorae' \
      '' \
      '# SP+ ships on laptops with real keys. kwin otherwise launches' \
      '# plasma-keyboard -- the ONSCREEN keyboard -- because its desktop file' \
      '# carries X-KDE-Wayland-VirtualKeyboard=true. Measured on the cycle20' \
      '# guest it cost 266 MB resident for something no advisor will ever tap.' \
      '# An empty InputMethod stops kwin selecting one. The PACKAGE is left' \
      '# installed on purpose: dnf remove --assumeno showed it takes' \
      '# plasma-desktop, plasma-workspace, plasma-setup and sddm with it.' \
      '[Wayland]' \
      'InputMethod=' \
      'VirtualKeyboardEnabled=false' \
      > /etc/xdg/kwinrc \
 && grep -q '^library=org.kde.kwin.aurorae.v2$' /etc/xdg/kwinrc \
 && grep -q '^theme=__aurorae__svg__windows-modern-dark-aurorae$' /etc/xdg/kwinrc \
 && test -d /usr/share/wallpapers/SPPlus-Calm/contents/images \
 && test -f /usr/share/wallpapers/SPPlus-Calm/contents/images/3840x2160.jpg \
 && test -d /usr/share/wallpapers/Windows-modern/contents/images \
 && test -s /usr/share/wallpapers/Windows-modern/contents/images/2560x1440.png \
 && test -s /usr/share/wallpapers/Windows-modern/contents/images_dark/2560x1440.png \
 && test -s /usr/share/wallpapers/SPPlus-Night-Ridge/contents/images/3840x2160.jpg \
 && test -s /usr/share/wallpapers/SPPlus-Blue-Horizon/contents/images/3840x2160.jpg \
 && grep -q '^Image=SPPlus-Night-Ridge$' /usr/share/plasma/look-and-feel/Catppuccin-Mocha/contents/defaults \
 && grep -q '^Image=SPPlus-Blue-Horizon$' /usr/share/plasma/look-and-feel/Catppuccin-Latte/contents/defaults \
 && test -s /usr/share/wallpapers/SPPlus-Paint-Tide/contents/images/2560x1440.jpg \
 && grep -q '^Image=SPPlus-Paint-Tide$' /usr/share/plasma/look-and-feel/com.github.vinceliuice.Orchis/contents/defaults \
 && test -s /usr/share/wallpapers/SPPlus-Moonrise-Range/contents/images/3840x2160.jpg \
 && grep -q '^Image=SPPlus-Moonrise-Range$' /usr/share/plasma/look-and-feel/Nordic/contents/defaults \
 && test -s /usr/share/wallpapers/SPPlus-Still-Water/contents/images/3840x2160.jpg \
 && test -s /usr/share/wallpapers/SPPlus-Winter-River/contents/images/3000x1688.jpg \
 && grep -q '^Image=SPPlus-Still-Water$' /usr/share/sp-plus/theme/wallpaper-overrides.conf \
 && grep -q '^Image=SPPlus-Winter-River$' /usr/share/sp-plus/theme/wallpaper-overrides.conf \
 && grep -q '^\[org.kde.breezedark.desktop\]$' /usr/share/sp-plus/theme/wallpaper-overrides.conf \
 && grep -q '^\[org.kde.breeze.desktop\]$' /usr/share/sp-plus/theme/wallpaper-overrides.conf \
 && ! grep -q 'Image=Next' /usr/share/sp-plus/theme/wallpaper-overrides.conf \
 && test -x /usr/libexec/spplus-apply-theme \
 && ! grep -qF 'check=False' /usr/libexec/spplus-apply-theme \
 && ! grep -qE '\bsleep\b' /usr/libexec/spplus-apply-theme \
 && python3 /usr/libexec/spplus-validate-global-themes --root / \
 && echo "GLOBAL_THEME_DEFAULT_OK themes=$(ls /usr/share/plasma/look-and-feel | wc -l)"

# ---- 6b. DN-24: naming the look and feel is not applying it ----
# Section 6 writes LookAndFeelPackage into /etc/xdg/kdeglobals, and that is
# enough for the colour scheme and the widget style. It is NOT enough for the
# panel layout or the wallpaper: those live in the package's layouts/*.js and
# its [Wallpaper] default, and plasmashell only reads them when the look and
# feel is explicitly APPLIED. A fresh install therefore came up with Fedora's
# wallpaper and Fedora's favourites, while the machine demoed on 2026-08-27 --
# themed by hand -- looked right. That gap is DN-24.
#
# The unit runs inside the advisor's own Plasma session, once, then stamps
# itself so it never overwrites choices the advisor makes later.
COPY config/spplus-first-login         /usr/libexec/spplus-first-login
COPY config/spplus-first-login.service /usr/lib/systemd/user/spplus-first-login.service
COPY config/spplus-printscreen /usr/libexec/spplus-printscreen
COPY config/spplus-printscreen.service /usr/lib/systemd/user/spplus-printscreen.service
COPY config/kscreenlockerrc            /etc/xdg/kscreenlockerrc
COPY config/kcminputrc                 /etc/xdg/kcminputrc

RUN chmod 0755 /usr/libexec/spplus-first-login /usr/libexec/spplus-printscreen \
 && install -d /usr/lib/systemd/user/plasma-workspace.target.wants \
 && ln -sf ../spplus-first-login.service \
      /usr/lib/systemd/user/plasma-workspace.target.wants/spplus-first-login.service \
 && ln -sf ../spplus-printscreen.service \
      /usr/lib/systemd/user/plasma-workspace.target.wants/spplus-printscreen.service \
 && test -x /usr/libexec/spplus-first-login \
 && test -x /usr/libexec/spplus-printscreen \
 && test -L /usr/lib/systemd/user/plasma-workspace.target.wants/spplus-first-login.service \
 && test -L /usr/lib/systemd/user/plasma-workspace.target.wants/spplus-printscreen.service \
 && test -f /usr/lib/systemd/user/plasma-workspace.target \
 && test -x /usr/sbin/plasma-apply-lookandfeel \
 && test -x /usr/sbin/plasma-apply-wallpaperimage \
 && test -r /usr/share/sp-plus/branding/sp-plus-wallpaper.png \
 && test -s /etc/xdg/kscreenlockerrc \
 && grep -q '^Autolock=false$' /etc/xdg/kscreenlockerrc \
 && test -s /etc/xdg/kcminputrc \
 && grep -q '^cursorTheme=breeze_cursors$' /etc/xdg/kcminputrc \
 && test -d /usr/share/icons/breeze_cursors \
 && test -f /usr/share/plasma/look-and-feel/org.secureprospective.spplus.windows11.dark/contents/layouts/org.kde.plasma.desktop-layout.js \
 && grep -q '^Image=Windows-modern$' \
      /usr/share/plasma/look-and-feel/org.secureprospective.spplus.windows11.dark/contents/defaults \
 && grep -q '^Theme=windows-modern$' \
      /usr/share/plasma/look-and-feel/org.secureprospective.spplus.windows11.dark/contents/defaults \
 && grep -q '^ColorScheme=WindowsModernDark$' \
      /usr/share/plasma/look-and-feel/org.secureprospective.spplus.windows11.dark/contents/defaults \
 && bash -n /usr/libexec/spplus-first-login \
 && echo "DN24_FIRST_LOGIN_OK look-and-feel is applied, not merely named"

# ---- 6c. SP+ Welcome, the first screen (DN-26) -------------------------------
# A first-party HTML application in a thin PySide6 QWebEngineView shell. Both
# qt6-qtwebengine and PySide6 are already in the image, so this adds no runtime.
#
# It lives in /usr/libexec because it is not a command an advisor types; /usr/bin
# gets a wrapper so the .desktop entry and anything else has a stable target.
#
# Primal, the Secure Prospective display face, is NOT here. It carries no embedded
# licence string and shipping a font inside an ISO is a different act from serving
# it from our own domain. See welcome/PRIMAL-FONT.md. Headlines fall back to
# Noto Sans Condensed Black, which IS in the image, rather than to Impact, which
# is not and would have silently become generic sans.
COPY welcome/app/        /usr/libexec/sp-plus/welcome/app/
COPY welcome/PREVIEW-CAPTURE-CONTRACT.md /usr/share/sp-plus/theme/PREVIEW-CAPTURE-CONTRACT.md
COPY welcome/welcome.py  /usr/libexec/sp-plus/welcome/welcome.py
COPY tests/welcome-close-gate.sh /usr/libexec/sp-plus/welcome/welcome-close-gate.sh
# ---- DN-49: the pinned Help application ----
#
# The help screen inside Welcome is a step in a sequence, and Welcome is a
# first-run wizard the advisor eventually stops opening. Help is what they
# need at 4pm on a Tuesday when the printer has stopped, so it is also a real
# application with its own window and its own task-bar entry.
#
# It is served over loopback rather than opened from a file because the two
# things that make it an installable app only exist on an http origin: a
# service worker cannot register on file://, so there would be no offline copy
# of the manual, which is precisely what is needed when the network is the
# thing that broke.
#
# The corpus and the search logic are NOT copied here. The server reads the one
# installed copy under welcome/app, so the pinned help and the help inside
# Welcome cannot drift into disagreeing about the manual.
COPY helpapp/server.py /usr/libexec/sp-plus/helpapp/server.py
COPY helpapp/app/      /usr/libexec/sp-plus/helpapp/app/
COPY config/spplus-help.service \
     /usr/lib/systemd/user/spplus-help.service
COPY config/org.secureprospective.spplus.help.desktop \
     /usr/share/applications/org.secureprospective.spplus.help.desktop
COPY config/spplus-pin-help /usr/libexec/spplus-pin-help
COPY tests/help-app-gate.sh  /usr/libexec/sp-plus/tests/help-app-gate.sh
COPY tests/help-app-probe.py /usr/libexec/sp-plus/tests/help-app-probe.py

RUN install -Dm644 /usr/libexec/sp-plus/helpapp/app/icon.svg \
      /usr/share/icons/hicolor/scalable/apps/spplus-help.svg \
 && chmod 0755 /usr/libexec/spplus-pin-help \
 && chmod 0755 /usr/libexec/sp-plus/helpapp/server.py \
 && chmod 0755 /usr/libexec/sp-plus/tests/help-app-gate.sh \
 && bash -n /usr/libexec/spplus-pin-help \
 && bash -n /usr/libexec/sp-plus/tests/help-app-gate.sh \
 && python3 -c "import ast,sys; ast.parse(open(sys.argv[1]).read())" \
      /usr/libexec/sp-plus/helpapp/server.py \
 && desktop-file-validate \
      /usr/share/applications/org.secureprospective.spplus.help.desktop \
 && for f in index.html app.js styles.css manifest.webmanifest sw.js icon.svg; do \
      test -s "/usr/libexec/sp-plus/helpapp/app/$f" || exit 1; \
    done \
 && python3 -c "import json,sys; m=json.load(open(sys.argv[1])); \
assert m['display']=='standalone', 'Help must open as an application, not a browser tab'; \
assert m['start_url']=='/', 'the app must start at its own root'; \
assert m['icons'], 'an installable app needs an icon'" \
      /usr/libexec/sp-plus/helpapp/app/manifest.webmanifest \
 && grep -q "caches.open" /usr/libexec/sp-plus/helpapp/app/sw.js \
 && grep -q "help-data.json" /usr/libexec/sp-plus/helpapp/app/sw.js \
 && grep -q "127.0.0.1" /usr/lib/systemd/user/spplus-help.service \
 && grep -q "^IPAddressDeny=any$" /usr/lib/systemd/user/spplus-help.service \
 && grep -q "8766" /usr/share/applications/org.secureprospective.spplus.help.desktop \
 && systemctl --user --global enable spplus-help.service \
 && test -L /etc/systemd/user/default.target.wants/spplus-help.service \
# The proof-of-concept "Advisor Help" PWA is retired (2026-09-01). It was a
# printer-only page served by the system RPC service and it taught the advisor
# a smaller story about what help is than the real manual does. Two help
# surfaces is one too many, and the wrong one would have been the one that
# opened first.
 && test ! -e /usr/libexec/sp-plus/pwa \
 && ! grep -q '^PWA_ROOT = ' /usr/libexec/sp-plus/spplus_rpc.py \
 && ! grep -q '== "/api/knowledge/printer"' /usr/libexec/sp-plus/spplus_rpc.py \
 && echo "DN49_HELP_APP_OK pinned help ships, serves loopback only, and caches the manual offline"

COPY welcome/org.secureprospective.spplus.welcome.desktop \
     /usr/share/applications/org.secureprospective.spplus.welcome.desktop

RUN printf '%s\n' \
      '#!/usr/bin/bash' \
      '# SP+ Welcome. Runs as the advisor, never as a service account.' \
      'exec /usr/bin/python3 /usr/libexec/sp-plus/welcome/welcome.py "$@"' \
      > /usr/bin/spplus-welcome \
 && chmod 0755 /usr/bin/spplus-welcome \
 && install -d /etc/skel/.config/autostart \
 && cp /usr/share/applications/org.secureprospective.spplus.welcome.desktop \
       /etc/skel/.config/autostart/org.secureprospective.spplus.welcome.desktop \
 && test -x /usr/bin/spplus-welcome \
 && test -f /usr/libexec/sp-plus/welcome/app/index.html \
 && test -f /usr/libexec/sp-plus/welcome/app/help-data.json \
 && grep -q 'function searchHelp' /usr/libexec/sp-plus/welcome/app/app.js \
 && test -f /usr/libexec/sp-plus/welcome/app/help-core.js \
 && grep -q 'SPPlusHelp' /usr/libexec/sp-plus/welcome/app/help-core.js \
 && grep -q 'help-core.js' /usr/libexec/sp-plus/welcome/app/index.html \
 && grep -q 'ask-feedback\[hidden\]' /usr/libexec/sp-plus/welcome/app/app.css \
 && python3 -c "import json,sys; \
d=json.load(open('/usr/libexec/sp-plus/welcome/app/help-data.json')); \
assert len(d) >= 37, 'help corpus shrank to %d articles; it may grow but never shrink' % len(d); \
assert all(x.get('title') and x.get('markdown') and x.get('id') and x.get('source') for x in d), 'a help record is missing a field the reader needs'; \
assert all(x['source'].startswith('knowledge/') for x in d), 'a record still points at the retired help-corpus/ tree; that is a stale duplicate'; \
t=[x['title'] for x in d]; assert len(set(t))==len(t), 'duplicate help titles: an advisor would get the same answer twice'; \
i=[x['id'] for x in d]; assert len(set(i))==len(i), 'duplicate help ids'; \
assert all(len(x['markdown']) >= 500 for x in d), 'a help article is too short to be an answer'; \
c=set(x['category'] for x in d); \
known={'Start here','Your files','Everyday work','Fix a problem','Safety and privacy','Updates and recovery','Get more help'}; \
assert c <= known, 'help category the Welcome screen has no blurb for: %s' % (c-known)" \
 && for cat in 'Start here' 'Your files' 'Everyday work' 'Fix a problem' \
                'Safety and privacy' 'Updates and recovery' 'Get more help'; do \
      grep -qF "'$cat': '" /usr/libexec/sp-plus/welcome/app/help-core.js \
        || { echo "WELCOME HELP GATE FAIL: no blurb for category $cat" >&2; exit 1; }; \
    done \
 && echo "WELCOME_HELP_OK search ships, the answer bar stays hidden, corpus intact" \
 && test -s /usr/share/sp-plus/theme/PREVIEW-CAPTURE-CONTRACT.md \
 && for preview in windows-light.png windows-dark.png breeze-light.png breeze-dark.png nordic-dark.png orchis-light.png catppuccin-latte.png catppuccin-mocha.png; do \
      test -s "/usr/libexec/sp-plus/welcome/app/assets/theme-previews/$preview"; \
    done \
 && test -f /etc/skel/.config/autostart/org.secureprospective.spplus.welcome.desktop \
 && desktop-file-validate /usr/share/applications/org.secureprospective.spplus.welcome.desktop \
 && chmod 0755 /usr/libexec/sp-plus/welcome/welcome-close-gate.sh \
 && python3 -m py_compile /usr/libexec/sp-plus/welcome/welcome.py \
 && grep -q 'def closeEvent' /usr/libexec/sp-plus/welcome/welcome.py \
 && grep -q -- '--self-test-close' /usr/libexec/sp-plus/welcome/welcome.py \
 && python3 -c "import json,sys; json.load(open('/usr/libexec/sp-plus/welcome/app/help-data.json'))" \
 && W=/usr/libexec/sp-plus/welcome/app/index.html \
# The header claims LOCAL SETUP / NO DATA SENT on every screen. Verified
# 2026-08-28: that is TRUE today -- the only fetch in the payload is the local
# help-data.json, there is no remote src or href, and welcome.py sets
# LocalContentCanAccessRemoteUrls False. It stops being true the moment the ask
# box wires Welcome to cloud Fin. Nobody will remember to change a header in a
# different file on that day, so the two are coupled here instead of in memory.
 && if grep -q 'id="ask-fin"' "$W"; then \
      grep -q "NO DATA SENT" "$W" \
        && { echo "WELCOME FAILED: the ask box ships but the header still claims NO DATA SENT"; exit 1; }; \
      echo "WELCOME_EGRESS_OK ask box present, no-data claim withdrawn"; \
    else \
      grep -q "NO DATA SENT" "$W" \
        || { echo "WELCOME FAILED: no ask box, so the NO DATA SENT claim should still stand"; exit 1; }; \
      echo "WELCOME_EGRESS_OK no ask box, no-data claim is true"; \
    fi \
 && ! grep -qE 'src="http|href="http' "$W" \
 && grep -q "LocalContentCanAccessRemoteUrls, False" /usr/libexec/sp-plus/welcome/welcome.py \
 && python3 -c "import PySide6.QtWebEngineWidgets" \
 # The em-dash ban is a typography rule about the text an advisor reads. -I keeps
 # it to text files: the staged theme previews are compressed PNGs, and one of them
 # (orchis-light.png) happens to contain the bytes E2 80 94 in its deflate stream,
 # which without -I fails this gate on image data nobody will ever read as prose.
 && ! grep -rIqlP '\xe2\x80\x94' /usr/libexec/sp-plus/welcome/app/ \
 && if [ -f /usr/libexec/sp-plus/welcome/app/fonts/Primal.ttf ]; then \
      echo "WELCOME_OK primal=SHIPPED"; \
    else \
      fc-list : family | grep -qi 'Noto Sans Condensed' \
      && echo "WELCOME_OK primal=ABSENT fallback=NotoSansCondensedBlack (see welcome/PRIMAL-FONT.md)"; \
    fi

# ---- 7. DN-17: the first screen an advisor ever sees ----
# plasma-setup is the account-creation wizard, and with DN-13 (no pre-created
# account) it is the FIRST thing anyone sees after installing. Stock, its headline
# reads "Welcome to Plasma Desktop" -- it names KDE, not SP+, to a user who has
# never heard of either. That headline is compiled into plasma-setup's QML
# resources; there is no config key for it. The supported override is the gettext
# catalog: the installed system runs LANG="en_US.UTF-8" (Anaconda writes
# /etc/locale.conf) and upstream ships no en_US catalog, so ours is loaded.
# Only the strings that name Plasma to the user are rebranded.
#
# plasma-setup itself is NOT removed and must never be: it is the only path by
# which the advisor's account comes into existence. Its sibling plasma-welcome
# (the "tour Plasma" app) IS removed in the trim above -- a product tour of KDE is
# the wrong second screen for SP+.
COPY branding/locale/org.kde.plasmasetup.mo \
     /usr/share/locale/en_US/LC_MESSAGES/org.kde.plasmasetup.mo
COPY branding/locale/org.kde.plasmasetup.en_GB.mo \
     /usr/share/locale/en_GB/LC_MESSAGES/org.kde.plasmasetup.mo
# cycle26 PROVED the en_US catalog alone is not enough: the wizard still read
# "Welcome to Plasma Desktop" on the panel even though the catalog resolved
# correctly under plain gettext. Two causes are possible and they were not
# separable without running the wizard with a modified environment:
#   (a) ki18n treats en_US as its untranslated SOURCE language and never
#       consults a catalog for it, or
#   (b) plasma-setup.service runs with no LANG at all, so gettext short-circuits.
# This drop-in covers BOTH. LANG makes the service a localised process at all;
# LANGUAGE puts en_GB -- a real translation target that ki18n will not treat as
# source -- ahead of en_US. The en_GB catalog is upstream's own (it carried a
# single "Password:" entry, preserved) with the SP+ overrides merged on top, so
# nothing British leaks in beyond what upstream already shipped.
# cycle27 MEASURED both of those causes and settled it, so this is no longer a
# guess. Two facts were established against the built image:
#   1. /etc/locale.conf DOES NOT EXIST in fedora-kinoite:44. The system has no
#      LANG at all, so every process starts in the C locale and gettext returns
#      the msgid untranslated. That is cause (b), confirmed.
#   2. The wizard is NOT a child of plasma-setup.service. That unit is a oneshot
#      running /usr/libexec/plasma-setup-bootutil, which starts the wizard as the
#      system user plasma-setup (uid 968) under display-manager autologin. A
#      systemd Environment= drop-in on plasma-setup.service therefore CANNOT
#      reach the process that draws the panel, which is why cycle27 shipped
#      DN17_LOCALE_OK and still rendered "Welcome to Plasma Desktop".
# The msgid itself was cleared: our catalog's key is byte-identical to the one in
# upstream's own nl catalog, so the .mo is not the problem.
#
# The fix therefore sets the locale at the two layers the wizard's session really
# reads. /etc/locale.conf is the system-wide default systemd exports into every
# user manager, and /usr/lib/environment.d/ is consumed by the
# 30-systemd-environment-d-generator that this image already ships, which reaches
# every systemd user session including the plasma-setup autologin one. LANG stays
# en_US so dates, paper size and spelling stay American for a US advisor; only
# LANGUAGE -- which governs message lookup alone -- puts en_GB first, because
# en_GB trails it purely as a belt-and-braces second entry.
#
# ORDER MATTERS AND IT WAS WRONG ONCE. Cycle28 shipped LANGUAGE=en_GB:en_US and
# Christopher's real install came up with BRITISH ENGLISH preselected on the
# wizard's language page (DN-22): the page's default is
# Language.LanguageUtil.currentLanguage, which follows the FIRST entry of
# LANGUAGE. Leading with en_US fixes that. The SP+ strings still resolve --
# libKF6I18n has no en_US special case, it simply builds its lookup list from
# LANGUAGE, and the catalog resolves identically for ['en_US'], ['en_US','en_GB']
# and ['en_GB','en_US']. Cycle26's failure, long blamed on ki18n treating en_US
# as an untranslated source language, was really just that it had no LANG and no
# LANGUAGE at all, so the list was empty.
# The service drop-in is kept as well: it costs nothing and covers bootutil.
RUN printf '%s\n' 'LANG=en_US.UTF-8' 'LANGUAGE=en_US:en_GB' > /etc/locale.conf \
 && install -d /usr/lib/environment.d \
 && printf '%s\n' 'LANG=en_US.UTF-8' 'LANGUAGE=en_US:en_GB' \
      > /usr/lib/environment.d/90-sp-plus-locale.conf \
 && install -d /usr/lib/systemd/system/plasma-setup.service.d \
 && printf '%s\n' \
      '[Service]' \
      'Environment=LANG=en_US.UTF-8' \
      'Environment=LANGUAGE=en_US:en_GB' \
      > /usr/lib/systemd/system/plasma-setup.service.d/10-sp-plus-locale.conf \
 && grep -q '^LANGUAGE=en_US:en_GB$' /etc/locale.conf \
 && grep -q '^LANGUAGE=en_US:en_GB$' /usr/lib/environment.d/90-sp-plus-locale.conf \
 && grep -q '^Environment=LANGUAGE=en_US:en_GB$' \
      /usr/lib/systemd/system/plasma-setup.service.d/10-sp-plus-locale.conf \
 && test -f /usr/lib/systemd/user-environment-generators/30-systemd-environment-d-generator
RUN grep -q '^LANG=en_US.UTF-8$' /etc/locale.conf \
 && locale -a | grep -qx 'en_GB.utf8' \
 && locale -a | grep -qx 'en_US.utf8' \
 && test -s /usr/share/locale/en_GB/LC_MESSAGES/org.kde.plasmasetup.mo \
 && grep -q 'Welcome to<br/><b>SP+</b>' \
      /usr/share/locale/en_GB/LC_MESSAGES/org.kde.plasmasetup.mo \
 && grep -q 'Password:' /usr/share/locale/en_GB/LC_MESSAGES/org.kde.plasmasetup.mo \
 && systemctl is-enabled plasma-setup.service \
 && echo "DN17_LOCALE_OK locale.conf + environment.d + drop-in, en_US leads the LANGUAGE list"
# ---- 7b. DN-20: Konqi is on the LAST screen the audience sees ----
# The wizard's "Completed!" page ships /usr/share/plasma/packages/
# org.kde.plasmasetup.finished/contents/ui/konqi-calling.png -- Konqi, the KDE
# dragon mascot -- and main.qml renders it with a bare relative `source:`. On an
# SP+ demo that is a KDE mascot as the closing frame of a first-run experience
# that is otherwise branded end to end. The wizard pages are plain, unbundled QML
# on disk (only the outer Wizard.qml is compiled into the binary), so the honest
# fix is to replace the asset in place at the same 500x334 the QML lays out for,
# rather than patch a relative path. The .license file is rewritten too, because
# leaving the upstream KDE licence stamp on an SP+ asset would be a false claim.
COPY branding/plasmasetup-finished.png \
     /usr/share/plasma/packages/org.kde.plasmasetup.finished/contents/ui/konqi-calling.png
RUN F=/usr/share/plasma/packages/org.kde.plasmasetup.finished/contents/ui \
 && printf '%s\n' \
      'SPDX-FileCopyrightText: 2026 SecureProspective' \
      'SPDX-License-Identifier: LicenseRef-SP-Plus-Branding' \
      > "$F/konqi-calling.png.license" \
 && python3 -c "import struct,sys; d=open('$F/konqi-calling.png','rb').read(); \
w,h=struct.unpack('>II', d[16:24]); \
sys.exit(0 if (d[:8]==b'\x89PNG\r\n\x1a\n' and (w,h)==(500,334)) else 1)" \
 && grep -q 'SecureProspective' "$F/konqi-calling.png.license" \
 && grep -q 'konqi-calling.png' "$F/main.qml" \
 && echo "DN20_FINISHED_ART_OK SP+ lockup replaces Konqi at 500x334 on the final wizard page"

# ---- 7c. DN-23: the first-run wizard cannot stall a demo it never runs ----
# Christopher installed cycle28 on real hardware, walked the wizard, and the final
# "Complete" button did not advance: the artwork vanished and the machine sat
# there with no way forward. A machine that cannot finish first-run setup cannot
# be demonstrated at all, so this is demo-fatal.
#
# I could NOT reproduce it in the lane before the deadline, and I refuted both
# leading theories with evidence rather than argument:
#   * SELinux: all 10 AVCs on a real boot are permissive=1 and belong to
#     bootupctl/bootupd_t. Nothing denied for plasma-setup or its KAuth helper.
#   * removeautologin against the wrong display manager: running
#     /usr/libexec/plasma-setup-bootutil --remove-autologin by hand on the
#     installed system returns 0 and writes its config cleanly.
# With the cause unknown, engineering a fix would be a guess, and a guess is
# exactly what must not ship into a demo.
#
# So the wizard is taken off the demo path entirely by pre-creating the flag file
# plasma-setup.service itself tests for (ConditionPathExists=!/etc/plasma-setup-done).
# The unit stays enabled and completely stock; it simply finds its work already
# done and exits. Nothing functional is lost: SP+ ships no account (DN-13) and
# Anaconda already collects the account, language, keyboard and timezone, which is
# every page the wizard offered. The machine now goes LUKS -> login -> desktop.
#
# The cost is real and is recorded here so it is not forgotten: the branded
# "Welcome to SP+" first screen (DN-17) and the SP+ artwork on the closing page
# (DN-20) are both built, both verified, and now never seen. DN-17's catalog,
# locale wiring and DN-20's artwork all remain in the image, so removing this one
# file is all it takes to put the wizard back once DN-23 is genuinely understood.
RUN printf '%s\n' \
      '# SP+ DN-23: first-run wizard deliberately pre-completed.' \
      '# Remove this file to re-enable the Plasma Setup wizard.' \
      > /etc/plasma-setup-done \
 && test -s /etc/plasma-setup-done \
 && grep -q 'DN-23' /etc/plasma-setup-done \
 && systemctl is-enabled plasma-setup.service \
 && echo "DN23_WIZARD_BYPASSED_OK flag file present; plasma-setup will find its work done"

RUN test -s /usr/share/locale/en_US/LC_MESSAGES/org.kde.plasmasetup.mo \
 && grep -q 'Welcome to<br/><b>SP+</b>' \
      /usr/share/locale/en_US/LC_MESSAGES/org.kde.plasmasetup.mo \
 && grep -q 'Plasma Desktop' \
      /usr/share/locale/en_US/LC_MESSAGES/org.kde.plasmasetup.mo \
 && test -x /usr/libexec/plasma-setup \
 && systemctl is-enabled plasma-setup.service \
 && echo "DN17_BRANDING_OK en_US catalog installed, plasma-setup still enabled"

# ---- 8. operations tuning for a spinning disk ----
# SP+ is demoed and deployed on an old laptop: 8 GB of RAM, zram swap, and a
# rotational SATA drive. Two things follow, and only one of them needs changing.
#
# The I/O scheduler needs NOTHING: udev's 60-block-scheduler.rules already
# selects bfq for rotational devices, verified on the cycle20 guest
# ("sda rot=1 sched=none mq-deadline kyber [bfq]"). Do not "fix" it.
#
# vm.swappiness does need changing. The stock 60 is tuned for swap on a disk.
# Here swap is zram -- compressed pages in RAM -- while the filesystem is on
# rust, so swapping is orders of magnitude CHEAPER than dropping page cache and
# re-reading it from the platter. The established value for in-memory swap
# backed by an HDD is ~180 (Pop!_OS default; ArchWiki advises >100 for zram).
# This is a community-established tuning, not a Fedora default.
RUN printf '%s\n' \
      '# SP+: swap is zram, the filesystem is on a spinning disk.' \
      '# Prefer compressing cold pages in RAM over re-reading from the platter.' \
      'vm.swappiness = 180' \
      > /usr/lib/sysctl.d/60-sp-plus-zram.conf \
 && test -s /usr/lib/sysctl.d/60-sp-plus-zram.conf \
 && grep -q '^vm.swappiness = 180$' /usr/lib/sysctl.d/60-sp-plus-zram.conf \
 && echo "TUNING_OK vm.swappiness=180 for zram over rotational storage"

# ---- 9. the application menu an advisor actually opens ----
# Stock, the menu offers 44 entries. An advisor who has never used Linux should
# not be handed a partition editor, three KDE Connect entries, a coredump
# browser and two of everything. Each entry below is hidden with NoDisplay,
# NOT removed: the binaries stay, anything that launches them still works, and
# the choice is one config line to reverse. Removing the packages instead is how
# cycle23 lost bootc.
#
# Four groups, and the reason matters more than the list:
#   dangerous   -- partitionmanager can wipe the disk from a menu click
#   diagnostic  -- kdebugsettings, journald, coredumps, infocenter, menu editor,
#                  filelight: real tools, meaningless to the audience
#   duplicate   -- kdesystemsettings (systemsettings ships too), blueman x2
#                  (System Settings owns Bluetooth), konsole (kitty is the SP+
#                  terminal and Fin opens in it), kate (kwrite + micro ship),
#                  kfind (Dolphin searches), kwalletmanager (KeePassXC is the
#                  shipped password manager)
#   confusing   -- kdeconnect x3 (phone pairing; its daemon is already off),
#                  krfb (remote desktop, a security surface), kvantummanager
#                  (theme internals -- it can break the SP+ look), kcharselect,
#                  emojier
#
# Deliberately LEFT VISIBLE and not up for quiet removal: Brave, Thunderbird,
# LibreOffice Writer/Calc, Okular, Gwenview, Dolphin, KCalc, KeePassXC, Fin,
# kitty, System Settings, System Monitor, Firewall, Discover, Print Settings,
# Spectacle, Flameshot, KWrite, micro, Ark, Help Center.
RUN for d in org.kde.partitionmanager \
             org.kde.kdebugsettings org.kde.kjournaldbrowser \
             org.kde.drkonqi.coredump.gui org.kde.kinfocenter \
             org.kde.kmenuedit org.kde.filelight \
             kdesystemsettings blueman-adapters blueman-manager \
             org.kde.konsole org.kde.kate org.kde.kfind org.kde.kwalletmanager \
             org.kde.kdeconnect.app org.kde.kdeconnect.nonplasma \
             org.kde.kdeconnect.sms org.kde.krfb kvantummanager \
             org.kde.kcharselect org.kde.plasma.emojier; do \
      f="/usr/share/applications/$d.desktop"; \
      [ -e "$f" ] || continue; \
      desktop-file-edit --set-key=NoDisplay --set-value=true "$f" \
        || { echo "MENU FAILED to hide $d"; exit 1; }; \
    done; \
    for d in org.kde.partitionmanager org.kde.konsole org.kde.kdeconnect.app; do \
      grep -q '^NoDisplay=true' "/usr/share/applications/$d.desktop" \
        || { echo "MENU FAILED: $d still visible"; exit 1; }; \
    done; \
    for d in brave-browser net.thunderbird.Thunderbird libreoffice-writer \
             libreoffice-calc libreoffice-impress libreoffice-draw \
             libreoffice-base libreoffice-math \
             org.kde.dolphin org.kde.okular org.kde.kcalc \
             org.keepassxc.KeePassXC fin kitty systemsettings \
             org.kde.plasma-systemmonitor org.kde.discover; do \
      f="/usr/share/applications/$d.desktop"; \
      test -e "$f" || { echo "MENU FAILED: keeper $d is missing"; exit 1; }; \
      grep -q '^NoDisplay=true' "$f" \
        && { echo "MENU FAILED: keeper $d got hidden"; exit 1; }; \
    done; \
    vis=$(for f in /usr/share/applications/*.desktop; do \
            grep -q '^NoDisplay=true' "$f" && continue; \
            grep -q '^Hidden=true' "$f" && continue; \
            grep -q '^Exec=' "$f" && echo x; \
          done | grep -c .); \
    echo "MENU_OK visible_entries=$vis"

# ---- 10. DN-15: give plymouth a reason to take over the panel ----
# The real cause of the black screen at the LUKS passphrase prompt, found on the
# cycle24 panel strip. Frames f11-f22 -- twenty-four seconds while the passphrase
# was being asked -- showed GRUB's plain "Booting a command list" text on a VGA
# console. Plymouth had not taken over the panel AT ALL. So this was never the
# theme or the script plugin: those were necessary, and they are correct now, but
# they were never sufficient.
#
# The installed kernel command line, read back off the cycle24 serial, is:
#   ... ostree=/ostree/boot.1/default/<sha>/0 console=ttyS0,115200
# There is no rhgb. Without it plymouth does not take the panel, so the advisor
# is asked for a passphrase by a machine that looks switched off.
#
# bootc owns the installed kargs, so set them the image-mode-native way rather
# than in the kickstart -- this way they survive `bootc upgrade` too. The final
# `bootc container lint` in this file validates the syntax of this directory.
RUN printf '%s\n' \
      '# SP+ DN-15: without rhgb, plymouth never takes the panel and the LUKS' \
      '# passphrase prompt is invisible -- the machine looks dead. quiet keeps' \
      '# the kernel log off the splash so the advisor sees the prompt, not scroll.' \
      'kargs = ["rhgb", "quiet"]' \
      > /usr/lib/bootc/kargs.d/10-sp-plus-splash.toml \
 && grep -q 'kargs = \["rhgb", "quiet"\]' \
      /usr/lib/bootc/kargs.d/10-sp-plus-splash.toml \
 && echo "DN15_KARGS_OK rhgb quiet staged for the installed cmdline"

# ---- 11. default applications that actually exist ----
# Measured, not assumed. Resolving each type in XDG order against the real image
# BEFORE this layer gave:
#   x-scheme-handler/https  -> org.kde.falkon.desktop   exists=False
#   x-scheme-handler/mailto -> org.kde.kmail2.desktop   exists=False
#   text/plain              -> org.kde.kate.desktop     exists=True
#   inode/directory, application/pdf, image/png         exists=True
#
# So the real breakage is narrower than Fedora's GNOME-era
# /usr/share/applications/mimeapps.list first suggests: that file does point at
# firefox, gedit, Nautilus, Evince and eog, none of which ship here, but KDE's
# kde-mimeapps.list sits above it and already answers folders, PDFs and images
# correctly. What is genuinely broken is the two that matter most on a demo --
# CLICKING A WEB LINK and CLICKING A MAILTO both resolve to programs that do not
# exist, so nothing happens at all.
#
# text/plain is remapped too, for a different reason: Kate exists but is the
# developer editor, and this file hides it from the menu. Opening a .txt should
# land in KWrite, which the advisor can actually find again.
#
# Fixed at the sysadmin level. Per the XDG association spec the lookup order is
# $XDG_CONFIG_DIRS/<desktop>-mimeapps.list, then $XDG_CONFIG_DIRS/mimeapps.list,
# and only then the $XDG_DATA_DIRS copies -- so /etc/xdg/kde-mimeapps.list wins
# inside the Plasma session and /etc/xdg/mimeapps.list covers everything else.
# Both are written, with identical content, so neither path can fall through to
# the broken lists. The vendor files in /usr/share are left untouched.
RUN printf '%s\n' \
      '[Default Applications]' \
      'x-scheme-handler/http=brave-browser.desktop' \
      'x-scheme-handler/https=brave-browser.desktop' \
      'x-scheme-handler/about=brave-browser.desktop' \
      'x-scheme-handler/unknown=brave-browser.desktop' \
      'text/html=brave-browser.desktop' \
      'application/xhtml+xml=brave-browser.desktop' \
      'x-scheme-handler/mailto=net.thunderbird.Thunderbird.desktop' \
      'message/rfc822=net.thunderbird.Thunderbird.desktop' \
      'text/plain=org.kde.kwrite.desktop' \
      'inode/directory=org.kde.dolphin.desktop' \
      'application/pdf=okularApplication_pdf.desktop' \
      'image/png=org.kde.gwenview.desktop' \
      'image/jpeg=org.kde.gwenview.desktop' \
      'image/gif=org.kde.gwenview.desktop' \
      'image/webp=org.kde.gwenview.desktop' \
      'image/svg+xml=org.kde.gwenview.desktop' \
      > /etc/xdg/mimeapps.list \
 && cp /etc/xdg/mimeapps.list /etc/xdg/kde-mimeapps.list \
 && for f in /etc/xdg/mimeapps.list /etc/xdg/kde-mimeapps.list; do \
      grep -q '^x-scheme-handler/https=brave-browser.desktop$' "$f" \
        || { echo "MIME FAILED: https not mapped in $f"; exit 1; }; \
    done \
 && for d in brave-browser net.thunderbird.Thunderbird org.kde.kwrite \
             org.kde.dolphin okularApplication_pdf org.kde.gwenview; do \
      test -e "/usr/share/applications/$d.desktop" \
        || { echo "MIME FAILED: handler $d does not exist"; exit 1; }; \
    done \
 && grep -q '^TerminalApplication=kitty$' /etc/xdg/kdeglobals \
 && test -x /usr/bin/kitty \
 && echo "MIME_OK defaults point at applications that exist"

# ---- 12. Brave's first run, on a financial advisor's machine ----
# Clicking the browser must land on a web page, not on onboarding. Stock Brave
# opens a welcome flow, nags to become the default browser, offers to save
# passwords in competition with the KeePassXC we ship, and surfaces Rewards,
# Wallet and VPN -- crypto promotion is the wrong thing to put in front of an
# advisor's clients. Brave reads Chromium enterprise policy from
# /etc/brave/policies/managed. The brave-browser package does NOT create it --
# verified against brave-browser-1.94.117, whose RPM owns no path under
# /etc/brave at all -- so this layer creates the directory before writing.
#
# Brave opens on Help (DN-49), and the home button returns there. Christopher's
# call, 2026-09-01. An advisor who does not yet know what this computer can do
# should land somewhere that answers that, rather than on a promotional new-tab
# page. Help is a user service on 8766 that starts with the session, and once it
# has been opened once its service worker holds the manual offline, so the page
# still answers on a machine with no network.
#
# If the service has not finished starting, Brave shows its own connection
# error and a reload works. That is the honest failure and it is recoverable;
# the alternative, a page that silently is not there, is not.
#
# Caveat recorded honestly: brave-browser issue #45106 reports Rewards, Wallet
# and AI Chat still appearing despite policy on some builds. Treat this as
# best-effort suppression, NOT as a guarantee, and check brave://policy on the
# demo machine before standing in front of anyone.
RUN install -d -m 0755 /etc/brave/policies/managed \
 && printf '%s\n' \
      '{' \
      '  "HomepageLocation": "http://127.0.0.1:8766/",' \
      '  "HomepageIsNewTabPage": false,' \
      '  "ShowHomeButton": true,' \
      '  "RestoreOnStartup": 4,' \
      '  "RestoreOnStartupURLs": ["http://127.0.0.1:8766/"],' \
      '  "BraveRewardsDisabled": true,' \
      '  "BraveWalletDisabled": true,' \
      '  "BraveVPNDisabled": true,' \
      '  "BraveAIChatEnabled": false,' \
      '  "BraveNewsDisabled": true,' \
      '  "BraveTalkDisabled": true,' \
      '  "TorDisabled": true,' \
      '  "BraveP3AEnabled": false,' \
      '  "BraveStatsPingEnabled": false,' \
      '  "BraveWebDiscoveryEnabled": false,' \
      '  "MetricsReportingEnabled": false,' \
      '  "PromotionalTabsEnabled": false,' \
      '  "DefaultBrowserSettingEnabled": false,' \
      '  "PasswordManagerEnabled": false,' \
      '  "AutofillCreditCardEnabled": false,' \
      '  "BookmarkBarEnabled": true' \
      '}' \
      > /etc/brave/policies/managed/sp-plus.json \
 && python3 -c "import json,sys; d=json.load(open('/etc/brave/policies/managed/sp-plus.json')); \
assert d['BraveRewardsDisabled'] and d['PromotionalTabsEnabled'] is False, 'promotional surfaces are not suppressed'; \
assert d['HomepageLocation'] == 'http://127.0.0.1:8766/', 'the home button does not go to Help'; \
assert d['RestoreOnStartup'] == 4 and d['RestoreOnStartupURLs'] == ['http://127.0.0.1:8766/'], 'Brave does not open on Help'; \
assert d['HomepageIsNewTabPage'] is False, 'the new tab page would win over Help'" \
 && test -d /etc/brave/policies/managed \
 && echo "BRAVE_POLICY_OK $(python3 -c "import json; print(len(json.load(open('/etc/brave/policies/managed/sp-plus.json'))))") policies, valid JSON"

ENV SPPLUS_ROOT=/usr/libexec/sp-plus
ENV SPPLUS_PRINTER_FIXTURE=1
ENV SPPLUS_LISTEN_ADDRESS=127.0.0.1
ENV SPPLUS_LISTEN_PORT=8765

LABEL org.opencontainers.image.title="SP+" \
      org.opencontainers.image.description="SP+ Advisor OS — KDE image-mode payload" \
      org.opencontainers.image.version="${SPPLUS_RELEASE}" \
      com.secureprospective.build="${SPPLUS_BUILD}"

RUN bootc container lint
