# SP+ payload image — this is the image the ISO installs onto the advisor's disk.
# DN-18: this file used to be four lines (bare Kinoite) while the real product was
# described in projects/sp-plus/Containerfile, which the sanctioned build never built.
# The two are merged here. Build context is projects/sp-plus/.
#   sudo podman build -t localhost/sp-plus-kde:spike -f images/kde/Containerfile .
# Fedora 44 everywhere. DN-13 is satisfied absolutely: NO human account ships at all.
FROM quay.io/fedora/fedora-kinoite:44

# ---- 1. platform + advisor application suite (spb-manifest, spb-appmanifest) ----
RUN dnf install -y --setopt=install_weak_deps=False \
        sddm \
        cups cups-filters cups-pk-helper nss-mdns \
        firewalld \
        NetworkManager-wifi \
        bluez blueman \
        pipewire wireplumber \
        xdg-desktop-portal-kde \
        udisks2 \
        python3 curl ca-certificates jq sudo desktop-file-utils konsole \
        plymouth plymouth-scripts plymouth-plugin-script \
        libreoffice-writer libreoffice-calc \
        okular dolphin ark gwenview spectacle kate kcalc \
        keepassxc thunderbird system-config-printer \
        micro flameshot kitty \
        plasma-systemsettings plasma-workspace \
 && dnf clean all

# ---- 2. Brave, the advisor-facing application ----
# Kinoite ships /opt as a symlink to a var/opt that does not exist, so Brave's rpm
# fails to unpack: "failed to open dir opt of /opt/brave.com/: cpio: mkdir failed".
# Repoint /opt at /usr/lib/opt so the browser is versioned image content like the
# rest of /usr. bootc discussion #1038, approach 1 (read-only /opt at runtime,
# which is correct for a browser — Brave writes only under the user's home).
RUN rm -f /opt && mkdir -p /usr/lib/opt && ln -s usr/lib/opt /opt && ls -ld /opt

RUN curl -fsSLo /etc/yum.repos.d/brave-browser.repo \
      https://brave-browser-rpm-release.s3.brave.com/brave-browser.repo \
 && dnf install -y brave-browser \
 && dnf clean all

# ---- 2a. remote administration (sshd) ----
# The lane needs a real shell on an INSTALLED system to audit it; a serial console is
# an instrument, not an interface. sshd is installed in Kinoite but ships disabled,
# so nothing was ever listening. Enable it. There is no shipped account and no shipped
# password (DN-13), so an installed machine still refuses every remote login until the
# person who installed it creates their own user -- enabling the daemon does not open
# the machine up on its own. Production hardening (key-only, or off entirely) is a
# later decision; for the demo and for this audit it must be on.
RUN dnf install -y --setopt=install_weak_deps=False openssh-server \
 && dnf clean all \
 && systemctl enable sshd.service \
 && test -L /etc/systemd/system/multi-user.target.wants/sshd.service

# ---- 2b. identity ----
# The hostname is NOT set here. /etc/hostname is bind-mounted by podman during a build,
# so `echo sp-plus > /etc/hostname` writes to the bind mount, a build assertion reading
# it back passes, and NOTHING is committed to the image -- the installed machine still
# called itself localhost while the gate stayed green. It is set in the kickstart
# instead (network --hostname=sp-plus), which is the installer's job anyway.

# ---- 2c. trim ----
# Audited against `dnf repoquery --whatrequires` on the built image; each of these is
# required by nothing else that ships. Firefox is dead weight beside Brave (only its
# own langpacks depend on it), glibc-all-langpacks carries every locale on earth when
# one is needed, the Noto CJK faces are 116 MB of fonts this product never renders (a dry run
# confirmed they take only their three default-fonts-cjk-* metapackages with them),
# and mariadb-server is a database no SP+ component uses. Christopher explicitly
# ruled KEEP on plasma-workspace-wallpapers, java-25-openjdk-headless, ibus +
# cldr-emoji-annotation and python3-botocore -- do not add them here.
#
# FOUR CANDIDATES WERE REJECTED after checking properly, and the check that cleared
# them the first time was WRONG: `dnf repoquery --whatrequires` run on the installed
# system returned empty for every candidate, including ones with obvious dependents.
# Only a `dnf remove --assumeno` dry run against the image tells the truth.
#   podman          -- takes bootc AND rpm-ostree with it. That is the entire
#                      image-mode update path. The build caught this as
#                      "bootc: command not found" at the container lint step.
#   openblas-openmp -- takes flexiblas, opencv and SPECTACLE, which SP+ ships.
#   python3-pyside6 -- takes akonadi-server.
#   qt6-qtwebengine -- takes khelpcenter, plasma-discover and kdeplasma-addons.
# mesa-vulkan-drivers is dependency-clean but is left installed on purpose: if kwin
# were to fall back to software rendering the demo is over, and 169 MB is not worth
# that risk. Only nvidia-gpu-firmware is removed, and only because the target
# hardware has no nvidia GPU.
RUN dnf install -y --setopt=install_weak_deps=False glibc-langpack-en \
 && for p in firefox firefox-langpacks glibc-all-langpacks mariadb-server \
      google-noto-sans-cjk-vf-fonts google-noto-sans-mono-cjk-vf-fonts \
      google-noto-serif-cjk-vf-fonts \
      nvidia-gpu-firmware \
      plasma-welcome plasma-welcome-fedora; do \
      rpm -q "$p" >/dev/null 2>&1 && dnf remove -y --noautoremove "$p"; \
    done; \
    dnf clean all; \
    rpm -q glibc-langpack-en || exit 1; \
    for p in firefox glibc-all-langpacks mariadb-server nvidia-gpu-firmware \
             plasma-welcome; do \
      rpm -q "$p" && { echo "TRIM FAILED: $p still installed"; exit 1; }; \
    done; \
    rpm -qa | grep -q "google-noto.*cjk" && { echo "TRIM FAILED: CJK fonts still installed"; exit 1; }; \
    echo "TRIM_OK usr_bytes=$(du -sb /usr | cut -f1) packages=$(rpm -qa | wc -l)"

# ---- 3. the SP+ service account ----
# SP+ ships NO human account. The person installing creates their own user in the
# installer, like any other OS. A pre-populated 'advisor' account was confusing in a
# real install -- it showed up in Anaconda and on the login screen for no reason.
# The SP+ service still needs an identity, so it gets a SYSTEM account: no login
# shell, no password, UID below 1000 so it never appears on a login screen.
RUN useradd --system --home-dir /var/lib/sp-plus --shell /sbin/nologin spplus \
 && install -d -o spplus -g spplus /var/lib/sp-plus \
 && ! getent passwd advisor \
 && test "$(getent passwd spplus | cut -d: -f3)" -lt 1000

# ---- 3b. standard system groups must exist in /etc/group ----
# Runs AFTER the spplus account is created: an earlier placement asserted on a group
# that did not exist yet and failed the build with "GROUP MISSING: spplus".
# On the first boot of every SP+ install, 55 errors: "Failed to resolve group" for
# audio, disk, kvm, video, lp and tss. Those groups live only in /usr/lib/group, which
# is reachable through the altfiles NSS module, and early systemd-tmpfiles and udev
# cannot see them -- so device nodes fall back to root ownership. lp and audio decide
# whether printing and sound work. Materialise the standard groups into /etc/group,
# keeping the entries the image already added there and never duplicating a name.
RUN awk -F: 'NR==FNR{seen[$1]=1; next} !($1 in seen)' /etc/group /usr/lib/group \
      >> /etc/group.new \
 && cat /etc/group /etc/group.new > /etc/group.merged \
 && mv /etc/group.merged /etc/group \
 && rm -f /etc/group.new \
 && for g in audio disk kvm video lp tss wheel spplus; do \
      grep -q "^$g:" /etc/group || { echo "GROUP MISSING: $g"; exit 1; }; \
    done \
 && test "$(cut -d: -f1 /etc/group | sort | uniq -d | wc -l)" -eq 0 \
 && echo "GROUPS_OK count=$(grep -c . /etc/group)"


# ---- 4. the SP+ runtime ----
COPY runtime/   /usr/libexec/sp-plus/
COPY pwa/       /usr/libexec/sp-plus/pwa/
COPY knowledge/ /usr/libexec/sp-plus/knowledge/
COPY playbooks/ /usr/libexec/sp-plus/playbooks/
COPY config/sp-plus.service      /usr/lib/systemd/system/sp-plus.service
COPY config/brave-policies.json  /etc/brave/policies/managed/sp-plus.json
# Fin is the SP+ assistant. It opens as a terminal program, deliberately: the
# advisor should see the machine talking back, not a browser window.
COPY config/fin         /usr/libexec/sp-plus/fin
COPY config/fin.desktop /usr/share/applications/fin.desktop
# micro ships no launcher of its own -- it is a terminal editor. On a machine built
# for people who have never used Linux, an application with no way to open it does
# not exist. Give it one, named for what it does rather than what it is called.
COPY config/micro.desktop /usr/share/applications/micro.desktop
# DN-17: the first-boot password helper used to be written by the kickstart %post
# into /usr/libexec. On a bootc system /usr is image content, so %post could not
# create it and the installed machine had NO unit at all — not a failed one, an
# absent one (cycle10 boot log: zero mentions of spplus-firstboot). It is image
# content now, and %post only writes the enable symlink under /etc.
COPY config/spplus-relabel                   /usr/libexec/spplus-relabel
COPY config/spplus-relabel.service           /usr/lib/systemd/system/spplus-relabel.service

RUN chmod 0755 /usr/libexec/sp-plus/spplus_rpc.py \
 && sha256sum /usr/libexec/sp-plus/playbooks/printer-reconnect.json \
    | awk '{print $1}' > /usr/libexec/sp-plus/playbooks/printer-reconnect.json.sha256 \
 && systemctl enable sp-plus.service \
 && systemctl enable cups.service \
 && systemctl enable firewalld.service \
 && chmod 0755 /usr/libexec/sp-plus/fin \
 && python3 -m py_compile /usr/libexec/sp-plus/fin \
 && chmod 0644 /usr/share/applications/fin.desktop \
 && desktop-file-validate /usr/share/applications/fin.desktop \
 && desktop-file-validate /usr/share/applications/micro.desktop \
 && test -x /usr/bin/kitty \
 && grep -q "kitty" /usr/share/applications/fin.desktop \
 && chmod 0750 /usr/libexec/spplus-relabel \
 && bash -n /usr/libexec/spplus-relabel \
 && systemctl enable spplus-relabel.service \
 && test -L /etc/systemd/system/sysinit.target.wants/spplus-relabel.service

# The display manager is Kinoite 44's own plasmalogin (plasma-login-manager), which
# already owns /etc/systemd/system/display-manager.service. sddm is installed and its
# unit file ships, but enabling it here fails outright:
#   Failed to enable unit: File '/etc/systemd/system/display-manager.service' already
#   exists and is a symlink to /usr/lib/systemd/system/plasmalogin.service
# Taking the distro default is the low-risk choice before a live demo. Revisit only if
# plasmalogin turns out not to start.
RUN systemctl set-default graphical.target \
 && test -L /etc/systemd/system/display-manager.service

# ---- 5. branding (DN-19) ----
COPY branding/ /usr/share/sp-plus/branding/
RUN install -Dm644 /usr/share/sp-plus/branding/fin-icon.svg \
      /usr/share/icons/hicolor/scalable/apps/fin.svg \
 && install -Dm644 /usr/share/sp-plus/branding/fin-icon-256.png \
      /usr/share/icons/hicolor/256x256/apps/fin.png \
 && install -Dm644 /usr/share/sp-plus/branding/fin-icon-512.png \
      /usr/share/icons/hicolor/512x512/apps/fin.png

# os-release: ID_LIKE=fedora is deliberate, tooling depends on it.
RUN printf '%s\n' \
      'NAME="SP+"' \
      'VERSION="1.0"' \
      'ID=sp-plus' \
      'ID_LIKE=fedora' \
      'VERSION_ID=1.0' \
      'PRETTY_NAME="SP+ 1.0"' \
      'VARIANT="Advisor"' \
      'VARIANT_ID=advisor' \
      'ANSI_COLOR="0;38;2;180;180;190"' \
      'LOGO=sp-plus-logo-icon' \
      'HOME_URL="https://secureprospective.com/"' \
      'SUPPORT_URL="https://secureprospective.com/support"' \
      'BUG_REPORT_URL="https://secureprospective.com/support"' \
      > /usr/lib/os-release \
 && ln -sf ../usr/lib/os-release /etc/os-release \
 && printf '%s\n' '\S' 'Kernel \r on an \m (\l)' '' > /etc/issue \
 && printf '%s\n' '\S' 'Kernel \r on an \m (\l)' '' > /etc/issue.net

# The SP+ mark, under the name LOGO= points at, plus every visible Fedora logo
# surface. The surfaces are ENUMERATED from the rpm database, not guessed:
# fedora-logos owns them and `rpm -V` is what the gate reads back.
# Do NOT `rpm -e fedora-logos` — half the desktop depends on it.
RUN set -eux; \
    ICON=/usr/share/sp-plus/branding/sp-plus-icon-512.png; \
    B64=$(base64 -w0 "$ICON"); \
    mksvg() { printf '%s\n' \
      '<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="512" height="512" viewBox="0 0 512 512">' \
      "<image width=\"512\" height=\"512\" xlink:href=\"data:image/png;base64,${B64}\"/>" \
      '</svg>' > "$1"; }; \
    for d in scalable 256x256 512x512; do \
      install -d "/usr/share/icons/hicolor/$d/apps" "/usr/share/icons/hicolor/$d/places"; \
    done; \
    mksvg /usr/share/icons/hicolor/scalable/apps/sp-plus-logo-icon.svg; \
    cp "$ICON" /usr/share/icons/hicolor/256x256/apps/sp-plus-logo-icon.png; \
    cp "$ICON" /usr/share/icons/hicolor/512x512/apps/sp-plus-logo-icon.png; \
    install -d /usr/share/pixmaps; \
    cp "$ICON" /usr/share/pixmaps/sp-plus-logo-icon.png; \
    if rpm -q fedora-logos >/dev/null 2>&1; then \
      rpm -ql fedora-logos \
        | grep -E '/(plymouth|sddm|pixmaps|anaconda)/|icons/hicolor/(scalable|256x256|512x512)/' \
        | while read -r f; do \
            [ -f "$f" ] || continue; \
            rm -f "$f"; \
            case "$f" in \
              *.svg) mksvg "$f" ;; \
              *)     cp -f "$ICON" "$f" ;; \
            esac; \
          done; \
    fi; \
    gtk-update-icon-cache -f /usr/share/icons/hicolor || true

# Plymouth: the boot splash is the first SP+ surface an advisor ever sees.
# The initramfs must be rebuilt afterwards or the stock splash stays baked in.
RUN set -eux; \
    install -d /usr/share/plymouth/themes/sp-plus; \
    cp /usr/share/sp-plus/branding/sp-plus-splash.png \
       /usr/share/plymouth/themes/sp-plus/splash.png; \
    printf '%s\n' \
      '[Plymouth Theme]' \
      'Name=SP+' \
      'Description=SP+ boot splash' \
      'ModuleName=script' \
      '' \
      '[script]' \
      'ImageDir=/usr/share/plymouth/themes/sp-plus' \
      'ScriptFile=/usr/share/plymouth/themes/sp-plus/sp-plus.script' \
      > /usr/share/plymouth/themes/sp-plus/sp-plus.plymouth; \
    printf '%s\n' \
      'splash.image = Image("splash.png");' \
      'screen_w = Window.GetWidth(); screen_h = Window.GetHeight();' \
      'scale = 0.5 * screen_w / splash.image.GetWidth();' \
      'scaled = splash.image.Scale(splash.image.GetWidth() * scale, splash.image.GetHeight() * scale);' \
      'sprite = Sprite(scaled);' \
      'sprite.SetX((screen_w - scaled.GetWidth()) / 2);' \
      'sprite.SetY((screen_h - scaled.GetHeight()) / 2);' \
      'fun refresh_callback() { sprite.SetOpacity(1); }' \
      'Plymouth.SetRefreshFunction(refresh_callback);' \
      '' \
      '# DN-15: WITHOUT THIS THE MACHINE LOOKS DEAD AT THE PASSPHRASE PROMPT.' \
      '# systemd asks plymouth to collect the LUKS passphrase; a theme with no' \
      '# display-password function draws NOTHING, so the user sees a splash or a' \
      '# black screen and no reason to type. Never remove these callbacks.' \
      'prompt_label = Sprite();' \
      'prompt_dots  = Sprite();' \
      'fun display_password_callback(prompt, bullets) {' \
      '  text = Image.Text("Enter your passphrase to unlock this computer", 1, 1, 1);' \
      '  prompt_label.SetImage(text);' \
      '  prompt_label.SetX((screen_w - text.GetWidth()) / 2);' \
      '  prompt_label.SetY(screen_h * 0.72);' \
      '  prompt_label.SetOpacity(1);' \
      '  dots = "";' \
      '  i = 0;' \
      '  while (i < bullets) { dots = dots + "*"; i = i + 1; }' \
      '  if (dots == "") { dots = " "; }' \
      '  dotimg = Image.Text(dots, 1, 1, 1);' \
      '  prompt_dots.SetImage(dotimg);' \
      '  prompt_dots.SetX((screen_w - dotimg.GetWidth()) / 2);' \
      '  prompt_dots.SetY(screen_h * 0.78);' \
      '  prompt_dots.SetOpacity(1);' \
      '}' \
      'Plymouth.SetDisplayPasswordFunction(display_password_callback);' \
      'fun display_normal_callback() {' \
      '  prompt_label.SetOpacity(0);' \
      '  prompt_dots.SetOpacity(0);' \
      '}' \
      'Plymouth.SetDisplayNormalFunction(display_normal_callback);' \
      'fun display_message_callback(text) {' \
      '  msg = Image.Text(text, 1, 1, 1);' \
      '  prompt_label.SetImage(msg);' \
      '  prompt_label.SetX((screen_w - msg.GetWidth()) / 2);' \
      '  prompt_label.SetY(screen_h * 0.72);' \
      '  prompt_label.SetOpacity(1);' \
      '}' \
      'Plymouth.SetMessageFunction(display_message_callback);' \
      > /usr/share/plymouth/themes/sp-plus/sp-plus.script; \
    ln -sf sp-plus/sp-plus.plymouth /usr/share/plymouth/themes/default.plymouth; \
    # The symlink alone is NOT enough, and this is the second half of DN-15. dracut's
    # plymouth module asks plymouth's OWN tooling which theme is default, and that
    # reads /etc/plymouth/plymouthd.conf -- which still said bgrt. So dracut shipped
    # bgrt's plugin (two-step.so) and left script.so out, and the initramfs had a
    # script theme with no interpreter. Set the theme the supported way so the
    # tooling agrees with the symlink, and assert it before dracut runs.
    plymouth-set-default-theme sp-plus; \
    test "$(plymouth-set-default-theme)" = "sp-plus"; \
    grep -rlis fedora /usr/share/plymouth/themes/*/*.plymouth 2>/dev/null \
      | while read -r t; do sed -i 's/[Ff]edora/SP+/g' "$t"; done; \
    kernel=$(ls -1 /usr/lib/modules | head -1); \
    # DN-15: the LUKS prompt must be VISIBLE on the local panel. plymouth can only
    # draw where a KMS driver exists. i915 covers the Dell; the VM emulates a plain
    # VGA whose driver (bochs_drm) dracut does not pull in, so the test lane was
    # showing a black screen that the real hardware may not show. Ship the common
    # panel drivers so the lane is representative and odd hardware still lights up.
    DRACUT_NO_XATTR=1 dracut --force --no-hostonly --add ostree \
      --add-drivers "bochs_drm virtio_gpu qxl cirrus i915 simpledrm" \
      "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}"; \
    # A rebuilt initramfs WITHOUT the ostree dracut module unlocks LUKS, then dies on
    # "[FAILED] Failed to start initrd-switch-root.service" and drops to emergency.
    # cycle8 proved that. dracut does not pull 50ostree in automatically here, so it
    # is requested explicitly and asserted — never let this regress silently.
    lsinitrd "/usr/lib/modules/${kernel}/initramfs.img" | grep -q ostree; \
    # DN-15 regression guard: a splash that cannot ask for the passphrase is a
    # machine that looks bricked to its owner.
    grep -q 'SetDisplayPasswordFunction' /usr/share/plymouth/themes/sp-plus/sp-plus.script; \
    # DN-15 ROOT CAUSE. The SP+ theme declares ModuleName=script, and the plugin that
    # interprets a script theme is script.so from plymouth-plugin-script. That package
    # was never installed, so /usr/lib64/plymouth/ held details/text/two-step and NO
    # script.so at all. plymouth loaded the theme, found no interpreter, and drew
    # NOTHING -- which is why the LUKS panel was blank, why adding KMS drivers changed
    # nothing, and why adding the password callback changed nothing: the script was
    # never executed. Assert the plugin exists AND that dracut put it in the initramfs,
    # because only the initramfs copy is present when the passphrase is asked for.
    test -e /usr/lib64/plymouth/script.so; \
    lsinitrd "/usr/lib/modules/${kernel}/initramfs.img" | grep -q 'plymouth/script\.so'; \
    lsinitrd "/usr/lib/modules/${kernel}/initramfs.img" | grep -q 'themes/sp-plus/sp-plus.script'; \
    echo "DN15_PLUGIN_OK script.so present on disk and in the initramfs"

# ---- 5b. startup debloat: a productivity laptop, not a server ----
# Measured on the installed cycle20 system: 89 enabled units, and an idle machine
# already holding 2.1 GB before anyone logs in. Everything disabled here is either for
# hardware this product does not have or background work that costs a 12-year-old
# spinning disk real time. DELIBERATELY NOT TOUCHED: sssd and systemd-homed, because
# both sit in the authentication path and DN-16 cost a day; avahi, because network
# printer discovery is the demo; thermald, tuned and smartd, because this is an old
# laptop with an old drive; systemd-oomd, because it keeps a small machine alive.
RUN for u in vboxservice.service vgauthd.service vmtoolsd.service \
             mdmonitor.service raid-check.timer mcelog.service \
             ModemManager.service \
             dnf-makecache.timer rpm-ostree-countme.timer \
             fedora-third-party-refresh.service \
             fedora-atomic-desktop-appstream-cache-refresh.service \
             fedora-atomic-desktop-mandb-update.service; do \
      systemctl disable "$u" 2>/dev/null || true; \
    done; \
    for u in sshd.service sp-plus.service cups.service firewalld.service \
             plasmalogin.service spplus-relabel.service; do \
      systemctl is-enabled "$u" >/dev/null 2>&1 || { echo "DEBLOAT BROKE $u"; exit 1; }; \
    done; \
    echo "DEBLOAT_OK enabled_units=$(systemctl list-unit-files --state=enabled --no-legend | grep -c .)"

# ---- 5c. autostart debloat ----
# 22 XDG autostart entries fired for every session. baloo_file is the expensive one:
# a filesystem indexer on a spinning SATA disk is felt continuously. The rest are for
# phones, screen readers, geolocation and other vendors' virtual machines. KEPT:
# plasmashell, kwin, powerdevil, the polkit agent, kwallet, blueman and xdg-user-dirs.
RUN for f in baloo_file org.kde.kdeconnect.daemon org.kde.discover.notifier \
             orca-autostart geoclue-demo-agent org.kde.kunifiedpush-distributor \
             org.kde.xwaylandvideobridge vboxclient vmware-user spice-vdagent; do \
      rm -f "/etc/xdg/autostart/$f.desktop"; \
    done; \
    test -e /etc/xdg/autostart/org.kde.plasmashell.desktop; \
    test -e /etc/xdg/autostart/powerdevil.desktop; \
    test -e /etc/xdg/autostart/polkit-kde-authentication-agent-1.desktop; \
    test ! -e /etc/xdg/autostart/baloo_file.desktop; \
    echo "AUTOSTART_OK count=$(ls /etc/xdg/autostart/ | wc -l)"

# ---- 6. the SP+ Windows 11 global theme (advisors come from Windows) ----
# Vendored, audited subset of KDE-Windows-Modern (GPL-3.0-only, upstream author
# Jeysef; LICENSE and ATTRIBUTION ship alongside it under /usr/share/sp-plus/theme).
# Deliberately NOT shipped: the upstream C++ System Tray and Icon Tasks applets, the
# patched login manager and the lock-screen shell overlay — they fork core Plasma and
# break at every update. The layout uses native Plasma applets instead, and no
# Microsoft artwork ships: the wallpaper is SP+'s own.
COPY theme/look-and-feel/  /usr/share/plasma/look-and-feel/
COPY theme/desktoptheme/   /usr/share/plasma/desktoptheme/
COPY theme/color-schemes/  /usr/share/color-schemes/
COPY theme/aurorae/        /usr/share/aurorae/themes/
COPY theme/icons/          /usr/share/icons/
COPY theme/Kvantum/        /usr/share/Kvantum/
COPY theme/LICENSE-Windows-Modern-GPL3 theme/ATTRIBUTION-Windows-Modern.md /usr/share/sp-plus/theme/

# kvantum supplies the widget style the theme's defaults select. Without it Qt apps
# fall back and the theme looks half-applied in System Settings.
RUN dnf install -y --setopt=install_weak_deps=False kvantum \
 && dnf clean all \
 && gtk-update-icon-cache -f /usr/share/icons/windows-modern || true

# Make SP+ Windows 11 (Dark) the shipped default look, system-wide rather than in
# /home, so a fresh advisor account gets it on first login (decision D25).
RUN printf '%s\n' \
      '[General]' \
      'ColorScheme=WindowsModernDark' \
      'TerminalApplication=kitty' \
      'LookAndFeelPackage=org.secureprospective.spplus.windows11.dark' \
      '' \
      '[Icons]' \
      'Theme=windows-modern' \
      '' \
      '[KDE]' \
      'widgetStyle=kvantum-dark' \
      'LookAndFeelPackage=org.secureprospective.spplus.windows11.dark' \
      > /etc/xdg/kdeglobals \
 && printf '%s\n' \
      '[Theme]' \
      'name=Windows-modern-dark' \
      > /etc/xdg/plasmarc \
 && printf '%s\n' \
      '[org.kde.kdecoration2]' \
      'library=org.kde.kwin.aurorae' \
      'theme=__aurorae__svg__windows-modern-dark-aurorae' \
      '' \
      '# SP+ ships on laptops with real keys. kwin otherwise launches' \
      '# plasma-keyboard -- the ONSCREEN keyboard -- because its desktop file' \
      '# carries X-KDE-Wayland-VirtualKeyboard=true. Measured on the cycle20' \
      '# guest it cost 266 MB resident for something no advisor will ever tap.' \
      '# An empty InputMethod stops kwin selecting one. The PACKAGE is left' \
      '# installed on purpose: dnf remove --assumeno showed it takes' \
      '# plasma-desktop, plasma-workspace, plasma-setup and sddm with it.' \
      '[Wayland]' \
      'InputMethod=' \
      'VirtualKeyboardEnabled=false' \
      > /etc/xdg/kwinrc \
 && test -d /usr/share/plasma/look-and-feel/org.secureprospective.spplus.windows11.dark \
 && test -f /usr/share/color-schemes/WindowsModernDark.colors \
 && test -d /usr/share/aurorae/themes/windows-modern-dark-aurorae

# ---- 7. DN-17: the first screen an advisor ever sees ----
# plasma-setup is the account-creation wizard, and with DN-13 (no pre-created
# account) it is the FIRST thing anyone sees after installing. Stock, its headline
# reads "Welcome to Plasma Desktop" -- it names KDE, not SP+, to a user who has
# never heard of either. That headline is compiled into plasma-setup's QML
# resources; there is no config key for it. The supported override is the gettext
# catalog: the installed system runs LANG="en_US.UTF-8" (Anaconda writes
# /etc/locale.conf) and upstream ships no en_US catalog, so ours is loaded.
# Only the strings that name Plasma to the user are rebranded.
#
# plasma-setup itself is NOT removed and must never be: it is the only path by
# which the advisor's account comes into existence. Its sibling plasma-welcome
# (the "tour Plasma" app) IS removed in the trim above -- a product tour of KDE is
# the wrong second screen for SP+.
COPY branding/locale/org.kde.plasmasetup.mo \
     /usr/share/locale/en_US/LC_MESSAGES/org.kde.plasmasetup.mo
RUN test -s /usr/share/locale/en_US/LC_MESSAGES/org.kde.plasmasetup.mo \
 && grep -q 'Welcome to<br/><b>SP+</b>' \
      /usr/share/locale/en_US/LC_MESSAGES/org.kde.plasmasetup.mo \
 && grep -q 'Plasma Desktop' \
      /usr/share/locale/en_US/LC_MESSAGES/org.kde.plasmasetup.mo \
 && test -x /usr/libexec/plasma-setup \
 && systemctl is-enabled plasma-setup.service \
 && echo "DN17_BRANDING_OK en_US catalog installed, plasma-setup still enabled"

# ---- 8. operations tuning for a spinning disk ----
# SP+ is demoed and deployed on an old laptop: 8 GB of RAM, zram swap, and a
# rotational SATA drive. Two things follow, and only one of them needs changing.
#
# The I/O scheduler needs NOTHING: udev's 60-block-scheduler.rules already
# selects bfq for rotational devices, verified on the cycle20 guest
# ("sda rot=1 sched=none mq-deadline kyber [bfq]"). Do not "fix" it.
#
# vm.swappiness does need changing. The stock 60 is tuned for swap on a disk.
# Here swap is zram -- compressed pages in RAM -- while the filesystem is on
# rust, so swapping is orders of magnitude CHEAPER than dropping page cache and
# re-reading it from the platter. The established value for in-memory swap
# backed by an HDD is ~180 (Pop!_OS default; ArchWiki advises >100 for zram).
# This is a community-established tuning, not a Fedora default.
RUN printf '%s\n' \
      '# SP+: swap is zram, the filesystem is on a spinning disk.' \
      '# Prefer compressing cold pages in RAM over re-reading from the platter.' \
      'vm.swappiness = 180' \
      > /usr/lib/sysctl.d/60-sp-plus-zram.conf \
 && test -s /usr/lib/sysctl.d/60-sp-plus-zram.conf \
 && grep -q '^vm.swappiness = 180$' /usr/lib/sysctl.d/60-sp-plus-zram.conf \
 && echo "TUNING_OK vm.swappiness=180 for zram over rotational storage"

# ---- 9. the application menu an advisor actually opens ----
# Stock, the menu offers 44 entries. An advisor who has never used Linux should
# not be handed a partition editor, three KDE Connect entries, a coredump
# browser and two of everything. Each entry below is hidden with NoDisplay,
# NOT removed: the binaries stay, anything that launches them still works, and
# the choice is one config line to reverse. Removing the packages instead is how
# cycle23 lost bootc.
#
# Four groups, and the reason matters more than the list:
#   dangerous   -- partitionmanager can wipe the disk from a menu click
#   diagnostic  -- kdebugsettings, journald, coredumps, infocenter, menu editor,
#                  filelight: real tools, meaningless to the audience
#   duplicate   -- kdesystemsettings (systemsettings ships too), blueman x2
#                  (System Settings owns Bluetooth), konsole (kitty is the SP+
#                  terminal and Fin opens in it), kate (kwrite + micro ship),
#                  kfind (Dolphin searches), kwalletmanager (KeePassXC is the
#                  shipped password manager)
#   confusing   -- kdeconnect x3 (phone pairing; its daemon is already off),
#                  krfb (remote desktop, a security surface), kvantummanager
#                  (theme internals -- it can break the SP+ look), kcharselect,
#                  emojier
#
# Deliberately LEFT VISIBLE and not up for quiet removal: Brave, Thunderbird,
# LibreOffice Writer/Calc, Okular, Gwenview, Dolphin, KCalc, KeePassXC, Fin,
# kitty, System Settings, System Monitor, Firewall, Discover, Print Settings,
# Spectacle, Flameshot, KWrite, micro, Ark, Help Center.
RUN for d in org.kde.partitionmanager \
             org.kde.kdebugsettings org.kde.kjournaldbrowser \
             org.kde.drkonqi.coredump.gui org.kde.kinfocenter \
             org.kde.kmenuedit org.kde.filelight \
             kdesystemsettings blueman-adapters blueman-manager \
             org.kde.konsole org.kde.kate org.kde.kfind org.kde.kwalletmanager \
             org.kde.kdeconnect.app org.kde.kdeconnect.nonplasma \
             org.kde.kdeconnect.sms org.kde.krfb kvantummanager \
             org.kde.kcharselect org.kde.plasma.emojier; do \
      f="/usr/share/applications/$d.desktop"; \
      [ -e "$f" ] || continue; \
      desktop-file-edit --set-key=NoDisplay --set-value=true "$f" \
        || { echo "MENU FAILED to hide $d"; exit 1; }; \
    done; \
    for d in org.kde.partitionmanager org.kde.konsole org.kde.kdeconnect.app; do \
      grep -q '^NoDisplay=true' "/usr/share/applications/$d.desktop" \
        || { echo "MENU FAILED: $d still visible"; exit 1; }; \
    done; \
    for d in brave-browser net.thunderbird.Thunderbird libreoffice-writer \
             libreoffice-calc org.kde.dolphin org.kde.okular org.kde.kcalc \
             org.keepassxc.KeePassXC fin kitty systemsettings \
             org.kde.plasma-systemmonitor org.kde.discover; do \
      f="/usr/share/applications/$d.desktop"; \
      test -e "$f" || { echo "MENU FAILED: keeper $d is missing"; exit 1; }; \
      grep -q '^NoDisplay=true' "$f" \
        && { echo "MENU FAILED: keeper $d got hidden"; exit 1; }; \
    done; \
    vis=$(for f in /usr/share/applications/*.desktop; do \
            grep -q '^NoDisplay=true' "$f" && continue; \
            grep -q '^Hidden=true' "$f" && continue; \
            grep -q '^Exec=' "$f" && echo x; \
          done | grep -c .); \
    echo "MENU_OK visible_entries=$vis"

# ---- 10. DN-15: give plymouth a reason to take over the panel ----
# The real cause of the black screen at the LUKS passphrase prompt, found on the
# cycle24 panel strip. Frames f11-f22 -- twenty-four seconds while the passphrase
# was being asked -- showed GRUB's plain "Booting a command list" text on a VGA
# console. Plymouth had not taken over the panel AT ALL. So this was never the
# theme or the script plugin: those were necessary, and they are correct now, but
# they were never sufficient.
#
# The installed kernel command line, read back off the cycle24 serial, is:
#   ... ostree=/ostree/boot.1/default/<sha>/0 console=ttyS0,115200
# There is no rhgb. Without it plymouth does not take the panel, so the advisor
# is asked for a passphrase by a machine that looks switched off.
#
# bootc owns the installed kargs, so set them the image-mode-native way rather
# than in the kickstart -- this way they survive `bootc upgrade` too. The final
# `bootc container lint` in this file validates the syntax of this directory.
RUN printf '%s\n' \
      '# SP+ DN-15: without rhgb, plymouth never takes the panel and the LUKS' \
      '# passphrase prompt is invisible -- the machine looks dead. quiet keeps' \
      '# the kernel log off the splash so the advisor sees the prompt, not scroll.' \
      'kargs = ["rhgb", "quiet"]' \
      > /usr/lib/bootc/kargs.d/10-sp-plus-splash.toml \
 && grep -q 'kargs = \["rhgb", "quiet"\]' \
      /usr/lib/bootc/kargs.d/10-sp-plus-splash.toml \
 && echo "DN15_KARGS_OK rhgb quiet staged for the installed cmdline"

# ---- 11. default applications that actually exist ----
# Measured, not assumed. Resolving each type in XDG order against the real image
# BEFORE this layer gave:
#   x-scheme-handler/https  -> org.kde.falkon.desktop   exists=False
#   x-scheme-handler/mailto -> org.kde.kmail2.desktop   exists=False
#   text/plain              -> org.kde.kate.desktop     exists=True
#   inode/directory, application/pdf, image/png         exists=True
#
# So the real breakage is narrower than Fedora's GNOME-era
# /usr/share/applications/mimeapps.list first suggests: that file does point at
# firefox, gedit, Nautilus, Evince and eog, none of which ship here, but KDE's
# kde-mimeapps.list sits above it and already answers folders, PDFs and images
# correctly. What is genuinely broken is the two that matter most on a demo --
# CLICKING A WEB LINK and CLICKING A MAILTO both resolve to programs that do not
# exist, so nothing happens at all.
#
# text/plain is remapped too, for a different reason: Kate exists but is the
# developer editor, and this file hides it from the menu. Opening a .txt should
# land in KWrite, which the advisor can actually find again.
#
# Fixed at the sysadmin level. Per the XDG association spec the lookup order is
# $XDG_CONFIG_DIRS/<desktop>-mimeapps.list, then $XDG_CONFIG_DIRS/mimeapps.list,
# and only then the $XDG_DATA_DIRS copies -- so /etc/xdg/kde-mimeapps.list wins
# inside the Plasma session and /etc/xdg/mimeapps.list covers everything else.
# Both are written, with identical content, so neither path can fall through to
# the broken lists. The vendor files in /usr/share are left untouched.
RUN printf '%s\n' \
      '[Default Applications]' \
      'x-scheme-handler/http=brave-browser.desktop' \
      'x-scheme-handler/https=brave-browser.desktop' \
      'x-scheme-handler/about=brave-browser.desktop' \
      'x-scheme-handler/unknown=brave-browser.desktop' \
      'text/html=brave-browser.desktop' \
      'application/xhtml+xml=brave-browser.desktop' \
      'x-scheme-handler/mailto=net.thunderbird.Thunderbird.desktop' \
      'message/rfc822=net.thunderbird.Thunderbird.desktop' \
      'text/plain=org.kde.kwrite.desktop' \
      'inode/directory=org.kde.dolphin.desktop' \
      'application/pdf=okularApplication_pdf.desktop' \
      'image/png=org.kde.gwenview.desktop' \
      'image/jpeg=org.kde.gwenview.desktop' \
      'image/gif=org.kde.gwenview.desktop' \
      'image/webp=org.kde.gwenview.desktop' \
      'image/svg+xml=org.kde.gwenview.desktop' \
      > /etc/xdg/mimeapps.list \
 && cp /etc/xdg/mimeapps.list /etc/xdg/kde-mimeapps.list \
 && for f in /etc/xdg/mimeapps.list /etc/xdg/kde-mimeapps.list; do \
      grep -q '^x-scheme-handler/https=brave-browser.desktop$' "$f" \
        || { echo "MIME FAILED: https not mapped in $f"; exit 1; }; \
    done \
 && for d in brave-browser net.thunderbird.Thunderbird org.kde.kwrite \
             org.kde.dolphin okularApplication_pdf org.kde.gwenview; do \
      test -e "/usr/share/applications/$d.desktop" \
        || { echo "MIME FAILED: handler $d does not exist"; exit 1; }; \
    done \
 && grep -q '^TerminalApplication=kitty$' /etc/xdg/kdeglobals \
 && test -x /usr/bin/kitty \
 && echo "MIME_OK defaults point at applications that exist"

# ---- 12. Brave's first run, on a financial advisor's machine ----
# Clicking the browser must land on a web page, not on onboarding. Stock Brave
# opens a welcome flow, nags to become the default browser, offers to save
# passwords in competition with the KeePassXC we ship, and surfaces Rewards,
# Wallet and VPN -- crypto promotion is the wrong thing to put in front of an
# advisor's clients. Brave reads Chromium enterprise policy from
# /etc/brave/policies/managed, which the package already creates.
#
# Caveat recorded honestly: brave-browser issue #45106 reports Rewards, Wallet
# and AI Chat still appearing despite policy on some builds. Treat this as
# best-effort suppression, NOT as a guarantee, and check brave://policy on the
# demo machine before standing in front of anyone.
RUN printf '%s\n' \
      '{' \
      '  "BraveRewardsDisabled": true,' \
      '  "BraveWalletDisabled": true,' \
      '  "BraveVPNDisabled": true,' \
      '  "BraveAIChatEnabled": false,' \
      '  "BraveNewsDisabled": true,' \
      '  "BraveTalkDisabled": true,' \
      '  "TorDisabled": true,' \
      '  "BraveP3AEnabled": false,' \
      '  "BraveStatsPingEnabled": false,' \
      '  "BraveWebDiscoveryEnabled": false,' \
      '  "MetricsReportingEnabled": false,' \
      '  "PromotionalTabsEnabled": false,' \
      '  "DefaultBrowserSettingEnabled": false,' \
      '  "PasswordManagerEnabled": false,' \
      '  "AutofillCreditCardEnabled": false,' \
      '  "BookmarkBarEnabled": true' \
      '}' \
      > /etc/brave/policies/managed/sp-plus.json \
 && python3 -c "import json,sys; d=json.load(open('/etc/brave/policies/managed/sp-plus.json')); sys.exit(0 if d['BraveRewardsDisabled'] and d['PromotionalTabsEnabled'] is False else 1)" \
 && echo "BRAVE_POLICY_OK $(python3 -c "import json; print(len(json.load(open('/etc/brave/policies/managed/sp-plus.json'))))") policies, valid JSON"

ENV SPPLUS_ROOT=/usr/libexec/sp-plus
ENV SPPLUS_PRINTER_FIXTURE=1
ENV SPPLUS_LISTEN_ADDRESS=127.0.0.1
ENV SPPLUS_LISTEN_PORT=8765

LABEL org.opencontainers.image.title="SP+" \
      org.opencontainers.image.description="SP+ Advisor OS — KDE image-mode payload" \
      org.opencontainers.image.version="1.0"

RUN bootc container lint
