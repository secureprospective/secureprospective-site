{
  "comment": "Maps OBS scene names onto overlay packs and gives each its field weight. The lattice already draws itself at low alpha; opacity here is a further multiplier for compositing. RIG runs faintest because the guest's screen is the content there.",
  "sceneMap": {
    "00 HOLD": "HOLD",
    "01 TALK": "TALK",
    "02 RIG": "RIG",
    "03 OUTRO": "OUTRO",
    "04 SLATE": "SLATE",
    "05 BRB": "BRB",
    "06 TALK+RIG": "TALKRIG",
    "07 TECHNICAL": "TECH"
  },
  "field": {
    "HOLD": {
      "hz": 30,
      "opacity": 1.0
    },
    "TALK": {
      "hz": 30,
      "opacity": 1.0
    },
    "RIG": {
      "hz": 20,
      "opacity": 0.34
    },
    "TALKRIG": {
      "hz": 20,
      "opacity": 0.34
    },
    "SLATE": {
      "hz": 30,
      "opacity": 0.9
    },
    "BRB": {
      "hz": 30,
      "opacity": 1.0
    },
    "TECH": {
      "hz": 20,
      "opacity": 0.8
    },
    "OUTRO": {
      "hz": 30,
      "opacity": 1.0
    }
  },
  "fieldDefault": {
    "hz": 20,
    "opacity": 0.8
  }
}