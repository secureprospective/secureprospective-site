{
  "comment": "Maps OBS scene names onto overlay packs, and gives each pack its field weight. The ticker already draws itself at 0.1-0.4 alpha internally, as on the site; these are a further multiplier for compositing over video. They are higher than the site's because the site's field sits on silver and the stream's sits on ink or on the guest's screen.",
  "sceneMap": {
    "00 HOLD": "HOLD",
    "01 TALK": "TALK",
    "02 RIG": "RIG",
    "03 OUTRO": "OUTRO",
    "04 SLATE": "SLATE",
    "05 BRB": "BRB",
    "06 TALK+RIG": "TALKRIG",
    "07 TECHNICAL": "TECH"
  },
  "field": {
    "HOLD": {
      "hz": 15,
      "opacity": 0.5,
      "tone": "dark"
    },
    "TALK": {
      "hz": 15,
      "opacity": 0.5,
      "tone": "dark"
    },
    "RIG": {
      "hz": 10,
      "opacity": 0.22,
      "tone": "dark"
    },
    "TALKRIG": {
      "hz": 10,
      "opacity": 0.22,
      "tone": "dark"
    },
    "SLATE": {
      "hz": 15,
      "opacity": 0.4,
      "tone": "dark"
    },
    "BRB": {
      "hz": 15,
      "opacity": 0.5,
      "tone": "dark"
    },
    "TECH": {
      "hz": 10,
      "opacity": 0.7,
      "tone": "light"
    },
    "OUTRO": {
      "hz": 15,
      "opacity": 0.5,
      "tone": "dark"
    }
  },
  "fieldDefault": {
    "hz": 10,
    "opacity": 0.4,
    "tone": "dark"
  }
}