# SP+ Calm Light Plasma 6 defaults. Keep this package source-of-truth immutable.
[kdeglobals][General]
ColorScheme=SPPlusCalmLight
font=Noto Sans,10,-1,5,50,0,0,0,0,0
menuFont=Noto Sans,10,-1,5,50,0,0,0,0,0
toolBarFont=Noto Sans,10,-1,5,50,0,0,0,0,0
activeFont=Noto Sans,10,-1,5,50,0,0,0,0,0
smallestReadableFont=Noto Sans,9,-1,5,50,0,0,0,0,0

[kdeglobals][Icons]
Theme=Paper-Mono-Dark

[kdeglobals][KDE]
widgetStyle=Breeze

[plasmarc][Theme]
name=spplus-calm-light

[Wallpaper]
