FROM quay.io/fedora/fedora-bootc:43

ARG POC_LOGIN_VALUE=advisor-poc

RUN dnf -y update && dnf -y install \
    @kde-desktop \
    sddm \
    cups \
    cups-filters \
    cups-pk-helper \
    firewalld \
    NetworkManager-wifi \
    bluez \
    blueman \
    pipewire \
    wireplumber \
    xdg-desktop-portal-kde \
    udisks2 \
    python3 \
    curl \
    ca-certificates \
    jq \
    sudo \
    && dnf clean all

RUN curl -fsSLo /etc/yum.repos.d/brave-browser.repo \
      https://brave-browser-rpm-release.s3.brave.com/brave-browser.repo \
    && dnf -y install brave-browser \
    && dnf clean all

RUN useradd --create-home --groups wheel --shell /bin/bash advisor \
    && echo "advisor:${POC_LOGIN_VALUE}" | chpasswd \
    && install -d -o advisor -g advisor /var/lib/sp-plus

COPY runtime/ /usr/libexec/sp-plus/
COPY knowledge/ /usr/libexec/sp-plus/knowledge/
COPY playbooks/ /usr/libexec/sp-plus/playbooks/
COPY config/sp-plus.service /usr/lib/systemd/system/sp-plus.service
COPY config/brave-policies.json /etc/brave/policies/managed/sp-plus.json

RUN chmod 0755 /usr/libexec/sp-plus/spplus_rpc.py \
    && sha256sum /usr/libexec/sp-plus/playbooks/printer-reconnect.json \
       | awk '{print $1}' > /usr/libexec/sp-plus/playbooks/printer-reconnect.json.sha256 \
    && systemctl enable sp-plus.service \
    && systemctl enable sddm.service \
    && systemctl enable cups.service \
    && systemctl enable firewalld.service

ENV SPPLUS_ROOT=/usr/libexec/sp-plus
ENV SPPLUS_PRINTER_FIXTURE=1
ENV SPPLUS_LISTEN_ADDRESS=127.0.0.1
ENV SPPLUS_LISTEN_PORT=8765

LABEL org.opencontainers.image.title="SP+ POC" \
      org.opencontainers.image.description="KDE immutable SP+ first build-test payload" \
      org.opencontainers.image.version="0.1.0-poc"
