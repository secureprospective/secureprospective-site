#!/usr/bin/env bash
# vmunlock [passphrase] -- type the LUKS passphrase at the SP+ VM's GRAPHICAL prompt.
#
# WHY THIS EXISTS: the SP+ image shows a branded Plymouth unlock screen on the video
# console, not on the serial line. Feeding the serial console (as spplus-bench.sh does)
# types into nothing, sshd never starts, and the VM looks hung. Send keys to the
# graphical console instead. Opens no window on the host.
set -uo pipefail
DOM="${DOM:-spplus-test}"
PASS="${1:-spplustest}"
V() { virsh -c qemu:///session "$@"; }

declare -A K=(
 [a]=KEY_A [b]=KEY_B [c]=KEY_C [d]=KEY_D [e]=KEY_E [f]=KEY_F [g]=KEY_G [h]=KEY_H
 [i]=KEY_I [j]=KEY_J [k]=KEY_K [l]=KEY_L [m]=KEY_M [n]=KEY_N [o]=KEY_O [p]=KEY_P
 [q]=KEY_Q [r]=KEY_R [s]=KEY_S [t]=KEY_T [u]=KEY_U [v]=KEY_V [w]=KEY_W [x]=KEY_X
 [y]=KEY_Y [z]=KEY_Z
 [0]=KEY_0 [1]=KEY_1 [2]=KEY_2 [3]=KEY_3 [4]=KEY_4
 [5]=KEY_5 [6]=KEY_6 [7]=KEY_7 [8]=KEY_8 [9]=KEY_9
 [-]=KEY_MINUS [.]=KEY_DOT [/]=KEY_SLASH [+]=KEY_EQUAL
)
[ "$(V domstate "$DOM" 2>/dev/null)" = "running" ] || { echo "vmunlock: $DOM is not running" >&2; exit 1; }
n=${#PASS}
for ((i=0;i<n;i++)); do
  ch="${PASS:i:1}"; code="${K[$ch]:-}"
  [ -n "$code" ] || { echo "vmunlock: no keycode for '$ch' -- extend the map" >&2; exit 2; }
  V send-key "$DOM" --codeset linux "$code" >/dev/null || exit 3
done
V send-key "$DOM" --codeset linux KEY_ENTER >/dev/null || exit 3
echo "vmunlock: passphrase sent to $DOM (${n} chars)"
