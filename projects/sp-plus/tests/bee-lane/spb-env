#!/usr/bin/env bash
# SP+ Bee lane — shared environment. Sourced by every spb-* script.
# Nothing here needs root. The whole test lane runs as chris.
SPB_HOME=~/work/sp-plus/bee
SPB_ISO_DIR=~/work/sp-plus/iso
REPO=/home/chris/work/secureprospective-advisor-os
# The output filename is derived from the payload's os-release, so branding the
# image (DN-19) renamed it from bootc-fedora-44-... to bootc-sp-plus-1.0-... .
# Take the newest ISO rather than a hardcoded name, and let SPB_ISO override.
ISO="${SPB_ISO:-$(ls -t "$REPO"/projects/sp-plus/artifacts/spikeB-rootful/out/*/*.iso 2>/dev/null | head -1)}"
CYCLE="${CYCLE:-cycle7}"
D="$SPB_ISO_DIR/$CYCLE"
MON="$D/monitor.sock"        # install-phase monitor
BMON="$D/boot-monitor.sock"  # boot-phase monitor
LUKS_PASS=spplus-test        # DISPOSABLE test credential. Never in the ISO or the repo.
# One VM per port. Two cycles booted at once collided on 2299 and the second qemu
# died with "Could not set up host forwarding rule". Derive a default from the cycle
# number so parallel cycles never fight; SPB_SSHPORT still overrides.
SSHPORT="${SPB_SSHPORT:-$((2200 + $(printf "%s" "$CYCLE" | tr -dc "0-9" | tail -c 2)))}"
mon() { echo "$1" | socat - UNIX-CONNECT:"$2" >/dev/null 2>&1; }
key() { mon "sendkey $1" "${2:-$MON}"; sleep "${KEYDELAY:-0.4}"; }
die() { echo "SPB-FAIL: $*" >&2; exit 1; }
