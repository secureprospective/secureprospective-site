#!/usr/bin/env bash
# spb-shell '<command>' — run one command inside the booted guest over the serial
# console and print what came back. Logs in as root first if needed.
# THIS IS WHY NO HOST sudo IS NEEDED: root lives inside the VM.
. ~/work/sp-plus/bee/spb-env
P="$D/bserialpty"; L="$D/bserial.log"
[ -e "$P" ] || die "no serial pty — run spb-boot first"
printf '\n' > "$P"; sleep 2
# SP+ ships NO account at all now (DN-13 absolute), so there is nothing to log in as
# until the lane creates one with spb-mkuser. SPB_USER names that account; it is a
# lane-only test identity and never ships. If it does not exist on the guest the
# login fails, the gate returns nothing, and the gate fails loudly on silence --
# which is correct, because a gate that cannot reach the guest has measured nothing.
if tail -3 "$L" | grep -qa "login:"; then
  printf '%s\n' "${SPB_USER:-spbtest}" > "$P"; sleep 3
  printf '%s\n' "$LUKS_PASS" > "$P"; sleep 6
  printf 'sudo -S -p "" -i\n' > "$P"; sleep 2
  printf '%s\n' "$LUKS_PASS" > "$P"; sleep 4
fi
# The console ECHOES the command line before running it. A marker written
# plainly into that line therefore appears in the echo IMMEDIATELY, the wait
# below returns before the command has produced anything, and the caller reads
# an empty result. Observed 2026-08-27: `pi --version` and a curl to the local
# RPC both reported nothing through this function while working perfectly by
# hand -- every gate built on spb-shell was silently truncating slow commands.
#
# The fix is a marker that cannot match its own echo: the command line contains
# the marker SPLIT ACROSS A QUOTE BOUNDARY, so the echo shows SPB"MARK123 while
# only the command's real output ever contains SPBMARK123.
mark="SPBMARK$$"
before=$(stat -c%s "$L")
printf '%s; echo "SPB""MARK%s"\n' "$1" "$$" > "$P"
for i in $(seq 1 60); do
  # Count only occurrences that are NOT part of the echoed command line.
  if grep -a "$mark" "$L" | grep -qav '""'; then break; fi
  sleep 2
done
# The marker can land in the log BEFORE the command's own output has flushed
# through the pty. A fixed 1s sleep sometimes cut the RPC health JSON off, and
# the gate then reported FAIL for a service that was demonstrably up. Wait for
# the log to go quiet instead of guessing at a duration.
prev=-1
for _ in $(seq 1 10); do
  sleep 0.5
  now=$(stat -c%s "$L")
  [ "$now" = "$prev" ] && break
  prev=$now
done
tail -c +$((before+1)) "$L"
