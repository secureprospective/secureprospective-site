#!/usr/bin/env bash
# spb-hygiene — RAM and storage discipline for the SP+ lane on Christopher's DAILY DRIVER.
# Run it at the START of a work block, after every completed cycle, and before any handoff.
# Binary, not a policy debate: if we are not coming back to it, it goes.
# Reports first. Pass --apply to actually reclaim.
. /home/chris/sp-plus-bee/spb-env 2>/dev/null
APPLY=""; [ "${1:-}" = "--apply" ] && APPLY=yes
echo "########## SP+ HYGIENE  $(date -u +%FT%TZ)  apply=${APPLY:-no} ##########"

echo "=== RAM ==="
free -g | awk 'NR<=2'
AVAIL=$(free -g | awk '/^Mem:/{print $7}')
[ "$AVAIL" -lt 6 ] && echo "WARN: only ${AVAIL} GB available — a cycle needs ~6 GB. Stop a VM."

echo "=== DISK (/home) ==="
df -h /home | tail -1
FREE=$(df -BG --output=avail /home | tail -1 | tr -dc 0-9)
[ "$FREE" -lt 40 ] && echo "WARN: only ${FREE} GB free — each cycle disk is ~8 GB."

echo "=== RUNNING VMs (never kill one named 'chris' — that is Christopher's) ==="
ps -eo pid,etime,args | grep -E "[q]emu-system|[s]wtpm" | sed 's/^/  /' || echo "  none"

echo "=== CYCLE DIRECTORIES ==="
for d in "$SPB_ISO_DIR"/cycle*; do
  [ -d "$d" ] || continue
  sz=$(du -sm "$d" 2>/dev/null | cut -f1)
  age=$(( ( $(date +%s) - $(stat -c%Y "$d") ) / 3600 ))
  live=no; [ -f "$d/boot.pid" ] && kill -0 "$(cat "$d/boot.pid" 2>/dev/null)" 2>/dev/null && live=yes
  printf "  %-42s %6s MB  age %3sh  running=%s\n" "$d" "$sz" "$age" "$live"
done

echo "=== VERDICT ==="
echo "  KEEP: any cycle an OPEN defect cites as evidence (today: cycle6, cycle7)."
echo "  KEEP: every serial log, screenshot and report the ledger references."
echo "  DROP: cycle dirs from a closed question, older than 12h, not running."
echo "  A qcow2 is ~8 GB. Three stale cycles is a quarter of his free space."
if [ -n "$APPLY" ]; then
  echo "--- running reap.sh --apply (12h evidence hold) ---"
  ~/sp-plus-gates/reap.sh --apply 2>&1 | tail -12
  find "$SPB_ISO_DIR" -maxdepth 1 -name '*.ppm' -newermt '-30 days' -size +1M 2>/dev/null | while read -r f; do
    [ -f "${f%.ppm}.png" ] && { echo "  rm redundant $f"; rm -f "$f"; }
  done
else
  echo "  (report only — pass --apply to reclaim)"
fi
echo "########## END HYGIENE ##########"
