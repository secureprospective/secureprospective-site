#!/usr/bin/env bash
# spb-build — rebuild the SP+ ISO and print its sha256.
# WHY THIS WRAPPER EXISTS: the build needs rootful podman. `chris` already holds a
# NOPASSWD grant for /usr/bin/podman ONLY (see `sudo -l`). This script is the one
# fixed, auditable entry point so an agent never composes a sudo line itself.
# Christopher can revoke the lane by deleting this file; nothing else uses root.
set -o pipefail
LOG=/home/chris/sp-plus-build-$(date +%Y%m%dT%H%M%S).log
echo "SPB: building, log=$LOG  (~15 min)"
setsid nohup ~/fleet/bin/sp-plus-iso-build.sh > "$LOG" 2>&1 &
echo "SPB: pid=$! log=$LOG"
echo "SPB: poll with:  tail -5 $LOG"
