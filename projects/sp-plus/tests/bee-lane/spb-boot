#!/usr/bin/env bash
# spb-boot — boot the installed system with a READ/WRITE serial console, answer the
# LUKS prompt on the serial, log in as root, and leave the guest sitting at a shell.
# Optional arg: extra kernel args to append in the GRUB editor (e.g. "enforcing=0").
# THE SERIAL CONSOLE IS THE INSTRUMENT. It is why this lane is cheap (OP-22).
. /home/chris/sp-plus-bee/spb-env
set -e
EXTRA="$1"
[ -f "$D/disk.qcow2" ] || die "no installed disk at $D/disk.qcow2"
pkill -F "$D/qemu.pid" 2>/dev/null || true
pkill -F "$D/boot.pid" 2>/dev/null || true
sleep 2
# NEVER delete a boot log — evidence has already been drawn from it and the
# runbook forbids it. Re-running spb-boot on cycle10 destroyed that cycle's
# bserial.log. Rotate to a timestamped name instead.
[ -s "$D/bserial.log" ] && mv "$D/bserial.log" "$D/bserial-$(date +%Y%m%d-%H%M%S).log"
rm -f "$BMON" "$D"/bserial.sock "$D"/bserialpty
rm -rf "$D/tpm"; mkdir -p "$D/tpm"
swtpm socket --tpmstate dir="$D/tpm" --ctrl type=unixio,path="$D/tpm/sock" --tpm2 --daemon
sleep 1
qemu-system-x86_64 \
  -name "spplus-$CYCLE-boot" \
  -machine q35,smm=on -accel kvm -m 6144 -smp 4 \
  -drive if=pflash,format=raw,unit=0,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.secboot.fd \
  -drive if=pflash,format=raw,unit=1,file="$D/vars.fd" \
  -global driver=cfi.pflash01,property=secure,value=on \
  -chardev socket,id=chrtpm,path="$D/tpm/sock" \
  -tpmdev emulator,id=tpm0,chardev=chrtpm -device tpm-tis,tpmdev=tpm0 \
  -device ich9-ahci,id=ahci \
  -drive file="$D/disk.qcow2",if=none,id=hd0,format=qcow2 \
  -device ide-hd,drive=hd0,bus=ahci.0 \
  -vga std -display none \
  -device qemu-xhci,id=xhci -device usb-tablet,bus=xhci.0 \
  -serial unix:"$D/bserial.sock",server,nowait \
  -monitor unix:"$BMON",server,nowait \
  -netdev user,id=n0,hostfwd=tcp::2299-:22 -device virtio-net-pci,netdev=n0 &
echo $! > "$D/boot.pid"

# --- HALT GRUB. The countdown is 1 SECOND and GRUB only appears AFTER several
# seconds of OVMF POST. v1 set up socat first (~6s) and missed it. v2 fired 250 keys
# immediately and ALSO missed it — every key was consumed during POST, leaving none
# for the actual menu. v3 hammers CONTINUOUSLY in the background across the whole
# POST+menu window, so whenever the menu appears there are keys arriving.
for i in $(seq 1 200); do [ -S "$BMON" ] && break; sleep 0.05; done
setsid bash -c 'for i in $(seq 1 1200); do echo "sendkey end" | socat - UNIX-CONNECT:'"$BMON"' >/dev/null 2>&1; done' >/dev/null 2>&1 &
HAMMER=$!

# attach the serial capture while the hammer runs
sleep 1
setsid socat UNIX-CONNECT:"$D/bserial.sock" PTY,link="$D/bserialpty",raw,echo=0 >/dev/null 2>&1 &
sleep 2
setsid bash -c "cat $D/bserialpty > $D/bserial.log" >/dev/null 2>&1 &
P="$D/bserialpty"

# wait until the menu is actually on screen and held, then stop hammering
echo "SPB: waiting for the GRUB menu"
for i in $(seq 1 40); do
  grep -qa 'GRUB version' "$D/bserial.log" && break
  sleep 1
done
# Enter the editor WHILE the hammer is still running — `e` stops the countdown
# permanently. v3 killed the hammer first, the countdown resumed, and it booted.
key home "$BMON"; key e "$BMON"
sleep 1
kill "$HAMMER" 2>/dev/null || true
pkill -P "$HAMMER" 2>/dev/null || true
sleep 2
echo "SPB: GRUB_MENU_SEEN=$(grep -qa 'GRUB version' "$D/bserial.log" && echo yes || echo no)"
echo "SPB: IN_EDITOR=$(grep -qa 'Minimum Emacs-like screen editing' "$D/bserial.log" && echo yes || echo unknown)"

# --- GRUB editor. `end` alone selects "UEFI Firmware Settings" — `home` is required.
# Enter inside the editor SPLITS the linux line, which is why vmtype-noret.sh exists.
key down "$BMON"; key down "$BMON"; key down "$BMON"; key ctrl-e "$BMON"
/home/chris/sp-plus-iso/vmtype-noret.sh "$BMON" " console=ttyS0,115200 $EXTRA" >/dev/null
sleep 1
key ctrl-x "$BMON"

echo "SPB: waiting for the LUKS prompt on serial (up to 2 min)"
seen=no
for i in $(seq 1 40); do
  grep -qai "enter passphrase" "$D/bserial.log" && { seen=yes; break; }
  sleep 3
done
echo "SPB: LUKS_PROMPT_ON_SERIAL=$seen after $((i*3))s"
[ "$seen" = yes ] || echo "SPB: prompt never appeared — capture the log anyway, do NOT retry blind"
# DN-15: the prompt is on the serial. Is it on the SCREEN? Capture the panel
# BEFORE answering, because that is the moment Christopher faces on the Dell.
/home/chris/sp-plus-bee/spb-screen luks || true
printf '%s\n' "$LUKS_PASS" > "$P"
echo "SPB: passphrase sent, waiting 180s for the system to settle"
sleep 60

# SP+ ships NO password (DN-13); the advisor sets one at first boot on the ACTIVE
# console, which under test is this serial line. Answer that prompt so the lane has
# a credential to log in with. The value is the disposable test passphrase and must
# never appear in the ISO, the repo, or committed config.
fb=no
for i in $(seq 1 20); do
  grep -qa "SP+ first boot" "$D/bserial.log" && { fb=yes; break; }
  sleep 3
done
echo "SPB: FIRSTBOOT_PROMPT_ON_CONSOLE=$fb after $((i*3))s"
if [ "$fb" = yes ]; then
  sleep 2; printf '%s\n' "$LUKS_PASS" > "$P"
  sleep 2; printf '%s\n' "$LUKS_PASS" > "$P"
  sleep 8
  grep -qa "Password set" "$D/bserial.log" \
    && echo "SPB: FIRSTBOOT_PASSWORD_SET=yes" \
    || echo "SPB: FIRSTBOOT_PASSWORD_SET=no"
fi
sleep 120
/home/chris/sp-plus-bee/spb-screen settled || true
echo "SPB: serial_bytes=$(stat -c%s "$D/bserial.log")"
echo "SPB: guest left running. Type into $P, read $D/bserial.log"
