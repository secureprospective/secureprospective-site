echo "ISO_PRESENT: yes"
echo "ISO_BYTES: $(stat -c%s "$ISO")"
echo "ISO_MTIME: $(stat -c%y "$ISO")"
echo "ISO_SHA256: $(sha256sum "$ISO" | cut -d' ' -f1)"
