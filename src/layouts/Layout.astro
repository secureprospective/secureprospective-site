---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/transitions.css';
import '../styles/site.css';
import { ViewTransitions } from 'astro:transitions';
import ChatWidget from '../components/ChatWidget.astro';

const {
  title = 'Secure Prospective',
  description = 'SecureProspective operates a real IMO and is rebuilding it AI-native through SP+, its first deliverable.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#E5E4E2" />
    <title>{title}</title>
    <ViewTransitions />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <!--
    THESIS: A real operating business leads; SP+ makes the forward claim concrete; consulting follows delivered evidence.
    OWN-WORLD: The established Property Card System remains intact with platinum stock, compliance blue, signal yellow, ledger ink, sharp edges, stamped Primal titles, and hard card-lift depth.
    STORY: Visitors meet the name, see the operating IMO, follow SP+ as the first deliverable, understand the method, and choose the relevant conversation.
    FIRST VIEWPORT: Secure Prospective stands alone at the center in Primal with its pronunciation directly beneath in IBM Plex Sans.
    FORM: Established SecureProspective visual system, reorganized around the corrected business hierarchy; seed 6fe53f20 superseded by the user's explicit instruction to preserve the incumbent world.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
    -->
    <slot />
    <ChatWidget />
  </body>
</html>
