---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/transitions.css';
import '../styles/site.css';
import '../styles/immersive.css';
import { ViewTransitions } from 'astro:transitions';
import ChatWidget from '../components/ChatWidget.astro';

const {
  title = 'SecureProspective',
  description = 'SecureProspective operates a real IMO and is rebuilding it AI-native through SP+, its first deliverable.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#E5E4E2" />
    <title>{title}</title>
    <ViewTransitions />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <!--
    SecureProspective. The Property Card System: platinum stock, compliance
    blue, signal yellow, ledger ink, square corners, stamped Primal titles, and
    a hard zero-blur Card-Lift shadow. Cards are dealt onto the table as you
    scroll, they carry real depth, and they answer the pointer.
    -->
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="scroll-progress" aria-hidden="true"><span data-scroll-progress></span></div>
    <slot />
    <ChatWidget />
  </body>
</html>
