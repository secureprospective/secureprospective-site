---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/transitions.css';
import '../styles/site.css';
import '../styles/immersive.css';
import { ViewTransitions } from 'astro:transitions';

const {
  title = 'SecureProspective',
  description = 'SecureProspective operates a real IMO and is rebuilding it AI-native through SP+, its first deliverable.',
  // Back-office pages pass this. Nothing behind the member gate belongs in a
  // search index, and the login and admin screens least of all.
  noindex = false,
  // Pages may name their own share card. The default carries the wordmark and
  // is correct for every page that has nothing more specific to show.
  ogImage = '/assets/social/og-default.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

// Marked up so a search engine reads the operating business, not just the page.
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'SecureProspective',
  url: 'https://secureprospective.com',
  logo: new URL('/android-chrome-512x512.png', Astro.site).href,
  description:
    'SecureProspective is an insurance marketing organization serving independent insurance and annuity producers, building SP+, an immutable encrypted workstation for advisors.',
  email: 'info@secureprospective.com',
  founder: { '@type': 'Person', name: 'Christopher Campbell' },
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#E5E4E2" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!--
      Without these a link shared to LinkedIn or Facebook renders as bare text.
      The campaign runs on shared links, so the card is not decoration.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SecureProspective" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SecureProspective: the safer advisor workstation." />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(organization)} />
    <ViewTransitions />
    <!--
      Primal carries the wordmark and every page title. With font-display: swap
      and no preload, the first paint drew all of it in the fallback and then
      reflowed. The two body weights that follow are the ones above the fold on
      every page; the rest load from the stylesheet as they are reached.
    -->
    <link rel="preload" href="/fonts/Primal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/IBMPlexSans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/IBMPlexSans-700.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <!--
    SecureProspective. The Property Card System: platinum stock, compliance
    blue, signal yellow, ledger ink, square corners, stamped Primal titles, and
    a hard zero-blur Card-Lift shadow. Cards are dealt onto the table as you
    scroll, they carry real depth, and they answer the pointer.
    -->
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="scroll-progress" aria-hidden="true"><span data-scroll-progress></span></div>
    <slot />
  </body>
</html>
