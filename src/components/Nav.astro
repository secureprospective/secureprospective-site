---
const raw = Astro.url.pathname;
const path = raw.endsWith('/') && raw.length > 1 ? raw.slice(0, -1) : raw;

const links = [
  { href: '/the-method', label: 'The Method' },
  { href: '/the-work', label: 'The Work' },
  { href: '/services', label: 'Services' },
  { href: '/the-operator', label: 'The Operator' },
  { href: '/contact', label: 'Contact' },
];
const isActive = (href: string) => path === href;
---

<header class="nav" transition:name="app-nav">
  <div class="nav-inner container">
    <a href="/" class="logo">
      <svg class="logo-mark" viewBox="-0.025 0.006 157.925 161.545" aria-hidden="true">
        <path d="M5.27 44.17a54.2 54.2 0 0 1 7.93-12.78c12.51-15.85 28.63-26 48.49-29.81 21-4 40.82-.42 58.81 11.22 21.34 13.83 33.71 33.56 36.8 58.84a78.48 78.48 0 0 1-9.59 48.36c-.27.48-.41 1.06-1 1.34.07-.69.07-1.37.19-2a40.77 40.77 0 0 0-4.63-27.54c-2.21-4-4.7-7.88-8.3-10.87a19.83 19.83 0 0 0-4.06-4.07c-9.85-8.34-21.26-13.43-33.81-16.13a92.17 92.17 0 0 0-45.91 1.61A73.27 73.27 0 0 0 18.6 80.62a38.39 38.39 0 0 1-8.78-12.14c1.32-1.57 2.59-3.18 4-4.7C23.71 52.82 36 45.5 49.91 40.86a92.5 92.5 0 0 1 11.92-3c2.16-.4 2.24-.31 2.25 1.82v5.78c-.06 1.46.17 2 1.71 1.11Q80 38.29 94.21 30.14c1.46-.83 1.31-1.28 0-2.07-4.34-2.68-8.64-5.43-13-8.14Q73.46 15 65.64 10.12c-.4-.26-.81-.78-1.31-.47s-.24.91-.25 1.38v4.48c0 3.83 0 3.78-3.79 4.25a89.64 89.64 0 0 0-42.6 16.64A87.37 87.37 0 0 0 5.26 47.9z" />
        <path d="M5.27 44.17v3.73a37 37 0 0 0 4.55 20.58 38.39 38.39 0 0 0 8.78 12.14 14.6 14.6 0 0 0 1 1.28 64.24 64.24 0 0 0 19 13c20.86 9.42 42.33 10.59 64.21 4.26A69.91 69.91 0 0 0 134 80.91c3.6 3 6.09 6.84 8.3 10.87a40.77 40.77 0 0 1 4.63 27.54c-.12.67-.12 1.35-.19 2a2.49 2.49 0 0 1-.11.29.12.12 0 0 0-.07.17 74.29 74.29 0 0 1-18 21.18c-34.21 27.93-82.96 23.96-112.26-9.02-6.05-6.81-10.5-14.59-14.3-22.82a.58.58 0 0 1 .26-.79c1.36.53 1.62 2.17 2.86 2.82a3.9 3.9 0 0 0 1.07 1.5A71.06 71.06 0 0 0 19.1 126.2a90.85 90.85 0 0 0 43.26 15.91c1.36.14 1.82.54 1.76 1.9-.11 2.23 0 4.48 0 6.71 0 1.4.4 1.5 1.46.8 1.72-1.13 3.47-2.19 5.21-3.28 7.89-5 15.77-9.94 23.69-14.87 1.19-.74 1.25-1.18 0-1.82s-2.38-1.35-3.56-2l-25-14.44c-1.72-1-1.73-1-1.73 1v6.53c0 1.19-.33 1.47-1.52 1.25a88.53 88.53 0 0 1-41.71-19.17A85.13 85.13 0 0 1 9.82 93.16a87.4 87.4 0 0 1-6.71-12.08 45 45 0 0 1-2.9-20.51c.59-5.79 1.92-11.38 5.06-16.4z" />
        <path d="M5.15 113.15c-1.24-.65-1.5-2.29-2.86-2.82C.87 108 .71 105.27.4 102.7a42.12 42.12 0 0 1 2.28-20.82 7 7 0 0 1 .43-.81 86.93 86.93 0 0 0 6.71 12.09c-.27.48-.58 1-.81 1.45a40.5 40.5 0 0 0-3.86 18.54zM146.56 121.82a.12.12 0 0 1 .07-.17v.14z" />
      </svg>
      SECURE PROSPECTIVE
    </a>

    <button
      type="button"
      class="nav-burger"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>

    <nav id="primary-nav" class="nav-links" aria-label="Primary">
      {
        links.map((l) => (
          <a href={l.href} class:list={['nav-link', { active: isActive(l.href) }]}>
            {l.label}
          </a>
        ))
      }
      <a href="/members" class="nav-login-btn">Login</a>
    </nav>
  </div>
</header>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.nav-burger');
  const navLinks = document.getElementById('primary-nav');

  if (burger && navLinks) {
    burger.addEventListener('click', () => {
      const isOpen = navLinks.classList.toggle('is-open');
      burger.setAttribute('aria-expanded', String(isOpen));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && navLinks.classList.contains('is-open')) {
        navLinks.classList.remove('is-open');
        burger.setAttribute('aria-expanded', 'false');
        burger.focus();
      }
    });
  }
</script>

<style>
  .nav {
    background: var(--silver-base);
    border-bottom: 2px solid var(--ink);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    flex-wrap: wrap;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-caption);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    line-height: 1;
  }

  .logo-mark {
    width: 24px;
    height: auto;
    fill: currentColor;
    flex-shrink: 0;
  }

  .nav-links {
    display: flex;
    gap: var(--space-4);
    align-items: center;
  }

  .nav-link {
    font-family: var(--font-display);
    color: var(--ink);
    text-decoration: none;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: color 120ms ease-out;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--blue-brand);
  }

  .nav-login-btn {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink);
    text-decoration: none;
    border: 2px solid var(--ink);
    border-radius: var(--radius-button);
    padding: 6px 14px;
    transition: background 120ms ease-out, color 120ms ease-out;
  }
  .nav-login-btn:hover {
    background: var(--ink);
    color: var(--ink-inverted);
  }
  .nav-login-btn:focus-visible {
    outline: 2px solid var(--blue-brand);
    outline-offset: 2px;
  }

  .nav-burger {
    display: none;
    cursor: pointer;
    flex-direction: column;
    gap: 4px;
    padding: 6px;
    background: none;
    border: none;
  }
  .nav-burger:focus-visible {
    outline: 2px solid var(--blue-brand);
    outline-offset: 2px;
  }
  .nav-burger .bar {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--ink);
  }

  @media (max-width: 767px) {
    .nav-burger {
      display: flex;
    }

    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--silver-base);
      border-bottom: 2px solid var(--ink);
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      max-height: 0;
      overflow: hidden;
      transition: max-height 200ms linear;
    }

    .nav-link {
      padding: var(--space-3) var(--space-4);
      width: 100%;
      border-top: 1px solid rgba(34, 34, 34, 0.15);
      font-size: var(--text-caption);
    }
    .nav-link:first-child {
      border-top: none;
    }

    .nav-login-btn {
      display: block;
      text-align: center;
      margin: var(--space-3) var(--space-4);
    }

    .nav-links.is-open {
      max-height: 420px;
    }
  }
</style>
