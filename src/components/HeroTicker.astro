---
/*
 * Homepage-only ambient register. A fixed 32px ledger grid sits beneath rows
 * of moving evidence marks. One yellow scan passes through the field while the
 * blue marks continue in opposing directions, suggesting continuous audit
 * rather than decorative motion. The loop pauses off-screen and when hidden.
 */
---

<div class="identity-hero-fx" aria-hidden="true">
  <canvas id="hero-fx-canvas" data-hero-fx></canvas>
</div>

<script>
  (function () {
    var raf = null;
    var running = false;
    var t = 0;
    var lastTime = 0;
    var io = null;
    var canvas = null;
    var ctx = null;
    var onResize = null;
    var onVisibility = null;
    var onMotionChange = null;
    var booted = false;
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    var blue = '0, 51, 160';
    var yellow = '255, 215, 0';
    var ink = '34, 34, 34';

    function dpr() {
      return Math.min(window.devicePixelRatio || 1, 2);
    }

    function isVisible() {
      if (!canvas || !canvas.isConnected) return false;
      var rect = canvas.getBoundingClientRect();
      return rect.bottom > 0 && rect.top < window.innerHeight && rect.width > 0;
    }

    function resize() {
      if (!canvas || !canvas.parentElement || !ctx) return;
      var rect = canvas.parentElement.getBoundingClientRect();
      var scale = dpr();
      canvas.width = Math.max(1, Math.round(rect.width * scale));
      canvas.height = Math.max(1, Math.round(rect.height * scale));
      ctx.setTransform(scale, 0, 0, scale, 0, 0);
    }

    function drawGrid(width, height) {
      var unit = 32;
      ctx.strokeStyle = 'rgba(' + ink + ', 0.08)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (var x = 0.5; x <= width; x += unit) {
        ctx.moveTo(x, 0);
        ctx.lineTo(x, height);
      }
      for (var y = 0.5; y <= height; y += unit) {
        ctx.moveTo(0, y);
        ctx.lineTo(width, y);
      }
      ctx.stroke();
    }

    function drawRegister(width, height) {
      // The threads read as a woven field rather than a loose ledger, so the
      // row pitch is deliberately tighter than the 32px grid beneath it.
      var rowHeight = 11;
      var dashWidth = 7;
      var gap = 6;
      var unit = dashWidth + gap;
      var rows = Math.ceil(height / rowHeight) + 1;

      for (var row = 0; row <= rows; row += 1) {
        var y = row * rowHeight + rowHeight / 2;
        var direction = row % 2 === 0 ? 1 : -1;
        var offset = ((t * 32 * direction) % unit + unit) % unit;
        var rowPhase = (row * 0.5) % (Math.PI * 2);

        for (var x = -unit; x < width + unit; x += unit) {
          var dx = x - offset;
          var wave = Math.sin((dx / Math.max(width, 1)) * Math.PI * 2 + t * 1.25 + rowPhase) * 0.5 + 0.5;
          var signal = wave > 0.92;
          var brightness = 0.12 + wave * 0.24;
          ctx.fillStyle = signal
            ? 'rgba(' + yellow + ', ' + Math.min(0.88, brightness + 0.48).toFixed(2) + ')'
            : 'rgba(' + blue + ', ' + brightness.toFixed(2) + ')';
          ctx.fillRect(dx, y - 1, dashWidth, 2);
        }
      }
    }

    function drawScan(width, height) {
      var scanX = reduceMotion.matches ? width * 0.68 : ((t * 48) % (width + 64)) - 32;
      ctx.fillStyle = 'rgba(' + yellow + ', 0.4)';
      ctx.fillRect(scanX, 0, 2, height);
      ctx.fillStyle = 'rgba(' + blue + ', 0.28)';
      ctx.fillRect(scanX + 8, 0, 1, height);
    }

    function draw() {
      if (!canvas || !ctx) return;
      var scale = dpr();
      var width = canvas.width / scale;
      var height = canvas.height / scale;
      if (!width || !height) return;

      ctx.clearRect(0, 0, width, height);
      drawGrid(width, height);
      drawRegister(width, height);
      drawScan(width, height);
    }

    function loop(now) {
      if (!running) return;
      var elapsed = lastTime ? Math.min(50, now - lastTime) : 16;
      lastTime = now;
      t += elapsed * 0.00075;
      draw();
      raf = requestAnimationFrame(loop);
    }

    function start() {
      if (running || !canvas || document.hidden || !isVisible()) return;
      resize();
      if (reduceMotion.matches) {
        draw();
        return;
      }
      running = true;
      lastTime = 0;
      raf = requestAnimationFrame(loop);
    }

    function stop() {
      running = false;
      lastTime = 0;
      if (raf !== null) {
        cancelAnimationFrame(raf);
        raf = null;
      }
    }

    function handleVisibility() {
      if (document.hidden) stop();
      else start();
    }

    function handleMotionChange() {
      stop();
      start();
    }

    function teardown() {
      stop();
      if (io) {
        io.disconnect();
        io = null;
      }
      if (onResize) {
        window.removeEventListener('resize', onResize);
        onResize = null;
      }
      if (onVisibility) {
        document.removeEventListener('visibilitychange', onVisibility);
        onVisibility = null;
      }
      if (onMotionChange) {
        if (reduceMotion.removeEventListener) reduceMotion.removeEventListener('change', onMotionChange);
        else if (reduceMotion.removeListener) reduceMotion.removeListener(onMotionChange);
        onMotionChange = null;
      }
      if (canvas) canvas.removeAttribute('data-fx-booted');
      canvas = null;
      ctx = null;
      booted = false;
    }

    function boot() {
      if (booted) return;
      var node = document.getElementById('hero-fx-canvas');
      if (!node) return;
      var context = node.getContext('2d');
      if (!context) return;

      booted = true;
      canvas = node;
      ctx = context;
      node.dataset.fxBooted = 'true';

      io = 'IntersectionObserver' in window
        ? new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) start();
              else stop();
            });
          }, { threshold: 0.05 })
        : null;

      if (io) io.observe(canvas);

      onResize = function () {
        if (!canvas || !canvas.offsetWidth) return;
        resize();
        if (reduceMotion.matches) draw();
      };
      window.addEventListener('resize', onResize, { passive: true });

      onVisibility = handleVisibility;
      document.addEventListener('visibilitychange', onVisibility);

      onMotionChange = handleMotionChange;
      if (reduceMotion.addEventListener) reduceMotion.addEventListener('change', onMotionChange);
      else if (reduceMotion.addListener) reduceMotion.addListener(onMotionChange);

      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(function () {
          if (canvas === node) onResize();
        }).catch(function (error) {
          console.warn('[Homepage register] font readiness failed; keeping current field size.', error);
        });
      }

      if (isVisible()) start();
    }

    document.addEventListener('astro:page-load', boot);
    document.addEventListener('astro:before-swap', teardown);
    boot();
  })();
</script>
