---
/**
 * Reusable portrait animation. The WebP is the efficient path; the GIF keeps
 * the asset usable in older browsers. Reduced-motion users get the opening
 * pose as a static watercolor panel.
 */
const {
  alt = 'Christopher Campbell in a watercolor comic-book portrait',
  class: className = '',
  decorative = false,
  loading = 'lazy',
} = Astro.props;

const imageAlt = decorative ? '' : alt;
---

<picture
  class={`watercolor-portrait ${className}`.trim()}
  data-watercolor-portrait
  data-static-src="/assets/illustrations/secureprospective-watercolor-comic-static.png"
>
  <source
    srcset="/assets/illustrations/secureprospective-watercolor-comic.webp"
    type="image/webp"
  />
  <img
    src="/assets/illustrations/secureprospective-watercolor-comic.gif"
    alt={imageAlt}
    width="420"
    height="615"
    loading={loading}
    decoding="async"
    {...(decorative ? { 'aria-hidden': 'true' } : {})}
  />
</picture>

<script>
  (() => {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    function syncPortraits() {
      document.querySelectorAll('[data-watercolor-portrait]').forEach((portrait) => {
        const source = portrait.querySelector('source');
        const image = portrait.querySelector('img');
        if (!source || !image) return;

        if (reduceMotion.matches) {
          source.setAttribute('media', 'not all');
          image.src = portrait.dataset.staticSrc;
        } else {
          source.removeAttribute('media');
          image.src = '/assets/illustrations/secureprospective-watercolor-comic.gif';
        }
      });
    }

    document.addEventListener('astro:page-load', syncPortraits);
    document.addEventListener('astro:before-swap', syncPortraits);
    if (reduceMotion.addEventListener) reduceMotion.addEventListener('change', syncPortraits);
    else if (reduceMotion.addListener) reduceMotion.addListener(syncPortraits);
    syncPortraits();
  })();
</script>

<style>
  .watercolor-portrait {
    display: block;
    width: 100%;
    max-width: 420px;
    overflow: hidden;
    border: 2px solid var(--ink);
    background: var(--white);
  }

  .watercolor-portrait img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
