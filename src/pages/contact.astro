---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/pages/contact.css';

const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<Layout title="Contact: SecureProspective" description="Choose the SecureProspective conversation that matches the work in front of you.">
  <Nav />
  <main id="main" class="contact-page" transition:name="page-card">
    <section class="contact-hero" aria-labelledby="contact-title">
      <div class="contact-hero-grid shell">
        <div class="contact-hero-index" data-deal>
          <span>FILE // CONTACT</span>
          <span>DIRECT CHANNEL</span>
          <span class="contact-hero-index-mark" aria-hidden="true"></span>
        </div>

        <div class="contact-hero-copy" data-deal style="--deal-delay: 80ms">
          <h1 id="contact-title"><span>Choose the</span>{' '}<span>conversation.</span></h1>
          <p>
            The operating business, the active build, and the prospective offer are not interchangeable.
            Start with the state that matches the work in front of you.
          </p>
        </div>

        <div class="contact-channel-wrap" data-deal style="--deal-delay: 160ms">
          <aside class="contact-channel-card" aria-label="Direct channel">
            <div class="contact-channel-head">
              <span>Direct channel</span>
              <span class="contact-channel-mark" aria-hidden="true"></span>
            </div>
            <a href="mailto:info@secureprospective.com">info@secureprospective.com</a>
          </aside>
        </div>
      </div>

      <div class="contact-hero-footer shell" aria-hidden="true">
        <span>CHOOSE A CONVERSATION</span>
        <span class="contact-hero-footer-mark"></span>
      </div>
    </section>

    <section class="contact-routing" data-contact-root aria-labelledby="contact-routing-title">
      <div class="shell">
        <div class="contact-routing-heading" data-deal>
          <h2 id="contact-routing-title">Match the line to the work.</h2>
        </div>

        <div class="contact-route-readout" aria-hidden="true">
          <span>CONVERSATIONS // DIRECT</span>
          <span class="contact-route-readout-value" data-contact-readout>SELECT A LINE</span>
        </div>

        <div class="contact-route-board">
          <div class="contact-route-gutter" aria-hidden="true">
            <span class="contact-route-gutter-label">ROUTE</span>
            <span class="contact-route-marker"></span>
          </div>

          <ul class="contact-lines">
            <li data-deal>
              <a
                class="contact-line"
                data-contact-line="operating"
                data-route-label="OPERATING // AVAILABLE NOW"
                href="#contact-form"
              >
                <span class="contact-line-marker contact-line-marker--operating" aria-hidden="true"></span>
                <span class="contact-line-copy">
                  <span class="contact-line-status">OPERATING // AVAILABLE NOW</span>
                  <h3>Producer infrastructure.</h3>
                  <p>Case design, product positioning, federal benefits, suitability, or IMO operating support.</p>
                </span>
                <span class="contact-line-action"><strong>Choose this line →</strong></span>
              </a>
            </li>

            <li data-deal style="--deal-delay: 90ms">
              <a
                class="contact-line"
                data-contact-line="sp-plus"
                data-route-label="ACTIVE // FIT REVIEW"
                href="#contact-form"
              >
                <span class="contact-line-marker contact-line-marker--active" aria-hidden="true"></span>
                <span class="contact-line-copy">
                  <span class="contact-line-status">ACTIVE // FIT REVIEW</span>
                  <h3>SP+.</h3>
                  <p>Review operating fit, five-contract qualification, hardware compatibility, installation scope, and support expectations.</p>
                </span>
                <span class="contact-line-action"><strong>Choose this line →</strong></span>
              </a>
            </li>

            <li data-deal style="--deal-delay: 180ms">
              <a
                class="contact-line"
                data-contact-line="prospective"
                data-route-label="PROSPECTIVE // EMERGING"
                href="#contact-form"
              >
                <span class="contact-line-marker contact-line-marker--prospective" aria-hidden="true"></span>
                <span class="contact-line-copy">
                  <span class="contact-line-status">PROSPECTIVE // EMERGING</span>
                  <h3>AI-native transformation.</h3>
                  <p>For operators following the method as it earns external application through delivered evidence.</p>
                </span>
                <span class="contact-line-action"><strong>Choose this line →</strong></span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section class="contact-form-section" aria-labelledby="contact-form-title">
      <div class="shell">
        <div class="contact-form-frame" data-deal>
          <div class="contact-form-head">
            <span>FILE // SEND</span>
            <span class="contact-form-head-mark" aria-hidden="true"></span>
          </div>

          <div class="contact-form-grid">
            <div class="contact-form-intro">
              <h2 id="contact-form-title">Send it here.</h2>
              <p>
                Tell us which line you are on and what you are working with. Christopher reads
                every one of these himself and answers from
                <a href="mailto:info@secureprospective.com">info@secureprospective.com</a>.
              </p>
              <p class="contact-form-note">
                Prefer your own mail client? Write to
                <a href="mailto:info@secureprospective.com">info@secureprospective.com</a> directly.
              </p>
              <p class="contact-form-note">
                What you send is stored so we can answer it, and it is not sold or used for
                advertising. The <a href="/privacy">privacy policy</a> says exactly what we keep
                and how to have it removed.
              </p>
            </div>

            <form class="contact-form" id="contact-form" data-contact-form novalidate>
              <div class="contact-field">
                <label for="cf-name">Name<span class="contact-field-required" aria-hidden="true">required</span></label>
                <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="120" />
              </div>

              <div class="contact-field">
                <label for="cf-email">Email<span class="contact-field-required" aria-hidden="true">required</span></label>
                <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="200" />
              </div>

              <div class="contact-field contact-field--wide">
                <label for="cf-route">Line<span class="contact-field-required" aria-hidden="true">required</span></label>
                <select id="cf-route" name="route" required>
                  <option value="operating">Producer infrastructure</option>
                  <option value="sp-plus">SP+ fit review</option>
                  <option value="prospective">AI-native transformation</option>
                </select>
              </div>

              <div class="contact-field contact-field--wide">
                <label for="cf-message">What are you working with?</label>
                <textarea id="cf-message" name="message" rows="5" maxlength="4000"></textarea>
              </div>

              <div class="contact-field contact-field--wide">
                <div class="cf-turnstile" data-sitekey={siteKey} data-turnstile-slot></div>
                <!--
                  The spam check is a third-party script, so it can fail to arrive:
                  a blocked domain, a privacy extension, a flat network. Without this
                  the form would refuse every submission and say only that the check
                  had not finished, which is a dead end the visitor cannot act on.
                -->
                <p class="contact-form-fallback" data-turnstile-fallback hidden>
                  The spam check could not load, so this form cannot send. Email your
                  message to <a href="mailto:info@secureprospective.com">info@secureprospective.com</a>
                  instead and it will reach the same place.
                </p>
              </div>

              <p class="contact-form-status" data-contact-status role="status" aria-live="polite" hidden></p>

              <button type="submit" class="contact-form-submit" data-contact-submit>
                Send it
                <span class="contact-form-submit-mark" aria-hidden="true"></span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>

<script>
  import '../scripts/motion.js';
  import '../scripts/pages/contact.js';
  import '../scripts/pages/contact-form.js';
</script>
