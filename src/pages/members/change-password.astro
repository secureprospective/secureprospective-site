---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Set Your Password — SecureProspective Back Office">
  <main class="auth-shell">
    <div class="auth-card">
      <p class="eyebrow">Back Office</p>
      <h1>Set a new password</h1>
      <p class="auth-sub" id="reason-copy">You're using a temporary password. Choose a new one to continue.</p>

      <form id="change-form" novalidate>
        <label class="field">
          <span>Current password</span>
          <input type="password" name="currentPassword" autocomplete="current-password" required />
        </label>
        <label class="field">
          <span>New password</span>
          <input type="password" name="newPassword" autocomplete="new-password" minlength="8" required />
        </label>
        <label class="field">
          <span>Confirm new password</span>
          <input type="password" name="newPasswordConfirm" autocomplete="new-password" minlength="8" required />
        </label>

        <p id="form-error" class="form-error" role="alert" hidden></p>

        <button type="submit" class="btn" id="submit-btn">Save new password</button>
      </form>
    </div>
  </main>
</Layout>

<script>
  const form = document.getElementById('change-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const errorEl = document.getElementById('form-error') as HTMLParagraphElement | null;
  const reasonEl = document.getElementById('reason-copy') as HTMLParagraphElement | null;

  function showError(message: string) {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.hidden = false;
  }

  function hideError() {
    if (!errorEl) return;
    errorEl.hidden = true;
  }

  async function init() {
    try {
      const res = await fetch('/api/auth/me');
      if (!res.ok) {
        window.location.href = '/members/login';
        return;
      }
      const body = await res.json();
      if (!body.user?.mustChangePassword && reasonEl) {
        reasonEl.textContent = 'Change your password below.';
      }
    } catch {
      window.location.href = '/members/login';
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError();

    const data = new FormData(form);
    const currentPassword = String(data.get('currentPassword') ?? '');
    const newPassword = String(data.get('newPassword') ?? '');
    const newPasswordConfirm = String(data.get('newPasswordConfirm') ?? '');

    if (newPassword.length < 8) {
      showError('New password must be at least 8 characters.');
      return;
    }
    if (newPassword !== newPasswordConfirm) {
      showError('New passwords do not match.');
      return;
    }

    submitBtn?.classList.add('is-loading');
    submitBtn?.setAttribute('disabled', 'true');

    try {
      const res = await fetch('/api/auth/change-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ currentPassword, newPassword }),
      });
      const body = await res.json();

      if (!res.ok) {
        showError(body.error ?? 'Could not update your password.');
        return;
      }

      window.location.href = '/members';
    } catch {
      showError('Something went wrong. Please try again.');
    } finally {
      submitBtn?.classList.remove('is-loading');
      submitBtn?.removeAttribute('disabled');
    }
  });

  init();
</script>

<style>
  .auth-shell {
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6) var(--space-4);
  }

  .auth-card {
    width: 100%;
    max-width: 420px;
    background: var(--white);
    border: 2px solid var(--ink);
    padding: var(--space-6);
  }

  .auth-card h1 {
    font-size: var(--text-h2);
    margin-bottom: var(--space-2);
  }

  .auth-sub {
    color: var(--fineprint-gray);
    font-size: var(--text-caption);
    margin-bottom: var(--space-5);
  }

  .field {
    display: block;
    margin-bottom: var(--space-4);
  }

  .field span {
    display: block;
    font-size: var(--text-caption);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-2);
  }

  .field input {
    width: 100%;
    padding: var(--space-3);
    border: 2px solid var(--ink);
    border-radius: var(--radius-default);
    font-family: var(--font-body);
    font-size: var(--text-body);
    background: var(--white);
    color: var(--ink);
  }

  .field input:focus-visible {
    outline: 2px solid var(--blue-brand);
    outline-offset: 2px;
  }

  .form-error {
    color: #B3261E;
    font-size: var(--text-caption);
    margin-bottom: var(--space-4);
  }

  #submit-btn {
    width: 100%;
    text-align: center;
  }
</style>
