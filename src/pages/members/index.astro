---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Back Office — SecureProspective">
  <main class="gate-shell" id="gate-shell" hidden>
    <div class="gate-card">
      <p class="eyebrow">Signed in as <span id="user-email"></span></p>
      <h1>Back office</h1>
      <p class="gate-copy">
        Everything we have released is here. Right now that means SP+.
      </p>
      <div class="gate-actions">
        <a href="/members/download" class="btn btn--wide">Download SP+</a>
      </div>
      <div class="gate-actions gate-actions--secondary">
        <a href="/members/admin" class="btn" id="admin-link" hidden>Admin console</a>
        <button type="button" class="btn btn--ink" id="logout-btn">Sign out</button>
      </div>
    </div>
  </main>
</Layout>

<script>
  // The Claude Agent Kit card and the Google connection off-switch card were
  // removed 2026-09-04 (Christopher): the kit wizard and its Google
  // provisioning are retired projects. Their routes are gone with them, so
  // leaving the buttons would have left two controls that 404. What remains
  // in the back office is the SP+ download and, for admins, the console.
  const shell = document.getElementById('gate-shell') as HTMLElement | null;
  const emailEl = document.getElementById('user-email') as HTMLElement | null;
  const adminLink = document.getElementById('admin-link') as HTMLAnchorElement | null;
  const logoutBtn = document.getElementById('logout-btn') as HTMLButtonElement | null;

  async function checkSession() {
    try {
      const res = await fetch('/api/auth/me');
      if (!res.ok) {
        window.location.href = '/members/login';
        return;
      }
      const body = await res.json();
      if (body.user?.mustChangePassword) {
        window.location.href = '/members/change-password';
        return;
      }
      if (emailEl) emailEl.textContent = body.user?.email ?? '';
      if (adminLink && body.user?.role === 'admin') adminLink.hidden = false;
      if (shell) shell.hidden = false;
    } catch {
      window.location.href = '/members/login';
    }
  }

  logoutBtn?.addEventListener('click', async () => {
    logoutBtn.setAttribute('disabled', 'true');
    try {
      await fetch('/api/auth/logout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
      });
    } finally {
      window.location.href = '/members/login';
    }
  });

  checkSession();
</script>

<style>
  .gate-shell {
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6) var(--space-4);
  }

  .gate-card {
    width: 100%;
    max-width: 480px;
    text-align: center;
    background: var(--white);
    border: 2px solid var(--ink);
    padding: var(--space-7) var(--space-6);
  }

  .gate-card .eyebrow {
    margin-bottom: var(--space-2);
  }

  .gate-card h1 {
    font-size: var(--text-h1);
    margin-bottom: var(--space-3);
  }

  .gate-copy {
    color: var(--fineprint-gray);
    margin-bottom: var(--space-5);
  }

  /* One primary action on this card. A default-width button floating in the
     middle of a 480px card reads as unfinished; a full-width one reads as
     the point of the page, which it is. */
  .btn--wide {
    display: block;
    width: 100%;
  }

  .gate-actions {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
  }

  .gate-actions--secondary {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--fineprint-gray);
  }
</style>
