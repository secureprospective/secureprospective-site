---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Back Office — SecureProspective">
  <main class="gate-shell" id="gate-shell" hidden>
    <div class="gate-card">
      <p class="eyebrow">Back Office</p>
      <h1>Claude Agent Kit</h1>
      <p class="gate-copy">
        You're signed in as <strong id="user-email"></strong>. Set up your Claude assistant, or
        come back later to add more to it.
      </p>
      <div class="gate-actions">
        <a href="/api/wizard/bridge" class="btn">Get Started</a>
        <button type="button" class="btn btn--ink" disabled title="Coming soon — this is where you'll add more components later.">Update</button>
      </div>
      <div class="gate-actions gate-actions--secondary">
        <a href="/members/admin" class="btn" id="admin-link" hidden>Admin console</a>
        <button type="button" class="btn btn--ink" id="logout-btn">Sign out</button>
      </div>
    </div>

    <!--
      R6(b): the standing off-switch control. Was a one-time rehearsal
      inside the wizard's last screen (FireDrillStep.jsx) — Christopher,
      2026-08-09: "They don't need to practice, they just need the ability
      to turn off and on." Reuses the monopoly-property-card visual
      language (colored band, sharp corners, collapsible) already built
      for StateLicenseSelect.jsx rather than a new pattern. Hidden until
      capability-state.ts confirms there's a real install to show a
      control for.
    -->
    <div class="property-card" id="control-card" hidden>
      <button type="button" class="property-card__band" id="control-toggle" aria-expanded="false">
        <span class="property-card__title">Your Claude connection</span>
        <span class="property-card__caret" aria-hidden="true">▾</span>
      </button>
      <div class="property-card__body" id="control-body" hidden>
        <p id="control-summary"></p>
        <div class="property-card__actions" id="control-actions"></div>
      </div>
    </div>
  </main>
</Layout>

<script>
  const shell = document.getElementById('gate-shell') as HTMLElement | null;
  const emailEl = document.getElementById('user-email') as HTMLElement | null;
  const adminLink = document.getElementById('admin-link') as HTMLAnchorElement | null;
  const logoutBtn = document.getElementById('logout-btn') as HTMLButtonElement | null;

  async function checkSession() {
    try {
      const res = await fetch('/api/auth/me');
      if (!res.ok) {
        window.location.href = '/members/login';
        return;
      }
      const body = await res.json();
      if (body.user?.mustChangePassword) {
        window.location.href = '/members/change-password';
        return;
      }
      if (emailEl) emailEl.textContent = body.user?.email ?? '';
      if (adminLink && body.user?.role === 'admin') adminLink.hidden = false;
      if (shell) shell.hidden = false;
    } catch {
      window.location.href = '/members/login';
    }
  }

  logoutBtn?.addEventListener('click', async () => {
    logoutBtn.setAttribute('disabled', 'true');
    try {
      await fetch('/api/auth/logout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
      });
    } finally {
      window.location.href = '/members/login';
    }
  });

  checkSession();

  // R6(b): the standing off-switch card.
  const controlCard = document.getElementById('control-card') as HTMLElement | null;
  const controlToggle = document.getElementById('control-toggle') as HTMLButtonElement | null;
  const controlBody = document.getElementById('control-body') as HTMLElement | null;
  const controlSummary = document.getElementById('control-summary') as HTMLElement | null;
  const controlActions = document.getElementById('control-actions') as HTMLElement | null;

  const STORAGE_LABELS: Record<string, string> = {
    drive: 'Google Drive (SecureProspective-managed folder)',
    local: 'A local folder on his computer',
  };

  function renderControl(state: any) {
    if (!controlCard || !controlSummary || !controlActions) return;
    if (!state.started) {
      controlCard.hidden = true;
      return;
    }
    controlCard.hidden = false;

    const storageLabel = STORAGE_LABELS[state.storageLocation ?? ''] ?? 'Not chosen yet';
    const connectors = [
      state.gmailConnected ? 'Gmail' : null,
      state.calendarConnected ? 'Calendar' : null,
    ].filter(Boolean);

    controlSummary.textContent =
      `Storage: ${storageLabel}.` +
      (connectors.length ? ` Connected: ${connectors.join(', ')}.` : '');

    controlActions.innerHTML = '';

    if (state.storageLocation === 'drive' && state.driveScope === 'scoped') {
      // Only the scoped OAuth path gives SecureProspective a grant of its
      // own to control — this is the one case the card can turn on/off.
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'btn';
      if (state.googleGrantActive) {
        btn.textContent = 'Turn off';
        btn.addEventListener('click', async () => {
          btn.setAttribute('disabled', 'true');
          btn.textContent = 'Turning off…';
          try {
            const res = await fetch('/api/wizard/capability-toggle', { method: 'POST' });
            if (res.ok) await loadControl();
          } finally {
            btn.removeAttribute('disabled');
          }
        });
      } else {
        btn.textContent = 'Reconnect';
        btn.addEventListener('click', () => {
          window.location.href = '/api/wizard/bridge?next=/api/google/oauth/start';
        });
      }
      controlActions.appendChild(btn);
    } else if (state.storageLocation) {
      // Native connector / local folder: SecureProspective never held a
      // grant here, so there is nothing of ours to toggle. Say that
      // honestly and point at the control that actually exists — his own
      // Claude connection — rather than offering a button that would do
      // nothing.
      const note = document.createElement('p');
      note.className = 'property-card__note';
      note.textContent =
        'This install doesn’t use a SecureProspective-managed connection — turn Claude itself on or off from Google’s own connections page.';
      controlActions.appendChild(note);
      const link = document.createElement('a');
      link.className = 'btn btn--ink';
      link.href = 'https://myaccount.google.com/connections';
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = 'Open Google connections →';
      controlActions.appendChild(link);
    }
  }

  async function loadControl() {
    try {
      const res = await fetch('/api/wizard/capability-state');
      if (!res.ok) {
        if (controlCard) controlCard.hidden = true;
        return;
      }
      renderControl(await res.json());
    } catch {
      if (controlCard) controlCard.hidden = true;
    }
  }

  controlToggle?.addEventListener('click', () => {
    const expanded = controlToggle.getAttribute('aria-expanded') === 'true';
    controlToggle.setAttribute('aria-expanded', String(!expanded));
    if (controlBody) controlBody.hidden = expanded;
  });

  loadControl();
</script>

<style>
  .gate-shell {
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6) var(--space-4);
  }

  .gate-card {
    width: 100%;
    max-width: 480px;
    text-align: center;
    background: var(--white);
    border: 2px solid var(--ink);
    padding: var(--space-7) var(--space-6);
  }

  .gate-card h1 {
    font-size: var(--text-h1);
    margin-bottom: var(--space-4);
  }

  .gate-copy {
    color: var(--fineprint-gray);
    margin-bottom: var(--space-5);
  }

  .gate-actions {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
  }

  .gate-actions--secondary {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--fineprint-gray);
  }

  .gate-actions button[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* R6(b): the standing off-switch card — same monopoly-property-card
     language as StateLicenseSelect.jsx's region groups (colored band,
     sharp corners, expand/collapse), not a new visual pattern. */
  .property-card {
    width: 100%;
    max-width: 480px;
    margin: var(--space-5) auto 0;
    border: 2px solid var(--ink);
    background: var(--white);
  }

  .property-card__band {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--blue-brand);
    color: var(--white);
    border: none;
    cursor: pointer;
    font: inherit;
    text-align: left;
  }

  .property-card__title {
    font-weight: 600;
  }

  .property-card__caret {
    transition: transform 120ms ease;
  }

  .property-card__band[aria-expanded='true'] .property-card__caret {
    transform: rotate(180deg);
  }

  .property-card__body {
    padding: var(--space-4);
    text-align: left;
  }

  .property-card__note {
    color: var(--fineprint-gray);
    margin-bottom: var(--space-3);
  }

  .property-card__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }
</style>
