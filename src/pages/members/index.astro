---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import HeroTicker from '../../components/HeroTicker.astro';
---

<Layout title="Back Office: SecureProspective" description="Invite-only access to the SecureProspective back office." noindex>
  <Nav />
  <main class="gate-shell" id="main" hidden>
    <!--
      The home page's ticker, reused rather than reinvented. It sits behind
      the card as a field, not an entrance -- same component, same pause
      behaviour when the tab is hidden or the user asks for reduced motion.
    -->
    <HeroTicker />
    <div class="gate-card">
      <p class="eyebrow">Back Office</p>
      <!--
        "SecureProspective" is one unbreakable 17-character word. At h1 size
        it runs past the edge of a 480px card, and there is no space in it
        for the browser to wrap on. Splitting it into two block spans is the
        fix: the break is deliberate and identical at every width, rather
        than something that happens to hold at one screen size.
      -->
      <h1 class="gate-title"><span>Secure</span><span>Prospective</span></h1>
      <p class="gate-copy">
        Signed in as <strong id="user-email"></strong>. Everything we have released is
        here. Right now that means SP+.
      </p>
      <div class="gate-actions">
        <a href="/members/download" class="btn btn--wide">Download SP+</a>
      </div>
      <!--
        The reference document. It sits under the download rather than beside
        it because the order is the point: most people read before they install,
        and the ones who came here to install should not have to step past a
        second primary button to do it.
      -->
      <div class="gate-actions">
        <a href="/members/inside-sp-plus" class="btn btn--ink btn--wide">Read Inside SP+</a>
      </div>
      <p class="gate-footnote">
        The full account of what SP+ protects, how each protection was measured, and where it
        stops. Written to be read before you install, and yours to hand on.
      </p>
      <!--
        The same product, one level down. Inside SP+ is written for the advisor
        who will use the machine; this one is written for whoever they ask to
        check it. Outlined rather than filled, because it is the third thing on
        this card and should not compete with the two above it.
      -->
      <div class="gate-actions">
        <a href="/members/sp-plus-security-architecture" class="btn btn--outline btn--wide">
          Read the security architecture
        </a>
      </div>
      <p class="gate-footnote">
        For the technical reader. Trust anchors, threat model, every control measured on a
        booted machine, and the register of our own checks that measured nothing.
      </p>
      <div class="gate-actions gate-actions--secondary">
        <a href="/members/admin" class="btn" id="admin-link" hidden>Admin console</a>
        <button type="button" class="btn btn--ink" id="logout-btn">Sign out</button>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  // The Claude Agent Kit card and the Google connection off-switch card were
  // removed 2026-09-04 (Christopher): the kit wizard and its Google
  // provisioning are retired projects. Their routes are gone with them, so
  // leaving the buttons would have left two controls that 404. What remains
  // in the back office is the SP+ download and, for admins, the console.
  const shell = document.getElementById('main') as HTMLElement | null;
  const emailEl = document.getElementById('user-email') as HTMLElement | null;
  const adminLink = document.getElementById('admin-link') as HTMLAnchorElement | null;
  const logoutBtn = document.getElementById('logout-btn') as HTMLButtonElement | null;

  async function checkSession() {
    try {
      const res = await fetch('/api/auth/me');
      if (!res.ok) {
        window.location.href = '/members/login';
        return;
      }
      const body = await res.json();
      if (body.user?.mustChangePassword) {
        window.location.href = '/members/change-password';
        return;
      }
      if (emailEl) emailEl.textContent = body.user?.email ?? '';
      if (adminLink && body.user?.role === 'admin') adminLink.hidden = false;
      if (shell) shell.hidden = false;
    } catch {
      window.location.href = '/members/login';
    }
  }

  logoutBtn?.addEventListener('click', async () => {
    logoutBtn.setAttribute('disabled', 'true');
    try {
      await fetch('/api/auth/logout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
      });
    } finally {
      window.location.href = '/members/login';
    }
  });

  checkSession();
</script>

<style>
  .gate-shell {
    position: relative;
    overflow: hidden;
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6) var(--space-4);
    background: var(--silver-base);
  }

  /* The ticker canvas measures its parent, so the shell has to be the
     positioned box and the card has to be lifted above it. Both rules earn
     their place -- without the first the canvas collapses to zero height,
     without the second the field draws over the card. */
  .gate-shell :global(.identity-hero-fx) {
    z-index: 0;
  }

  .gate-card {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 480px;
    text-align: center;
    background: var(--white);
    border: 2px solid var(--ink);
    padding: var(--space-7) var(--space-6);
  }

  .gate-card .eyebrow {
    margin-bottom: var(--space-2);
  }

  .gate-title {
    /* Clamped rather than fixed: "Prospective" is the long line, and this
       keeps it inside the card from a narrow phone up to the full width. */
    font-size: clamp(30px, 8vw, 46px);
    line-height: 1.02;
    margin-bottom: var(--space-3);
  }

  .gate-title span {
    display: block;
  }

  .gate-copy {
    color: var(--fineprint-gray);
    margin-bottom: var(--space-5);
  }

  /* Two stacked full-width buttons need air between them, and the document
     needs one line saying what it is, or it reads as a duplicate download. */
  .gate-actions + .gate-actions {
    margin-top: var(--space-3);
  }

  .gate-footnote {
    margin: var(--space-3) 0 0;
    color: var(--fineprint-gray);
    font-size: var(--text-caption);
    line-height: 1.5;
  }

  .gate-footnote + .gate-actions {
    margin-top: var(--space-4);
  }

  /* Three stacked actions need three weights or the card reads as a pile.
     Yellow for the download, ink for the document the member is meant to read,
     outline for the one aimed past them at their technical reviewer. Scoped
     here rather than added to site.css: an earlier global .btn--outline was
     removed from this codebase, and one card is not reason enough to bring a
     fourth button variant back sitewide. */
  .btn--outline {
    background: transparent;
    color: var(--ink);
  }

  .btn--outline:hover,
  .btn--outline:focus-visible {
    background: var(--ink);
    color: var(--white);
  }

  /* One primary action on this card. A default-width button floating in the
     middle of a 480px card reads as unfinished; a full-width one reads as
     the point of the page, which it is. */
  .btn--wide {
    display: block;
    width: 100%;
  }

  .gate-actions {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
  }

  .gate-actions--secondary {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--fineprint-gray);
  }
</style>
