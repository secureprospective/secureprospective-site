<script>
  // The document is written to be printed and handed over, so the button is
  // part of it. Bound on every view transition, because Astro swaps the body
  // and a listener bound once would survive only the first page.
  function bindPrint() {
    const btn = document.getElementById('print-btn');
    if (!btn || btn.dataset.bound) return;
    btn.dataset.bound = 'true';
    btn.addEventListener('click', () => window.print());
  }

  document.addEventListener('astro:page-load', bindPrint);
  bindPrint();
</script>
