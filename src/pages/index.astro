---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import MethodWidget from '../components/MethodWidget.astro';
---

<Layout title="SecureProspective: Make AI native. Drop the prefix.">
  <Nav />

  <main>
    {/* ───────────────────────── HERO ───────────────────────── */}
    <section class="hero">
      <div class="hero-fx" aria-hidden="true">
        <canvas id="hero-fx-canvas" data-hero-fx></canvas>
      </div>
      <div class="container hero-inner">
        <h1 class="hero-title">
          <span class="line-mask"><span class="line-inner">Make AI native.</span></span>
          <span class="line-mask"><span class="line-inner">Drop the <span class="prefix-chip">prefix.</span></span></span>
        </h1>
        <p class="hero-sub">
          We make businesses AI-native: diagnose the bottleneck, position the tool,
          shape the output for ownership.
        </p>
        <a href="/the-method" id="see-method-btn" class="btn">See the method &rarr;</a>
      </div>
    </section>

    {/* ───────────────────── PROOF TEASERS ───────────────────── */}
    <section class="proof-teasers">
      <div class="container">
        <div class="eyebrow eyebrow--white">The Work</div>

        <div class="teasers animate-group">
          <article class="teaser animate-item">
            <div class="teaser-meta">DATA_RECORD // 001</div>
            <h3 class="teaser-title">TFM: Client #1</h3>
            <p class="teaser-desc">
              Tech Freedom Ministries, a faith-backed digital freedom nonprofit. Built the
              digital infrastructure, brand system, and live site. The method's first
              external application.
            </p>
          </article>
          <article class="teaser animate-item">
            <div class="teaser-meta">DATA_RECORD // 002</div>
            <h3 class="teaser-title">The IMO</h3>
            <p class="teaser-desc">
              We operated inside an IMO for six years, the traditional way. ~$110M in
              annuity production, ~$18M/yr current volume. Now we're rebuilding that same
              business AI-native, live. The method's first real adaptation, happening
              in real time.
            </p>
          </article>
        </div>
      </div>
    </section>

    {/* ───────────────────── OPERATOR TEASER ───────────────────── */}
    <section class="operator-teaser">
      <div class="container operator-inner animate-in">
        <p class="operator-quote">
          Three careers. One spine. Built it before consulting it.
        </p>
        <p class="operator-sub">
          Fifteen years electrical. Twenty-six years technology. Insurance, annuity, and
          IMO leadership. The four-movement method wasn't invented in a deck.
        </p>
        <a href="/the-operator" class="btn btn--outline">Meet the operator &rarr;</a>
      </div>
    </section>

    {/* ───────────────────── LOOP-CLOSER ───────────────────── */}
    <section class="loop-closer">
      <div class="container loop-inner animate-in">
        <p class="loop-line">What's native today gets re-diagnosed tomorrow.</p>
        <p class="loop-sub">
          The loop doesn't end. Your business just stops being the bottleneck.
        </p>
        <a href="/contact" class="btn">Start with a conversation &rarr;</a>
      </div>
    </section>
  </main>

  <Footer />
  <MethodWidget />
</Layout>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--silver-base);
    border-bottom: 2px solid var(--ink);
    padding: var(--space-8) 0;
  }
  .hero-fx {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.3;
  }
  .hero-fx canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }
  .hero-title {
    font-size: var(--text-display);
    line-height: 1;
    letter-spacing: -0.02em;
    max-width: 900px;
  }
  .hero-title .prefix-chip {
    background: var(--yellow-accent);
    padding: 0 8px;
  }
  .hero-title .line-mask {
    display: block;
    overflow: hidden;
  }
  .hero-title .line-inner {
    display: block;
    transform: translateY(110%);
    letter-spacing: 0.06em;
    animation: hero-title-reveal 550ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .hero-title .line-mask:nth-child(2) .line-inner {
    animation-delay: 90ms;
  }
  @keyframes hero-title-reveal {
    to {
      transform: translateY(0);
      letter-spacing: -0.02em;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-title .line-inner {
      animation: none;
      transform: translateY(0);
      letter-spacing: -0.02em;
    }
  }
  .hero-sub {
    font-size: var(--text-body-lg);
    max-width: 680px;
    line-height: 1.5;
    color: var(--ink);
  }

  /* ── Proof teasers ── */
  .proof-teasers {
    background: var(--blue-brand);
    border-bottom: 2px solid var(--ink);
    padding: var(--space-7) 0;
  }
  .eyebrow--white {
    color: var(--white);
  }
  .teasers {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }
  .teaser {
    background: var(--white);
    padding: var(--space-5);
    border: 1px solid var(--ink);
    /* ink offset, not the usual brand-blue: this card sits on a blue-brand
       section, and a blue shadow disappears against a blue backdrop */
    box-shadow: 6px 6px 0 rgba(34, 34, 34, 0.35);
    transition: border-color 120ms ease-out, box-shadow 120ms ease-out, transform 120ms ease-out;
  }
  .teaser:hover {
    border-color: var(--yellow-accent);
    box-shadow: 8px 8px 0 rgba(34, 34, 34, 0.45);
    transform: translate(-2px, -2px);
  }
  .teaser-meta {
    font-family: var(--font-display);
    font-size: 11px;
    color: var(--ink);
    opacity: 0.6;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-3);
  }
  .teaser-title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    text-transform: uppercase;
    margin-bottom: var(--space-3);
    letter-spacing: -0.01em;
  }
  .teaser-desc {
    font-size: var(--text-caption);
    line-height: 1.6;
  }

  /* ── Operator teaser ── */
  .operator-teaser {
    background: var(--ink);
    color: var(--ink-inverted);
    padding: var(--space-7) 0;
  }
  .operator-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
  }
  .operator-quote {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    text-transform: uppercase;
    color: var(--white);
    line-height: 1.1;
    max-width: 1000px;
  }
  .operator-sub {
    font-size: var(--text-body-lg);
    color: var(--white);
    opacity: 0.85;
    max-width: 820px;
  }

  /* ── Loop-closer ── */
  .loop-closer {
    background: var(--blue-brand);
    padding: var(--space-6) 0;
  }
  .loop-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: flex-start;
  }
  .loop-line {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    text-transform: uppercase;
    color: var(--white);
  }
  .loop-sub {
    font-size: var(--text-body);
    color: var(--white);
    opacity: 0.85;
    margin-bottom: var(--space-3);
  }

  /* ── Responsive ── */
  @media (max-width: 767px) {
    .hero-title {
      font-size: 48px;
    }
    .operator-quote {
      font-size: var(--text-h2);
    }
    .teasers {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Hero background: procedural honeycomb grid with a traveling brightness wave
  // and occasional bright "arc" cells, evoking a faint electrical pulse.
  (function () {
    var canvas = document.getElementById('hero-fx-canvas');
    if (!canvas) return;

    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var ctx = canvas.getContext('2d');
    var raf = null;
    var running = false;
    var t = 0;
    var speed = 2;

    function resize() {
      var rect = canvas.parentElement.getBoundingClientRect();
      canvas.width = Math.max(1, Math.round(rect.width * devicePixelRatio));
      canvas.height = Math.max(1, Math.round(rect.height * devicePixelRatio));
    }

    function draw() {
      var w = canvas.width, h = canvas.height;
      if (!w || !h) return;
      ctx.clearRect(0, 0, w, h);
      var r = 40 * devicePixelRatio;
      var hexW = r * Math.sqrt(3);
      var hexH = r * 2;
      var rowH = hexH * 0.75;
      var cols = Math.ceil(w / hexW) + 2;
      var rows = Math.ceil(h / rowH) + 2;
      var blue = '0, 51, 160';
      var yellow = '255, 215, 0';

      for (var row = -1; row < rows; row++) {
        for (var col = -1; col < cols; col++) {
          var x = col * hexW + (row % 2 !== 0 ? hexW / 2 : 0);
          var y = row * rowH;
          var wave = Math.sin((x / w) * Math.PI * 2 * 1.5 - t * speed) * 0.5 + 0.5;
          var brightness = 0.12 + wave * 0.35;
          ctx.beginPath();
          for (var i = 0; i < 6; i++) {
            var angle = (Math.PI / 180) * (60 * i - 30);
            var px = x + r * Math.cos(angle);
            var py = y + r * Math.sin(angle);
            if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
          }
          ctx.closePath();
          var isArc = wave > 0.92;
          ctx.strokeStyle = isArc
            ? 'rgba(' + yellow + ', ' + Math.min(1, brightness + 0.4).toFixed(2) + ')'
            : 'rgba(' + blue + ', ' + brightness.toFixed(2) + ')';
          ctx.lineWidth = isArc ? 2 * devicePixelRatio : 1 * devicePixelRatio;
          ctx.stroke();
        }
      }
      t += 0.012;
    }

    function loop() {
      if (!running) return;
      draw();
      raf = requestAnimationFrame(loop);
    }

    function start() {
      if (running) return;
      resize();
      running = true;
      if (reduceMotion) { draw(); running = false; return; }
      loop();
    }

    function stop() {
      running = false;
      if (raf) cancelAnimationFrame(raf);
    }

    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting && canvas.offsetWidth > 0) start();
        else stop();
      });
    }, { threshold: 0.05 });
    io.observe(canvas);

    window.addEventListener('resize', function () {
      if (running) resize();
    });

    if (canvas.offsetWidth > 0) start();
  })();
</script>
