---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HeroTicker from '../components/HeroTicker.astro';
import '../styles/pages/home.css';
---

<Layout title="SecureProspective: an IMO run by a producing agent" description="An independent marketing organization run by an agent who still writes business. Annuity and life wholesale, case design, and suitability for active producers.">
  <Nav />

  <main id="main" class="home-page" transition:name="page-card">
    <!--
      The Operating Deck turns the homepage into one legible instrument. The
      opening plane holds identity, the operating argument, and SP+ at once.
      Later planes move from method to evidence to access without hiding the
      reader's scroll position or replacing the site's Property Card System.
    -->
    <section class="identity-hero" aria-labelledby="identity-title">
      <HeroTicker />

      <div class="identity-lockup">
        <header class="home-identity-bar">
          <div class="home-identity-copy">
            <p class="identity-kicker">Operator to operator</p>
            <p class="identity-mark" data-stamp>SecureProspective</p>
            <p class="pronunciation">/sɪˈkjʊr//prəˈspek.tɪv/</p>
          </div>

          <div class="home-operating-state" aria-label="Current operating state">
            <span>STATE // OPERATING</span>
            <strong>REVENUE ACTIVE</strong>
          </div>
        </header>

        <div class="home-opening-grid">
          <a class="hero-sp-plus" href="/the-work" aria-label="Explore SP+, the safer advisor workstation">
            <span>SP+ // ALPHA RELEASED</span>
            <strong>The safer advisor workstation.</strong>
            <small>The workstation installs and runs today. The advisor layer on top of it, the assistance and the workflow, is still in build.</small>
            <b>Explore SP+ <span aria-hidden="true">→</span></b>
          </a>

          <article class="truth-card">
            <div class="truth-card-body">
              <h1 id="identity-title">
                Most of what an advisor is sold was never used by the people selling it.
              </h1>

              <div class="truth-columns">
                <p class="truth-lede">
                  The pitch has not changed in twenty-five years. More products, more leads,
                  more tools, more training, more scale. Bring your license, bring your
                  ambition. Then Tuesday morning arrives, you have a case in front of you,
                  and there is nobody to ask.
                </p>

                <p class="truth-answer">
                  Christopher Campbell still writes business with real clients, and has spent
                  eight years inside IMOs and financial advisor offices. SecureProspective is
                  the operation he runs: annuity and life-insurance wholesale, producer
                  development, case design, suitability, and infrastructure for active agents.
                  A broad promise is not an operating model.
                </p>
              </div>

              <a href="/services" class="action action--light home-action home-action--light">
                Enter the operation <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="method-spine shell" data-deal aria-labelledby="method-title">
      <div class="spine-copy">
        <h2 id="method-title">One operation. Five movements.</h2>
        <p>
          The method is not a consulting product sitting above the business. It is the discipline
          being applied inside it. Every claim moves through an evidence gate.
        </p>
      </div>

      <ol class="spine-steps">
        <li><span>01</span><strong>Diagnose</strong><small>Find the real constraint.</small></li>
        <li><span>02</span><strong>Position</strong><small>Place the right tool.</small></li>
        <li><span>03</span><strong>Shape</strong><small>Make output ownable.</small></li>
        <li><span>04</span><strong>Transform</strong><small>Change the operation.</small></li>
        <li><span>↺</span><strong>Re-diagnose</strong><small>Secure the next state.</small></li>
      </ol>

      <a href="/the-method" class="text-link home-text-link">Read the operating method →</a>
    </section>

    <section class="proof-register" aria-labelledby="proof-title">
      <div class="shell proof-register-grid">
        <div class="proof-register-title" data-deal>
          <h2 id="proof-title">The register claims only what the record holds.</h2>
        </div>

        <div class="proof-lines" aria-label="Operating evidence register">
          <a href="/services#operating-record" class="proof-line" data-deal>
            <span class="proof-status proof-status--proven">Proven</span>
            <strong>The IMO operating record</strong>
            <small>Revenue, producers, production, responsibility.</small>
            <span aria-hidden="true">01</span>
          </a>
          <a href="/the-work" class="proof-line" data-deal>
            <span class="proof-status proof-status--active">Alpha</span>
            <strong>SP+ first deliverable</strong>
            <small>The workstation is released and installable. The advisor layer is in build.</small>
            <span aria-hidden="true">02</span>
          </a>
          <a href="/the-work#access" class="proof-line" data-deal>
            <span class="proof-status proof-status--active">Available</span>
            <strong>SP+ partnership access</strong>
            <small>Qualify through five production contracts. No software fee, no subscription.</small>
            <span aria-hidden="true">03</span>
          </a>
          <div class="proof-line proof-line--future" data-deal>
            <span class="proof-status">Prospective</span>
            <strong>AI-native transformation</strong>
            <small>An external offer earned through the record above.</small>
            <span aria-hidden="true">04</span>
          </div>
        </div>
      </div>
    </section>

    <section class="closing-field" data-deal aria-labelledby="access-title">
      <div class="shell closing-field-grid">
        <p class="closing-field-kicker">Access // SP+</p>
        <h2 id="access-title">Qualify through five production contracts.</h2>
        <p class="closing-field-terms">
          The partnership is what pays for the work, so you are building the
          opportunity rather than buying a licence to use it.
        </p>
        <div class="closing-actions">
          <a href="/contact" class="action action--signal home-action home-action--signal">
            Start an SP+ fit review <span aria-hidden="true">→</span>
          </a>
          <a href="/the-work#access" class="text-link text-link--light home-text-link home-text-link--light">
            See the access model →
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import '../scripts/motion.js';
</script>
