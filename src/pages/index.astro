---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HeroTicker from '../components/HeroTicker.astro';
---

<Layout title="SecureProspective: an IMO run by a producing agent" description="An independent marketing organization run by an agent who still writes business. Annuity and life wholesale, case design, and suitability for active producers.">
  <Nav />

  <main id="main" transition:name="page-card">
    <!--
      The opening screen. Identity, the SP+ card, and the argument all sit inside
      the ticker field with no scroll: the story a visitor came for is on screen
      when the page opens rather than one viewport below it.
    -->
    <section class="identity-hero">
      <HeroTicker />
      <div class="identity-lockup">
        <p class="identity-kicker">Operator to operator</p>
        <p class="identity-mark" data-stamp>SecureProspective</p>
        <p class="pronunciation">/sɪˈkjʊr//prəˈspek.tɪv/</p>

        <a class="hero-sp-plus" href="/the-work">
          <span>SP+ // ACTIVE BUILD</span>
          <strong>The safer advisor workstation.</strong>
          <small>Access begins with a fit review and five production contracts. No software fee, no recurring SP+ subscription.</small>
          <b>Explore SP+ →</b>
        </a>

        <!--
          The argument, dealt onto the field as a card rather than run as a
          full-bleed band. It answers a pointer the way the rest of the deck
          does, which is what gives this screen its depth.
        -->
        <article class="truth-card" aria-labelledby="identity-title">
          <div class="truth-card-head">
            <span>STATE // OPERATING</span>
            <span>REVENUE ACTIVE</span>
          </div>
          <div class="truth-card-body">
            <h1 id="identity-title">
              Most of what an advisor is sold was never used by the people selling it.
            </h1>

            <div class="truth-columns">
              <p class="truth-lede">
                The pitch has not changed in twenty-five years. More products, more leads,
                more tools, more training, more scale. Bring your license, bring your
                ambition. Then Tuesday morning arrives, you have a case in front of you,
                and there is nobody to ask.
              </p>

              <p class="truth-answer">
                Christopher Campbell still writes business with real clients, and has spent
                eight years inside IMOs and financial advisor offices. SecureProspective is
                the operation he runs: annuity and life-insurance wholesale, producer
                development, case design, suitability, and infrastructure for active agents.
                A broad promise is not an operating model.
              </p>
            </div>

            <a href="/services" class="action action--light">Enter the operation <span>→</span></a>
          </div>
        </article>
      </div>
    </section>

    <section class="method-spine shell" data-deal>
      <div class="spine-copy">
        <h2>One operation. Five movements.</h2>
        <p>
          The method is not a consulting product sitting above the business. It is the discipline
          being applied inside it. Every claim moves through an evidence gate.
        </p>
      </div>
      <ol class="spine-steps">
        <li><span>01</span><strong>Diagnose</strong><small>Find the real constraint.</small></li>
        <li><span>02</span><strong>Position</strong><small>Place the right tool.</small></li>
        <li><span>03</span><strong>Shape</strong><small>Make output ownable.</small></li>
        <li><span>04</span><strong>Transform</strong><small>Change the operation.</small></li>
        <li><span>↺</span><strong>Re-diagnose</strong><small>Secure the next state.</small></li>
      </ol>
      <a href="/the-method" class="text-link">Read the operating method →</a>
    </section>

    <section class="proof-register">
      <div class="shell proof-register-grid">
        <div class="proof-register-title" data-deal>
          <h2>The register claims only what the record holds.</h2>
        </div>
        <div class="proof-lines">
          <a href="/services#operating-record" class="proof-line" data-deal>
            <span class="proof-status proof-status--proven">Proven</span>
            <strong>The IMO operating record</strong>
            <small>Revenue, producers, production, responsibility.</small>
            <span>01</span>
          </a>
          <a href="/the-work" class="proof-line" data-deal style="--deal-delay: 90ms">
            <span class="proof-status proof-status--active">Active</span>
            <strong>SP+ first deliverable</strong>
            <small>The encrypted, immutable, AI-first advisor workstation.</small>
            <span>02</span>
          </a>
          <a href="/the-work#access" class="proof-line" data-deal style="--deal-delay: 180ms">
            <span class="proof-status proof-status--active">Available</span>
            <strong>SP+ partnership access</strong>
            <small>Qualify through five production contracts. No software fee, no subscription.</small>
            <span>03</span>
          </a>
          <div class="proof-line proof-line--future" data-deal style="--deal-delay: 270ms">
            <span class="proof-status">Prospective</span>
            <strong>AI-native transformation</strong>
            <small>An external offer earned through the record above.</small>
            <span>04</span>
          </div>
        </div>
      </div>
    </section>

    <section class="closing-field" data-deal>
      <div class="shell closing-field-grid">
        <p class="closing-field-kicker">Access // SP+</p>
        <h2>Qualify through five production contracts.</h2>
        <p class="closing-field-terms">
          Build the opportunity together. There is no software fee and no subscription on
          top of it.
        </p>
        <div class="closing-actions">
          <a href="/contact" class="action action--signal">Start an SP+ fit review <span>→</span></a>
          <a href="/the-work#access" class="text-link text-link--light">See the access model →</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import '../scripts/motion.js';
</script>
