# Cloudflare Pages response headers.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Turnstile is the only third-party script the site's own markup loads, and its
  # challenge runs in a frame it injects. Cloudflare's own analytics beacon is
  # allowed as well: Pages injects it at the edge when Web Analytics is enabled,
  # so a policy that omitted it would break a script this site never asked for.
  # Everything else is self-hosted, which is what keeps the policy this tight.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Astro fingerprints these filenames, so a stale copy is impossible.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=604800
